{
  "id": "agent-attempt-external-lifecycle",
  "covers": ["C016", "C018", "C019", "C020", "C022", "C023", "C024"],
  "setup": [
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true},
    {"cli": ["task", "create", "Recorded by hand", "--repo", "api", "--ready"], "json": true},
    {"cli": ["task", "create", "Managed attempt", "--repo", "api", "--ready"], "json": true},
    {"cli": ["task", "create", "Abandoned one", "--repo", "api", "--ready"], "json": true},
    {"cli": ["task", "create", "Abandoned two", "--repo", "api", "--ready"], "json": true},
    {"cli": ["task", "create", "Submitted cleanly", "--repo", "api", "--ready"], "json": true},
    {"cli": ["attempt", "create", "WG-1", "--provider", "manual", "--model", "hand-1", "--session-id", "sess-1", "-w", "default"], "json": true, "save": {"recorded": "/id"}},
    {"assert": {"json": {"path": "/provider", "equals": "manual"}}},
    {"assert": {"json": {"path": "/model", "equals": "hand-1"}}},
    {"assert": {"json": {"path": "/session_id", "equals": "sess-1"}}},
    {"cli": ["attempt", "show", "{var:recorded}"], "json": true},
    {"assert": {"json": {"path": "/provider", "equals": "manual"}}},
    {"assert": {"json": {"path": "/status", "equals": "running"}}},
    {"cli": ["attempt", "finish", "{var:recorded}", "failed", "-m", "stopped halfway", "--error", "session lost"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "failed"}}},
    {"assert": {"json": {"path": "/error", "equals": "session lost"}}},
    {"cli": ["attempt", "start", "WG-2", "--agent-name", "alice", "--adapter", "claude_code_subagent", "--model", "hand-2", "--isolation", "worktree"], "json": true, "save": {"managed": "/attempt_id"}},
    {"assert": {"json": {"path": "/task_key", "equals": "WG-2"}}},
    {"cli": ["attempt", "submit", "{var:managed}", "--failed", "-m", "could not finish", "--error", "tests are red"], "json": true},
    {"assert": {"json": {"path": "/attempt_status", "equals": "failed"}}},
    {"assert": {"json": {"path": "/error", "equals": "tests are red"}}},
    {"cli": ["attempt", "start", "WG-3", "--isolation", "in_place"], "json": true, "save": {"abandoned": "/attempt_id"}},
    {"cli": ["attempt", "abandon", "{var:abandoned}", "--reason", "agent stopped without submitting"], "json": true},
    {"assert": {"json": {"path": "/task", "equals": "WG-3"}}},
    {"assert": {"json": {"path": "/task_status", "equals": "ready"}}},
    {"cli": ["attempt", "start", "WG-4"], "json": true, "save": {"second_abandoned": "/attempt_id"}},
    {"cli": ["attempt", "abandon", "{var:second_abandoned}", "-m", "machine rebooted"], "json": true},
    {"assert": {"json": {"path": "/task_status", "equals": "ready"}}},
    {"cli": ["attempt", "list", "--provider", "manual"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"cli": ["attempt", "show", "{var:managed}"], "json": true},
    {"assert": {"json": {"path": "/adapter", "equals": "claude_code_subagent"}}},
    {"assert": {"json": {"path": "/model", "equals": "hand-2"}}},
    {"cli": ["attempt", "start", "WG-4", "--isolation", "bogus"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"cli": ["attempt", "start", "WG-5", "-w", "default"], "json": true, "save": {"clean": "/attempt_id"}},
    {"assert": {"json": {"path": "/task_key", "equals": "WG-5"}}},
    {"cli": ["attempt", "submit", "{var:clean}", "-m", "no changes needed"], "json": true},
    {"assert": {"json": {"path": "/attempt_status", "equals": "succeeded"}}},
    {"assert": {"json": {"path": "/task_status", "equals": "awaiting_review"}}},
    {"assert": {"json": {"path": "/status", "equals": "succeeded"}}}
  ],
  "not_observable": []
}
