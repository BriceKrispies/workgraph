{
  "id": "agent-run-decompose",
  "covers": ["C126"],
  "setup": [
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.summarization.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.summarization.model", "heuristic-v1"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true},
    {"cli": ["task", "create", "Big feature", "--repo", "api", "-d", "- Design the API\n- Then implement the endpoint\n- Then write the docs"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-1"}}},
    {"cli": ["run", "decompose", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/task", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/proposal/children/2/title", "equals": "Then write the docs"}}},
    {"assert": {"json": {"path": "/created", "equals": []}}},
    {"cli": ["run", "decompose", "WG-1", "--no-create"], "json": true},
    {"assert": {"json": {"path": "/created", "equals": []}}},
    {"cli": ["run", "decompose", "WG-1", "--create", "--provider", "heuristic", "--model", "heuristic-v1", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/provider", "equals": "heuristic"}}},
    {"assert": {"json": {"path": "/proposal/children/0/title", "equals": "Design the API"}}},
    {"cli": ["task", "list", "--parent", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/items/2/key", "equals": "WG-2"}}}
  ],
  "not_observable": []
}
