{
  "id": "agent-run-retry-and-rerun",
  "covers": ["C017", "C020", "C127", "C128", "C129", "C131"],
  "setup": [
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.classification.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.classification.model", "heuristic-v1"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["agent", "add-command", "flaky", "workgraph-demo-agent", "--arg=--mode", "--arg=fail", "--arg={manifest}"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true},
    {"cli": ["task", "create", "Flaky work", "--repo", "api", "--ready"], "json": true},
    {"cli": ["run", "start", "WG-1", "--agent", "flaky", "--no-wait"], "json": true, "save": {"first": "/id"}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["run", "get", "{var:first}"], "json": true},
    {"assert": {"json": {"path": "/attempt/status", "equals": "failed"}}},
    {"assert": {"json": {"path": "/attempt/error", "equals": "simulated failure"}}},
    {"cli": ["run", "rerun", "{var:first}"], "json": true, "save": {"third": "/attempt/id"}},
    {"assert": {"json": {"path": "/attempt/rerun_of_attempt_id", "equals": "{var:first}"}}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["run", "get", "{var:third}"], "json": true},
    {"assert": {"json": {"path": "/attempt/status", "equals": "failed"}}},
    {"cli": ["attempt", "compare", "{var:first}", "{var:third}"], "json": true},
    {"cli": ["agent", "add-command", "flaky", "workgraph-demo-agent", "--arg=--mode", "--arg=success", "--arg={manifest}"], "json": true},
    {"cli": ["run", "retry", "{var:first}", "--instructions", "Fix the failing check"], "json": true, "save": {"second": "/id"}},
    {"assert": {"json": {"path": "/retry_of_attempt_id", "equals": "{var:first}"}}},
    {"assert": {"json": {"path": "/status", "equals": "queued"}}},
    {"drain": {"max_jobs": 20}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["run", "get", "{var:second}"], "json": true},
    {"assert": {"json": {"path": "/attempt/status", "equals": "succeeded"}}},
    {"assert": {"json": {"path": "/attempt/retry_of_attempt_id", "equals": "{var:first}"}}},
    {"cli": ["attempt", "list", "--task", "WG-1", "--provider", "flaky", "--limit", "10"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 3}}}
  ],
  "not_observable": []
}
