{
  "id": "agent-run-schedule",
  "covers": ["C130", "C131", "C127"],
  "setup": [
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.classification.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.classification.model", "heuristic-v1"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["config", "set", "execution.default_agent", "scripted"], "json": true},
    {"cli": ["agent", "add-command", "scripted", "workgraph-demo-agent", "--arg=--mode", "--arg=success", "--arg={manifest}", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true},
    {"cli": ["task", "create", "Scheduled work", "--repo", "api", "--ready", "--auto-execute"], "json": true},
    {"cli": ["task", "create", "Manual only", "--repo", "api", "--ready"], "json": true},
    {"cli": ["task", "create", "Waits for the first", "--repo", "api", "--depends-on", "WG-1", "--auto-execute"], "json": true},
    {"cli": ["run", "schedule", "--dry-run"], "json": true},
    {"assert": {"json": {"path": "/0/key", "equals": "WG-1"}}},
    {"cli": ["run", "schedule", "--explain", "WG-2"], "json": true},
    {"cli": ["run", "schedule", "--explain", "WG-3"], "json": true},
    {"cli": ["run", "schedule", "--no-dry-run"], "json": true},
    {"drain": {"max_jobs": 20}},
    {"cli": ["attempt", "list", "--task", "WG-1", "--status", "succeeded"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"cli": ["attempt", "list", "--task", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 0}}}
  ],
  "not_observable": []
}
