{
  "id": "agent-run-start-get-watch",
  "covers": ["C020", "C021", "C022", "C127", "C131", "C132"],
  "setup": [
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.classification.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.classification.model", "heuristic-v1"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["config", "set", "execution.default_agent", "scripted"], "json": true},
    {"cli": ["agent", "add-command", "scripted", "workgraph-demo-agent", "--arg=--mode", "--arg=success", "--arg={manifest}", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true},
    {"cli": ["task", "create", "Implement login", "--repo", "api", "--ready"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-1"}}},
    {"cli": ["run", "start", "WG-1", "--agent", "scripted", "--model", "fast-1", "--instructions", "Keep the change small", "--no-wait", "-w", "default"], "json": true, "save": {"attempt": "/id"}},
    {"assert": {"json": {"path": "/status", "equals": "queued"}}},
    {"assert": {"json": {"path": "/provider", "equals": "scripted"}}},
    {"assert": {"json": {"path": "/model", "equals": "fast-1"}}},
    {"assert": {"json": {"path": "/config_snapshot/instructions", "equals": "Keep the change small"}}},
    {"cli": ["run", "get", "{var:attempt}"], "json": true},
    {"assert": {"json": {"path": "/attempt/status", "equals": "queued"}}},
    {"cli": ["attempt", "list", "--task", "WG-1", "--status", "queued", "--provider", "scripted", "--limit", "5", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["run", "get", "{var:attempt}"], "json": true},
    {"assert": {"json": {"path": "/attempt/status", "equals": "succeeded"}}},
    {"assert": {"json": {"path": "/attempt/summary", "equals": "changed api:agent_change.py"}}},
    {"cli": ["run", "watch", "{var:attempt}"], "json": true},
    {"assert": {"json": {"path": "/attempt/status", "equals": "succeeded"}}},
    {"cli": ["attempt", "show", "{var:attempt}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "succeeded"}}},
    {"assert": {"json": {"path": "/model", "equals": "fast-1"}}},
    {"assert": {"json": {"path": "/usage/input_tokens", "equals": 1200}}},
    {"assert": {"json": {"path": "/usage/output_tokens", "equals": 340}}},
    {"assert": {"json": {"path": "/usage_source", "equals": "command_reported"}}},
    {"assert": {"json": {"path": "/cost_usd", "equals": null}}},
    {"cli": ["attempt", "manifests", "{var:attempt}"], "json": true},
    {"cli": ["attempt", "list", "--task", "WG-1", "--status", "succeeded", "--provider", "scripted", "--limit", "5"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"cli": ["run", "get", "00000000-0000-0000-0000-000000000000"], "json": true, "expect_exit": 4},
    {"assert": {"exit": 4}},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_runs.py::test_cancel_running_attempt: cancelling an attempt while its agent process is running needs a worker running concurrently with the CLI; the conformance runner executes steps one after another, so only queued cancellation is observable (agent-run-cancel-queued)",
      "covered_by": "CORE-12"
    },
    {
      "case": "run start --wait: the command blocks until a concurrently running worker finishes the attempt, and it waits up to 7200 seconds; a step runner without a background worker would block, so the option is not exercised by a scenario",
      "covered_by": "CORE-12"
    }
  ]
}
