{
  "id": "agent-verify-configs-and-runs",
  "covers": ["C131", "C172", "C173", "C174", "C175", "C176"],
  "setup": [
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.classification.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.classification.model", "heuristic-v1"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["agent", "add-command", "scripted", "workgraph-demo-agent", "--arg=--mode", "--arg=success", "--arg={manifest}"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true},
    {"cli": ["task", "create", "Verified work", "--repo", "api", "--ready"], "json": true},
    {"cli": ["task", "create", "Strict work", "--repo", "api", "--ready"], "json": true},
    {"cli": ["verify", "config", "ci", "--scope-type", "repository", "--scope", "api", "--check", "{\"name\":\"lint\",\"kind\":\"lint\",\"tier\":\"fast\",\"command\":[\"git\",\"rev-parse\",\"--is-inside-work-tree\"]}", "--check", "{\"name\":\"tests\",\"kind\":\"test\",\"tier\":\"full\",\"command\":[\"git\",\"rev-parse\",\"--is-inside-work-tree\"]}", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/name", "equals": "ci"}}},
    {"assert": {"json": {"path": "/checks/0/name", "equals": "lint"}}},
    {"cli": ["verify", "config", "strict", "--scope-type", "task", "--scope", "WG-2", "--check", "{\"name\":\"broken\",\"command\":[\"git\",\"rev-parse\",\"--verify\",\"no-such-ref\"]}"], "json": true},
    {"assert": {"json": {"path": "/scope_type", "equals": "task"}}},
    {"cli": ["verify", "configs", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/1/name", "equals": "strict"}}},
    {"cli": ["run", "start", "WG-1", "--agent", "scripted", "--no-wait"], "json": true, "save": {"attempt": "/id"}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["verify", "run", "WG-1", "--tier", "fast"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "passed"}}},
    {"assert": {"json": {"path": "/required_passed", "equals": true}}},
    {"cli": ["verify", "run", "WG-1", "--attempt", "{var:attempt}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "passed"}}},
    {"cli": ["verify", "run", "WG-2", "--tier", "fast", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "passed"}}},
    {"cli": ["verify", "run", "WG-2"], "json": true, "expect_exit": 3},
    {"assert": {"exit": 3}},
    {"assert": {"json": {"path": "/status", "equals": "failed"}}},
    {"assert": {"json": {"path": "/required_passed", "equals": false}}},
    {"cli": ["verify", "run", "WG-1", "--tier", "urgent"], "json": true, "expect_exit": 2},
    {"cli": ["verify", "runs", "--task", "WG-2", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "failed"}}},
    {"cli": ["verify", "runs", "--task", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "passed"}}},
    {"cli": ["verify", "failures", "--check", "broken", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/0/check", "equals": "broken"}}},
    {"assert": {"json": {"path": "/0/task_key", "equals": "WG-2"}}}
  ],
  "not_observable": []
}
