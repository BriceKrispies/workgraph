{
  "id": "analytics-code-metrics-coupling-and-estimate",
  "covers": ["C005", "C006", "C009", "C012", "C091", "C094", "C095", "C115", "C118", "C145", "C148", "C150", "C152"],
  "setup": [
    {"git": "init", "repo": "auth-service"},
    {"git": "commit", "repo": "auth-service", "files": {"README.md": "# auth-service\n"}, "message": "initial commit"},
    {"git": "init", "repo": "shared-sdk"},
    {"git": "commit", "repo": "shared-sdk", "files": {"README.md": "# shared-sdk\n"}, "message": "initial commit"},
    {"git": "init", "repo": "web-client"},
    {"git": "commit", "repo": "web-client", "files": {"README.md": "# web-client\n"}, "message": "initial commit"},
    {"git": "commit", "repo": "auth-service", "files": {"src/mod0.py": "x = 1\n"}, "message": "work 0\n\nTask-ID: WG-1"},
    {"git": "commit", "repo": "shared-sdk", "files": {"src/mod0.py": "x = 1\n"}, "message": "work 0\n\nTask-ID: WG-1"},
    {"git": "commit", "repo": "auth-service", "files": {"src/mod1.py": "x = 1\nx = 1\n"}, "message": "work 1\n\nTask-ID: WG-2"},
    {"git": "commit", "repo": "shared-sdk", "files": {"src/mod1.py": "x = 1\nx = 1\n"}, "message": "work 1\n\nTask-ID: WG-2"},
    {"git": "commit", "repo": "auth-service", "files": {"src/mod2.py": "x = 1\nx = 1\nx = 1\n"}, "message": "work 2\n\nTask-ID: WG-3"},
    {"git": "commit", "repo": "shared-sdk", "files": {"src/mod2.py": "x = 1\nx = 1\nx = 1\n"}, "message": "work 2\n\nTask-ID: WG-3"},
    {"git": "commit", "repo": "auth-service", "files": {"src/mod3.py": "x = 1\nx = 1\nx = 1\nx = 1\n"}, "message": "work 3\n\nTask-ID: WG-4"},
    {"git": "commit", "repo": "shared-sdk", "files": {"src/mod3.py": "x = 1\nx = 1\nx = 1\nx = 1\n"}, "message": "work 3\n\nTask-ID: WG-4"},
    {"git": "commit", "repo": "auth-service", "files": {"src/shared.py": "a\nb\nc\n"}, "message": "shared fix"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:auth-service}"], "json": true},
    {"cli": ["repo", "register", "{repo:shared-sdk}"], "json": true},
    {"cli": ["repo", "register", "{repo:web-client}"], "json": true},
    {"cli": ["task", "create", "Token refresh part 0", "--ready", "--repo", "auth-service", "--repo", "shared-sdk"], "json": true},
    {"cli": ["task", "create", "Token refresh part 1", "--ready", "--repo", "auth-service", "--repo", "shared-sdk"], "json": true},
    {"cli": ["task", "create", "Token refresh part 2", "--ready", "--repo", "auth-service", "--repo", "shared-sdk"], "json": true},
    {"cli": ["task", "create", "Token refresh part 3", "--ready", "--repo", "auth-service", "--repo", "shared-sdk"], "json": true},
    {"cli": ["git", "sync", "auth-service"], "json": true},
    {"cli": ["git", "sync", "shared-sdk"], "json": true},
    {"cli": ["git", "log", "auth-service"], "json": true, "save": {"shared_sha": "/items/0/sha"}},
    {"assert": {"json": {"path": "/items/0/subject", "equals": "shared fix"}}},
    {"cli": ["git", "link", "WG-1", "{var:shared_sha}", "--repository", "auth-service"], "json": true},
    {"cli": ["git", "link", "WG-2", "{var:shared_sha}", "--repository", "auth-service"], "json": true},
    {"cli": ["task", "claim", "WG-1"], "json": true},
    {"cli": ["task", "complete", "WG-1", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-1", "--manual", "--reason", "ok"], "json": true},
    {"cli": ["git", "surface", "WG-1"], "json": true},
    {"cli": ["task", "claim", "WG-2"], "json": true},
    {"cli": ["task", "complete", "WG-2", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-2", "--manual", "--reason", "ok"], "json": true},
    {"cli": ["git", "surface", "WG-2"], "json": true},
    {"cli": ["task", "claim", "WG-3"], "json": true},
    {"cli": ["task", "complete", "WG-3", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-3", "--manual", "--reason", "ok"], "json": true},
    {"cli": ["git", "surface", "WG-3"], "json": true},
    {"cli": ["task", "claim", "WG-4"], "json": true},
    {"cli": ["task", "complete", "WG-4", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-4", "--manual", "--reason", "ok"], "json": true},
    {"cli": ["git", "surface", "WG-4"], "json": true},
    {"cli": ["analytics", "query", "repository_change_volume", "--by", "repository", "--repo", "auth-service"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 13}}},
    {"assert": {"json": {"path": "/rows/0/n", "equals": 5}}},
    {"cli": ["analytics", "query", "cumulative_churn"], "json": true},
    {"assert": {"json": {"path": "/rows/0/n", "equals": 4}}},
    {"cli": ["analytics", "query", "tasks_created", "--by", "repository"], "json": true},
    {"assert": {"stdout_contains": "\"repository_label\": \"auth-service\""}},
    {"assert": {"stdout_contains": "\"repository_label\": \"shared-sdk\""}},
    {"cli": ["analytics", "query", "tasks_created", "--repo", "auth-service"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 4}}},
    {"cli": ["analytics", "query", "tasks_created", "--repo", "shared-sdk"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 4}}},
    {"cli": ["analytics", "query", "tasks_created", "--repo", "web-client"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 0}}},
    {"cli": ["analytics", "coupling"], "json": true},
    {"assert": {"json": {"path": "/summary/cross_repository_tasks", "equals": 4}}},
    {"assert": {"json": {"path": "/edges/0/co_changes", "equals": 4}}},
    {"assert": {"json": {"path": "/edges/0/relationship", "equals": "observed"}}},
    {"assert": {"json": {"path": "/coupling_candidates/0/co_changes", "equals": 4}}},
    {"cli": ["repo", "depend", "auth-service", "shared-sdk"], "json": true},
    {"cli": ["analytics", "coupling"], "json": true},
    {"assert": {"json": {"path": "/edges/0/relationship", "equals": "declared+observed"}}},
    {"cli": ["task", "create", "Token refresh part 9", "--repo", "auth-service"], "json": true},
    {"cli": ["analytics", "estimate", "WG-5"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ok"}}},
    {"assert": {"json": {"path": "/sample_size", "equals": 4}}},
    {"assert": {"json": {"path": "/distributions/final_change_size/n", "equals": 4}}},
    {"assert": {"json": {"path": "/basis/0/reasons/1", "equals": "repository overlap 0.50"}}},
    {"assert": {"json": {"path": "/basis/1/reasons/1", "equals": "repository overlap 0.50"}}},
    {"assert": {"json": {"path": "/basis/2/reasons/1", "equals": "repository overlap 0.50"}}},
    {"assert": {"json": {"path": "/basis/3/reasons/1", "equals": "repository overlap 0.50"}}},
    {"cli": ["analytics", "estimate", "--title", "Completely unrelated quantum widget"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "insufficient_data"}}},
    {"cli": ["analytics", "history", "--repo", "shared-sdk"], "json": true},
    {"assert": {"json": {"path": "/0/key", "equals": "WG-4"}}},
    {"assert": {"json": {"path": "/3/key", "equals": "WG-1"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_analytics.py::test_code_metrics_shared_commits_coupling_and_estimation: the edge's two repository names are compared as a set, because the coupling output orders the two ends of an edge by a repository id that is random per run; the scenario checks the edge's counts and relationship, and the set of names is left to the golden-vector coupling computation",
      "covered_by": "GV-15"
    }
  ]
}
