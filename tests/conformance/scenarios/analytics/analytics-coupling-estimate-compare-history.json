{
  "id": "analytics-coupling-estimate-compare-history",
  "covers": ["C004", "C005", "C006", "C009"],
  "setup": [
    {"git": "init", "repo": "auth-service"},
    {"git": "init", "repo": "shared-sdk"},
    {"git": "commit", "repo": "auth-service", "files": {"src/mod0.py": "x = 1\n"}, "message": "work 0\n\nTask-ID: WG-1"},
    {"git": "commit", "repo": "shared-sdk", "files": {"src/mod0.py": "y = 2\n"}, "message": "work 0\n\nTask-ID: WG-1"},
    {"git": "commit", "repo": "auth-service", "files": {"src/mod1.py": "x = 1\nx = 1\n"}, "message": "work 1\n\nTask-ID: WG-2"},
    {"git": "commit", "repo": "shared-sdk", "files": {"src/mod1.py": "y = 2\nx = 1\n"}, "message": "work 1\n\nTask-ID: WG-2"},
    {"git": "commit", "repo": "auth-service", "files": {"src/mod2.py": "x = 1\nx = 1\nx = 1\n"}, "message": "work 2\n\nTask-ID: WG-3"},
    {"git": "commit", "repo": "shared-sdk", "files": {"src/mod2.py": "y = 2\nx = 1\nx = 1\n"}, "message": "work 2\n\nTask-ID: WG-3"},
    {"git": "commit", "repo": "auth-service", "files": {"src/mod3.py": "x = 1\nx = 1\nx = 1\nx = 1\n"}, "message": "work 3\n\nTask-ID: WG-4"},
    {"git": "commit", "repo": "shared-sdk", "files": {"src/mod3.py": "y = 2\nx = 1\nx = 1\nx = 1\n"}, "message": "work 3\n\nTask-ID: WG-4"},
    {"git": "commit", "repo": "auth-service", "files": {"src/shared.py": "a\nb\nc\n"}, "message": "shared fix"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["repo", "register", "{repo:auth-service}"], "json": true},
    {"cli": ["repo", "register", "{repo:shared-sdk}"], "json": true},
    {"cli": ["project", "create", "platform", "--name", "Platform", "--repo", "auth-service"], "json": true},
    {"cli": ["task", "create", "Token refresh part 0", "--ready", "-r", "auth-service", "-r", "shared-sdk"], "json": true},
    {"cli": ["task", "create", "Token refresh part 1", "--ready", "-r", "auth-service", "-r", "shared-sdk"], "json": true},
    {"cli": ["task", "create", "Token refresh part 2", "--ready", "-r", "auth-service", "-r", "shared-sdk"], "json": true},
    {"cli": ["task", "create", "Token refresh part 3", "--ready", "-r", "auth-service", "-r", "shared-sdk"], "json": true},
    {"cli": ["task", "create", "Token refresh part 9", "--ready", "-r", "auth-service"], "json": true},
    {"cli": ["git", "sync", "auth-service"], "json": true},
    {"cli": ["git", "sync", "shared-sdk"], "json": true},
    {"cli": ["git", "log", "auth-service"], "json": true, "save": {"shared": "/items/0/sha"}},
    {"cli": ["git", "link", "WG-1", "{var:shared}", "--repository", "auth-service"], "json": true},
    {"cli": ["git", "link", "WG-2", "{var:shared}", "--repository", "auth-service"], "json": true},
    {"cli": ["analytics", "compare", "tasks_created", "2000-01-01T00:00:00", "2100-01-01T00:00:00", "2000-01-01T00:00:00", "2000-01-02T00:00:00"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["analytics", "compare", "tasks_created", "2000-01-01T00:00:00", "2100-01-01T00:00:00", "2000-01-01T00:00:00", "2000-01-02T00:00:00", "--by", "repository"], "json": true},
    {"cli": ["task", "claim", "WG-1", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-1", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-1", "--manual", "-m", "ok"], "json": true},
    {"cli": ["task", "claim", "WG-2", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-2", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-2", "--manual", "-m", "ok"], "json": true},
    {"cli": ["task", "claim", "WG-3", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-3", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-3", "--manual", "-m", "ok"], "json": true},
    {"cli": ["task", "claim", "WG-4", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-4", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-4", "--manual", "-m", "ok"], "json": true},
    {"cli": ["analytics", "query", "repository_change_volume", "--by", "repository"], "json": true},
    {"cli": ["analytics", "query", "cumulative_churn"], "json": true},
    {"cli": ["analytics", "query", "tasks_created", "--by", "repository"], "json": true},
    {"cli": ["analytics", "coupling"], "json": true},
    {"assert": {"json": {"path": "/edges/0/co_changes", "equals": 4}}},
    {"assert": {"json": {"path": "/edges/0/relationship", "equals": "observed"}}},
    {"assert": {"json": {"path": "/summary/cross_repository_tasks", "equals": 4}}},
    {"cli": ["analytics", "coupling", "--project", "platform", "--min-support", "2"], "json": true},
    {"cli": ["analytics", "coupling", "--min-support", "9"], "json": true},
    {"assert": {"json": {"path": "/edges", "equals": []}}},
    {"cli": ["repo", "depend", "auth-service", "shared-sdk"], "json": true},
    {"cli": ["analytics", "coupling"], "json": true},
    {"assert": {"json": {"path": "/edges/0/relationship", "equals": "declared+observed"}}},
    {"cli": ["analytics", "estimate", "WG-5"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ok"}}},
    {"cli": ["analytics", "estimate", "--title", "Token refresh rework", "--repo", "auth-service", "--category", "bug_fix"], "json": true},
    {"cli": ["analytics", "estimate", "--title", "Completely unrelated quantum widget"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "insufficient_data"}}},
    {"cli": ["analytics", "history", "--repo", "shared-sdk"], "json": true},
    {"assert": {"json": {"path": "/0/key", "equals": "WG-4"}}},
    {"cli": ["analytics", "history", "--category", "bug_fix", "--limit", "2"], "json": true},
    {"cli": ["analytics", "history", "--limit", "2"], "json": true},
    {"cli": ["analytics", "history", "--repo", "unknown-repo"], "json": true},
    {"cli": ["analytics", "history", "-w", "default", "--limit", "1"], "json": true},
    {"cli": ["analytics", "coupling", "-w", "default", "--project", "platform"], "json": true},
    {"cli": ["analytics", "estimate", "WG-5", "-w", "default"], "json": true},
    {"cli": ["analytics", "compare", "tasks_created", "2000-01-01T00:00:00", "2100-01-01T00:00:00", "2000-01-01T00:00:00", "2000-01-02T00:00:00", "--by", "repository", "-w", "default"], "json": true}
  ],
  "not_observable": []
}
