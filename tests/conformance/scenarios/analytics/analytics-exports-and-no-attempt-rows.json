{
  "id": "analytics-exports-and-no-attempt-rows",
  "covers": ["C007", "C012", "C020", "C152"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "exported"], "json": true},
    {"cli": ["analytics", "export", "{tmp}/facts.csv", "--format", "csv", "--dataset", "task_facts"], "json": true},
    {"assert": {"file": "{tmp}/facts.csv", "exists": true}},
    {"cli": ["analytics", "export", "{tmp}/facts.json", "--format", "json", "--dataset", "task_facts"], "json": true},
    {"assert": {"file": "{tmp}/facts.json", "exists": true}},
    {"cli": ["analytics", "export", "{tmp}/facts.parquet", "--format", "parquet", "--dataset", "task_facts"], "json": true},
    {"assert": {"file": "{tmp}/facts.parquet", "exists": true}},
    {"cli": ["analytics", "export", "{tmp}/q.csv", "--format", "csv", "--metric", "tasks_created", "--by", "status"], "json": true},
    {"assert": {"file": "{tmp}/q.csv", "contains": "backlog"}},
    {"cli": ["attempt", "list"], "json": true},
    {"assert": {"json": {"path": "/items", "equals": []}}}
  ],
  "not_observable": []
}
