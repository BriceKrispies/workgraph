{
  "id": "analytics-failures-retrospective-export",
  "covers": ["C007", "C008", "C013"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"README.md": "svc\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["project", "create", "platform", "--name", "Platform", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "Flaky login", "--ready", "-r", "svc", "-p", "platform"], "json": true},
    {"cli": ["task", "create", "Done thing", "--ready"], "json": true},
    {"cli": ["task", "claim", "WG-2", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-2", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-2", "--manual", "-m", "ok"], "json": true},
    {"cli": ["attempt", "create", "WG-1", "--provider", "external"], "json": true},
    {"cli": ["attempt", "create", "WG-1", "--provider", "external"], "json": true},
    {"cli": ["attempt", "create", "WG-1", "--provider", "external"], "json": true},
    {"cli": ["analytics", "failures"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["analytics", "failures", "--no-persist"], "json": true},
    {"cli": ["analytics", "failures", "--persist"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["config", "set", "llm.summarization.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.summarization.model", "heuristic-v1"], "json": true},
    {"cli": ["analytics", "retrospective", "--days", "7", "--no-model"], "json": true},
    {"assert": {"json": {"path": "/narrative_source", "equals": "deterministic"}}},
    {"assert": {"json": {"path": "/facts/tasks/created", "equals": 2}}},
    {"cli": ["analytics", "retrospective", "--days", "7", "--project", "platform", "--repo", "svc", "--no-model"], "json": true, "expect_exit": 2},
    {"cli": ["analytics", "retrospective", "--days", "1", "--output", "{home}/retro.md", "--no-model"], "json": true},
    {"assert": {"file": "retro.md", "exists": true}},
    {"cli": ["analytics", "retrospective", "-o", "{home}/retro-model.md"], "json": true},
    {"assert": {"json": {"path": "/narrative_source", "equals": "model:heuristic/heuristic-v1"}}},
    {"assert": {"file": "retro-model.md", "exists": true}},
    {"assert": {"file": "retro-model.md", "contains": "model-generated interpretation"}},
    {"cli": ["analytics", "export", "{home}/facts.csv", "--format", "csv", "--dataset", "task_facts"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["analytics", "export", "{home}/facts.json", "--format", "json", "--dataset", "task_facts"], "json": true},
    {"cli": ["analytics", "export", "{home}/facts.parquet", "--format", "parquet", "--dataset", "task_facts"], "json": true},
    {"cli": ["analytics", "export", "{home}/tasks.csv", "--format", "csv", "--metric", "tasks_created", "--by", "status"], "json": true},
    {"assert": {"file": "tasks.csv", "contains": "ready"}},
    {"cli": ["analytics", "export", "{home}/bad.txt", "--format", "xml"], "json": true, "expect_exit": 2},
    {"cli": ["task", "create", "Fix login regression"], "json": true},
    {"cli": ["task", "relate", "WG-3", "WG-2", "--type", "regression_of"], "json": true},
    {"cli": ["analytics", "query", "regressions"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 1}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_analytics.py::test_failures_and_retrospective_fallback: the frequently_failing_test finding needs failing verification checks with test failure signatures recorded from real check runs, and the run-path fixture is a fake agent that the scenario runner does not start, so only the retry_loop finding is reproduced here",
      "covered_by": "SC-15"
    }
  ]
}
