{
  "id": "analytics-query-metrics-and-filters",
  "covers": ["C010", "C011", "C012"],
  "setup": [
    {"git": "init", "repo": "auth"},
    {"git": "commit", "repo": "auth", "files": {"README.md": "auth\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["config", "set", "llm.classification.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.classification.model", "heuristic-v1"], "json": true},
    {"cli": ["repo", "register", "{repo:auth}"], "json": true},
    {"cli": ["project", "create", "platform", "--name", "Platform"], "json": true},
    {"cli": ["task", "create", "Fix crash in login", "--ready", "-r", "auth", "-p", "platform"], "json": true},
    {"cli": ["task", "create", "Refactor payment module", "--ready"], "json": true},
    {"cli": ["task", "create", "Add dark mode feature", "--ready"], "json": true},
    {"cli": ["task", "create", "Write docs", "--ready"], "json": true},
    {"cli": ["task", "create", "Never started", "--ready"], "json": true},
    {"cli": ["task", "claim", "WG-1", "--agent", "alice"], "json": true},
    {"cli": ["attempt", "create", "WG-1", "--provider", "alpha", "--model", "m1"], "json": true, "save": {"attempt1": "/id"}},
    {"cli": ["task", "complete", "WG-1", "--summary", "fixed", "--attempt", "{var:attempt1}"], "json": true},
    {"cli": ["classify", "confirm", "WG-1", "bug_fix", "--note", "crash"], "json": true},
    {"cli": ["task", "accept", "WG-1", "--manual", "-m", "reviewed by hand"], "json": true},
    {"cli": ["task", "claim", "WG-2", "--agent", "bob"], "json": true},
    {"cli": ["attempt", "create", "WG-2", "--provider", "beta", "--model", "m2"], "json": true, "save": {"attempt2": "/id"}},
    {"cli": ["task", "result", "WG-2", "failed", "-m", "tests red", "--attempt", "{var:attempt2}"], "json": true},
    {"cli": ["task", "claim", "WG-2", "--agent", "bob"], "json": true},
    {"cli": ["attempt", "create", "WG-2", "--provider", "beta", "--model", "m2"], "json": true, "save": {"attempt3": "/id"}},
    {"cli": ["task", "complete", "WG-2", "--summary", "second try", "--attempt", "{var:attempt3}"], "json": true},
    {"cli": ["analytics", "metrics"], "json": true},
    {"assert": {"json": {"path": "/0/id", "equals": "tasks_created"}}},
    {"cli": ["analytics", "overview"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["analytics", "overview", "--period", "month"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["analytics", "query", "tasks_created"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 5}}},
    {"cli": ["analytics", "query", "tasks_created", "--by", "status"], "json": true},
    {"cli": ["analytics", "query", "tasks_accepted", "--period", "month"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 1}}},
    {"cli": ["analytics", "query", "attempt_outcomes", "--by", "provider", "--by", "model"], "json": true},
    {"cli": ["analytics", "query", "agent_completion_rate", "--by", "provider"], "json": true},
    {"cli": ["analytics", "query", "first_pass_success"], "json": true},
    {"cli": ["analytics", "query", "tasks_created", "--project", "platform"], "json": true},
    {"cli": ["analytics", "query", "tasks_created", "--repo", "auth"], "json": true},
    {"cli": ["analytics", "query", "tasks_created", "--category", "bug_fix"], "json": true},
    {"cli": ["analytics", "query", "attempt_outcomes", "--provider", "alpha", "--model", "m1"], "json": true},
    {"cli": ["analytics", "query", "tasks_created", "--since", "2000-01-01T00:00:00", "--until", "2100-01-01T00:00:00"], "json": true},
    {"cli": ["analytics", "query", "tasks_created", "--since", "2000-01-01T00:00:00", "--until", "2000-01-02T00:00:00"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 0}}},
    {"cli": ["analytics", "query", "tasks_created", "-p", "platform", "-r", "auth", "-w", "default"], "json": true},
    {"cli": ["analytics", "query", "tasks_created", "--workspace", "default", "--period", "day"], "json": true},
    {"cli": ["analytics", "query", "tasks_created", "--by", "model"], "json": true, "expect_exit": 2},
    {"cli": ["analytics", "query", "no_such_metric"], "json": true, "expect_exit": 2}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_analytics.py::test_invalid_grouping_rejected: the AnalyticsQuery(metric='DROP TABLE tasks') ValueError is raised by the Python query model before any interface runs; the CLI refusals for an unknown metric and a disallowed grouping are asserted by this scenario",
      "covered_by": "GV-15"
    },
    {
      "case": "tests/integration/test_analytics.py::test_throughput_execution_and_agent_metrics: the attempts are seeded with fixed durations and queue waits through the database, so the duration statistics (median, p90, min, max) are checked only for their structure here; the exact values are covered by the GV-15 vectors",
      "covered_by": "GV-15"
    },
    {
      "case": "tests/integration/test_analytics.py::test_exports: the test checks that the export left no AgentAttempt rows, which is a database assertion; db assertions are not run until the database driver lands",
      "covered_by": "CR-06"
    }
  ]
}
