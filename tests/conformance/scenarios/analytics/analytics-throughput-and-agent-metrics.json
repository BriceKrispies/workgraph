{
  "id": "analytics-throughput-and-agent-metrics",
  "covers": ["C012", "C018", "C019", "C145", "C148", "C150", "C152"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Task 0", "--ready"], "json": true},
    {"cli": ["task", "create", "Task 1", "--ready"], "json": true},
    {"cli": ["task", "create", "Task 2", "--ready"], "json": true},
    {"cli": ["task", "create", "Task 3", "--ready"], "json": true},
    {"cli": ["task", "create", "Task 4", "--ready"], "json": true},
    {"cli": ["attempt", "create", "WG-1", "--provider", "alpha", "--model", "m1"], "json": true, "save": {"att": "/id"}},
    {"cli": ["attempt", "finish", "{var:att}", "succeeded"], "json": true},
    {"cli": ["attempt", "create", "WG-2", "--provider", "alpha", "--model", "m1"], "json": true, "save": {"att": "/id"}},
    {"cli": ["attempt", "finish", "{var:att}", "succeeded"], "json": true},
    {"cli": ["attempt", "create", "WG-3", "--provider", "alpha", "--model", "m1"], "json": true, "save": {"att": "/id"}},
    {"cli": ["attempt", "finish", "{var:att}", "succeeded"], "json": true},
    {"cli": ["attempt", "create", "WG-4", "--provider", "beta", "--model", "m1"], "json": true, "save": {"att": "/id"}},
    {"cli": ["attempt", "finish", "{var:att}", "succeeded"], "json": true},
    {"cli": ["attempt", "create", "WG-5", "--provider", "beta", "--model", "m1"], "json": true, "save": {"att": "/id"}},
    {"cli": ["attempt", "finish", "{var:att}", "succeeded"], "json": true},
    {"cli": ["attempt", "create", "WG-1", "--provider", "alpha", "--model", "m1"], "json": true, "save": {"att": "/id"}},
    {"cli": ["attempt", "finish", "{var:att}", "failed"], "json": true},
    {"cli": ["task", "claim", "WG-1"], "json": true},
    {"cli": ["task", "complete", "WG-1", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-1", "--manual", "--reason", "ok"], "json": true},
    {"cli": ["task", "claim", "WG-2"], "json": true},
    {"cli": ["task", "complete", "WG-2", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-2", "--manual", "--reason", "ok"], "json": true},
    {"cli": ["task", "claim", "WG-3"], "json": true},
    {"cli": ["task", "complete", "WG-3", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-3", "--manual", "--reason", "ok"], "json": true},
    {"cli": ["analytics", "query", "tasks_created"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 5}}},
    {"cli": ["analytics", "query", "tasks_accepted"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 3}}},
    {"cli": ["analytics", "query", "agent_completion_rate", "--by", "provider", "--by", "model"], "json": true},
    {"assert": {"json": {"path": "/rows/0/provider", "equals": "alpha"}}},
    {"assert": {"json": {"path": "/rows/0/numerator", "equals": 3}}},
    {"assert": {"json": {"path": "/rows/0/denominator", "equals": 4}}},
    {"assert": {"json": {"path": "/rows/1/provider", "equals": "beta"}}},
    {"assert": {"json": {"path": "/rows/1/value", "equals": 1.0}}},
    {"cli": ["analytics", "query", "first_pass_success"], "json": true},
    {"assert": {"json": {"path": "/rows/0/denominator", "equals": 3}}},
    {"assert": {"json": {"path": "/rows/0/numerator", "equals": 2}}},
    {"cli": ["analytics", "query", "tasks_created", "--by", "period"], "json": true},
    {"assert": {"json": {"path": "/rows/0/value", "equals": 5}}},
    {"cli": ["analytics", "query", "cost"], "json": true},
    {"assert": {"json": {"path": "/rows/0/n", "equals": 0}}},
    {"assert": {"stdout_contains": "SELECT"}},
    {"assert": {"stdout_contains": "\"definition\""}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_analytics.py::test_throughput_execution_and_agent_metrics: the execution_duration distribution (n, median, p90, min, max, checked against percentile() over the test's own duration_ms values) and the queue wait behind the queue_wait_ms metrics; the attempt commands cannot set duration_ms or queue_wait_ms, and wall-clock durations would differ between runs",
      "covered_by": "GV-15"
    }
  ]
}
