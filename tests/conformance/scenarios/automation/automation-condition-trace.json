{
  "id": "automation-condition-trace",
  "covers": ["C031"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "App crash on start", "--priority", "high"], "json": true},
    {"cli": ["task", "create", "x", "--priority", "low"], "json": true},
    {"cli": ["automation", "preview", "--spec", "{\"name\":\"trace\",\"trigger\":{\"type\":\"manual\"},\"conditions\":{\"all\":[{\"field\":\"task.priority\",\"op\":\"in\",\"value\":[\"high\",\"critical\"]},{\"not\":{\"field\":\"task.tags\",\"op\":\"contains\",\"value\":\"skip\"}},{\"any\":[{\"field\":\"task.title\",\"op\":\"matches\",\"value\":\"(?i)crash\"},{\"field\":\"classification.category\",\"op\":\"eq\",\"value\":\"bug_fix\"}]}]},\"actions\":[{\"type\":\"add_tags\",\"tags\":[\"seen\"]}]}", "--task", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/matched", "equals": true}}},
    {"assert": {"json": {"path": "/condition_trace/0/result", "equals": true}}},
    {"assert": {"json": {"path": "/condition_trace/1/result", "equals": false}}},
    {"assert": {"json": {"path": "/condition_trace/2/result", "equals": true}}},
    {"cli": ["automation", "preview", "--spec", "{\"name\":\"trace\",\"trigger\":{\"type\":\"manual\"},\"conditions\":{\"all\":[{\"field\":\"task.priority\",\"op\":\"in\",\"value\":[\"high\",\"critical\"]},{\"not\":{\"field\":\"task.tags\",\"op\":\"contains\",\"value\":\"skip\"}},{\"any\":[{\"field\":\"task.title\",\"op\":\"matches\",\"value\":\"(?i)crash\"},{\"field\":\"classification.category\",\"op\":\"eq\",\"value\":\"bug_fix\"}]}]},\"actions\":[{\"type\":\"add_tags\",\"tags\":[\"seen\"]}]}", "--task", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/matched", "equals": false}}},
    {"cli": ["automation", "preview", "--spec", "{\"name\":\"missing\",\"trigger\":{\"type\":\"manual\"},\"conditions\":{\"field\":\"missing.path\",\"op\":\"not_exists\"},\"actions\":[{\"type\":\"add_tags\",\"tags\":[\"seen\"]}]}", "--task", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/matched", "equals": true}}}
  ],
  "not_observable": []
}
