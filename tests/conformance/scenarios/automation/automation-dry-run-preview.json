{
  "id": "automation-dry-run-preview",
  "covers": ["C031"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Crash when idle"], "json": true},
    {"cli": ["automation", "preview", "--spec", "{\"name\":\"unsaved\",\"trigger\":{\"type\":\"event\",\"event_types\":[\"task.created\"]},\"conditions\":{\"field\":\"task.title\",\"op\":\"matches\",\"value\":\"(?i)bug|crash\"},\"actions\":[{\"type\":\"add_tags\",\"tags\":[\"needs-triage\"]},{\"type\":\"notify\",\"title\":\"New bug {{task.key}}: {{task.title}}\"}]}", "--task", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/dry_run", "equals": true}}},
    {"assert": {"json": {"path": "/status", "equals": "previewed"}}},
    {"assert": {"json": {"path": "/action_results/0/planned", "equals": "add tags ['needs-triage'] to WG-1"}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/tags", "equals": []}}}
  ],
  "not_observable": []
}
