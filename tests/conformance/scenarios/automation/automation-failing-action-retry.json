{
  "id": "automation-failing-action-retry",
  "covers": ["C026", "C033"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["automation", "create", "{\"name\":\"bad dep\",\"trigger\":{\"type\":\"event\",\"event_types\":[\"task.created\"]},\"actions\":[{\"type\":\"create_dependency\",\"depends_on\":\"WG-999\"}],\"retry_max_attempts\":2}"], "json": true},
    {"cli": ["task", "create", "x"], "json": true},
    {"drain": {"max_jobs": 20}},
    {"cli": ["automation", "runs", "--rule", "bad dep"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "failed"}}},
    {"assert": {"stdout_contains": "WG-999"}},
    {"cli": ["job", "list", "--kind", "automation_action"], "json": true},
    {"assert": {"json": {"path": "/items/0/status", "equals": "dead"}}},
    {"assert": {"json": {"path": "/items/0/attempts", "equals": 2}}},
    {"assert": {"json": {"path": "/items/0/last_error", "equals": "action 0 (create_dependency) failed: task 'WG-999' not found"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_automation.py::test_failing_action_retries_then_dead_letters: the intermediate state after the first attempt (job queued with attempts == 1 and a retry scheduled with backoff) is not observable, because the CLI cannot stop the worker between attempts or move the job's run_at; the scenario observes only the dead-letter end state reached within one drain, which the test reaches by forcing run_at to now",
      "covered_by": "CORE-20"
    }
  ]
}
