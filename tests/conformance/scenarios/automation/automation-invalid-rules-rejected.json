{
  "id": "automation-invalid-rules-rejected",
  "covers": ["C026"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["automation", "create", "{\"name\":\"bad event\",\"trigger\":{\"type\":\"event\",\"event_types\":[\"not.real\"]},\"actions\":[{\"type\":\"notify\",\"title\":\"x\"}]}"], "expect_exit": 2},
    {"assert": {"stderr_contains": "error (validation_failed)"}},
    {"cli": ["automation", "create", "{\"name\":\"bad shell\",\"trigger\":{\"type\":\"event\",\"event_types\":[\"task.created\"]},\"actions\":[{\"type\":\"run_shell\",\"command\":\"rm -rf /\"}]}"], "expect_exit": 2},
    {"assert": {"stderr_contains": "error (validation_failed)"}},
    {"cli": ["automation", "list"], "json": true},
    {"assert": {"json": {"path": "", "equals": []}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_automation.py::test_invalid_rules_rejected: the detail of each ValidationFailed (the unknown event 'not.real' and the disallowed action 'run_shell') is not printed by the CLI, which reports only 'invalid automation rule' with the validation_failed code; the rejection itself and the empty rule list are observed",
      "covered_by": "CORE-20"
    }
  ]
}
