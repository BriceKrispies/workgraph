{
  "id": "automation-recursion-guard",
  "covers": ["C026", "C033"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["automation", "create", "{\"name\":\"fractal\",\"trigger\":{\"type\":\"event\",\"event_types\":[\"task.created\"]},\"actions\":[{\"type\":\"create_child_tasks\",\"children\":[{\"title\":\"child of {{task.key}}\"}]}],\"max_depth\":2}"], "json": true},
    {"cli": ["task", "create", "root"], "json": true},
    {"drain": {"max_jobs": 50}},
    {"cli": ["automation", "process"], "json": true},
    {"drain": {"max_jobs": 50}},
    {"cli": ["automation", "process"], "json": true},
    {"cli": ["task", "list"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 3}}},
    {"cli": ["automation", "runs", "--rule", "fractal", "--status", "skipped"], "json": true},
    {"assert": {"stdout_contains": "recursion guard"}}
  ],
  "not_observable": []
}
