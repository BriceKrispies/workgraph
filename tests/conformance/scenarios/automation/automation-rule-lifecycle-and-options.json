{
  "id": "automation-rule-lifecycle-and-options",
  "covers": ["C025", "C026", "C027", "C028", "C029", "C030", "C031", "C033", "C034", "C035", "C036"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["automation", "catalog"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["automation", "create", "{\"name\":\"ping\",\"trigger\":{\"type\":\"manual\"},\"actions\":[{\"type\":\"notify\",\"title\":\"ping {{task.key}}\"}]}", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/name", "equals": "ping"}}},
    {"cli": ["automation", "list", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/0/name", "equals": "ping"}}},
    {"cli": ["automation", "show", "ping"], "json": true},
    {"assert": {"json": {"path": "/enabled", "equals": true}}},
    {"cli": ["automation", "disable", "ping"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["automation", "show", "ping", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/enabled", "equals": false}}},
    {"cli": ["automation", "enable", "ping"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["automation", "show", "ping"], "json": true},
    {"assert": {"json": {"path": "/enabled", "equals": true}}},
    {"cli": ["automation", "update", "ping", "{\"name\":\"ping\",\"trigger\":{\"type\":\"manual\"},\"actions\":[{\"type\":\"notify\",\"title\":\"pong {{task.key}}\"}]}"], "json": true},
    {"assert": {"json": {"path": "/version", "equals": 2}}},
    {"cli": ["task", "create", "Trigger me"], "json": true},
    {"cli": ["automation", "trigger", "ping", "--task", "WG-1", "--input", "{\"note\": \"from the cli\"}"], "json": true},
    {"assert": {"exit": 0}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["automation", "runs", "--rule", "ping", "--status", "succeeded", "--limit", "1"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "succeeded"}}},
    {"cli": ["automation", "notifications", "--unread"], "json": true},
    {"assert": {"json": {"path": "/0/title", "equals": "pong WG-1"}}},
    {"cli": ["automation", "notifications", "--no-unread"], "json": true},
    {"assert": {"json": {"path": "/0/title", "equals": "pong WG-1"}}},
    {"cli": ["automation", "preview", "--rule", "ping", "--task", "WG-1"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["events", "list", "--limit", "1"], "json": true, "save": {"event": "/0/id"}},
    {"assert": {"exit": 0}},
    {"cli": ["automation", "preview", "--rule", "ping", "--event", "{var:event}"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["automation", "preview", "--spec", "{\"name\":\"draft\",\"trigger\":{\"type\":\"manual\"},\"actions\":[{\"type\":\"notify\",\"title\":\"draft\"}]}"], "json": true},
    {"assert": {"exit": 0}}
  ],
  "not_observable": []
}
