{
  "id": "classify-heuristic-reclassify-evaluate",
  "covers": ["C040", "C041", "C042", "C044", "C046"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["config", "set", "llm.classification.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.classification.model", "heuristic-v1"], "json": true},
    {"cli": ["task", "create", "Fix crash in checkout page"], "json": true},
    {"cli": ["task", "create", "Add dark mode feature"], "json": true},
    {"cli": ["task", "create", "Refactor payment module"], "json": true},
    {"cli": ["task", "create", "Update README documentation"], "json": true},
    {"cli": ["task", "create", "Investigate slow query latency"], "json": true},
    {"cli": ["classify", "gold", "--task", "WG-1", "--category", "bug_fix"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["classify", "gold", "--task", "WG-2", "--category", "feature"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["classify", "gold", "--task", "WG-3", "--category", "refactor"], "json": true},
    {"cli": ["classify", "gold", "--task", "WG-4", "--category", "documentation"], "json": true},
    {"cli": ["classify", "gold", "--task", "WG-5", "--category", "performance"], "json": true},
    {"cli": ["classify", "gold"], "json": true},
    {"assert": {"json": {"path": "/4/category", "not_equals": null}}},
    {"assert": {"json": {"path": "/5", "absent": true}}},
    {"cli": ["classify", "reclassify", "--provider", "heuristic", "--model", "heuristic-v1"], "json": true},
    {"assert": {"json": {"path": "/tasks", "equals": 5}}},
    {"drain": {}},
    {"cli": ["classify", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/current/category", "equals": "bug_fix"}}},
    {"cli": ["classify", "show", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/current/category", "equals": "feature"}}},
    {"cli": ["classify", "show", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/current/category", "equals": "refactor"}}},
    {"cli": ["classify", "show", "WG-4"], "json": true},
    {"assert": {"json": {"path": "/current/category", "equals": "documentation"}}},
    {"cli": ["classify", "show", "WG-5"], "json": true},
    {"assert": {"json": {"path": "/current/category", "equals": "performance"}}},
    {"cli": ["classify", "evaluate", "--provider", "heuristic", "--model", "heuristic-v1"], "json": true, "save": {"evaluation": "/id"}},
    {"assert": {"json": {"path": "/sample_size", "equals": 5}}},
    {"assert": {"json": {"path": "/failures", "equals": 0}}},
    {"assert": {"json": {"path": "/accuracy", "equals": 1.0}}},
    {"assert": {"json": {"path": "/macro_f1", "equals": 1.0}}},
    {"assert": {"json": {"path": "/confusion/bug_fix/bug_fix", "equals": 1}}},
    {"assert": {"json": {"path": "/confusion/feature/feature", "equals": 1}}},
    {"assert": {"json": {"path": "/confusion/refactor/refactor", "equals": 1}}},
    {"assert": {"json": {"path": "/confusion/documentation/documentation", "equals": 1}}},
    {"assert": {"json": {"path": "/confusion/performance/performance", "equals": 1}}},
    {"cli": ["classify", "evaluations"], "json": true},
    {"assert": {"json": {"path": "/0/id", "equals": "{var:evaluation}"}}}
  ],
  "not_observable": []
}
