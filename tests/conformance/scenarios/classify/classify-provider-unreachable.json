{
  "id": "classify-provider-unreachable",
  "covers": ["C045", "C065", "O05"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["config", "set", "llm.providers.ollama.base_url", "http://127.0.0.1:1"], "json": true},
    {"cli": ["config", "set", "llm.providers.ollama.max_retries", "1"], "json": true},
    {"cli": ["config", "set", "llm.providers.ollama.backoff_seconds", "0"], "json": true},
    {"cli": ["config", "set", "llm.providers.ollama.timeout_seconds", "2"], "json": true},
    {"cli": ["config", "set", "llm.classification.provider", "ollama"], "json": true},
    {"cli": ["config", "set", "llm.classification.model", "x"], "json": true},
    {"cli": ["doctor"], "json": true},
    {"assert": {"stdout_contains": "llm provider ollama"}},
    {"assert": {"stdout_contains": "unreachable"}},
    {"cli": ["task", "create", "Anything"], "json": true},
    {"cli": ["classify", "request", "WG-1", "--now"], "json": true, "expect_exit": 6}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_llm_classification_search.py::test_ollama_structured_output_retries_and_errors: the Ollama wire behaviour (the structured-output format and stream=false in the request body, retries after 503 responses, the 404 unknown-model and invalid-JSON errors, and the embed endpoint) needs the fake Ollama HTTP server, which the runner cannot start, and no CLI command exposes the request body or attempt count",
      "covered_by": "SC-17"
    }
  ]
}
