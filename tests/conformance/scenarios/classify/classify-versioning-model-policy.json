{
  "id": "classify-versioning-model-policy",
  "covers": ["B09", "C038", "C039", "C045", "C046"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "true"], "json": true},
    {"cli": ["config", "set", "llm.classification.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.classification.model", "heuristic-v1"], "json": true},
    {"cli": ["task", "create", "Fix crash when login token expires", "-d", "The app throws an exception and crashes."], "json": true},
    {"drain": {}},
    {"cli": ["classify", "show", "WG-1"], "json": true, "save": {"first": "/current/id"}},
    {"assert": {"json": {"path": "/current/category", "equals": "bug_fix"}}},
    {"assert": {"json": {"path": "/current/provider", "equals": "heuristic"}}},
    {"assert": {"json": {"path": "/current/model", "equals": "heuristic-v1"}}},
    {"assert": {"json": {"path": "/current/prompt_version", "equals": "classify-v1"}}},
    {"assert": {"json": {"path": "/current/taxonomy_version", "equals": "2026.1"}}},
    {"assert": {"json": {"path": "/current/input_hash", "not_equals": null}}},
    {"assert": {"json": {"path": "/current/validation_status", "equals": "valid"}}},
    {"assert": {"json": {"path": "/current/duration_ms", "not_equals": null}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/category", "equals": "bug_fix"}}},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["task", "update", "WG-1", "-d", "Refactor the login module into smaller units."], "json": true},
    {"cli": ["classify", "request", "WG-1", "--model", "heuristic-alt", "--now", "--no-promote"], "json": true},
    {"assert": {"json": {"path": "/category", "equals": "refactor"}}},
    {"assert": {"json": {"path": "/is_current", "equals": false}}},
    {"cli": ["classify", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/current/id", "equals": "{var:first}"}}},
    {"assert": {"json": {"path": "/disagreement", "equals": true}}},
    {"cli": ["classify", "disagreements"], "json": true},
    {"assert": {"json": {"path": "/0/task_key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/1", "absent": true}}},
    {"cli": ["classify", "request", "WG-1", "--now"], "json": true, "save": {"second": "/id"}},
    {"assert": {"json": {"path": "/is_current", "equals": true}}},
    {"cli": ["classify", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/current/id", "equals": "{var:second}"}}},
    {"cli": ["classify", "request", "WG-1", "--now"], "json": true},
    {"assert": {"json": {"path": "/id", "equals": "{var:second}"}}},
    {"cli": ["config", "set", "llm.auto_classify", "true"], "json": true},
    {"cli": ["task", "update", "WG-1", "-d", "Refactor the login module into smaller units. Keep the token handling as it is."], "json": true},
    {"drain": {}},
    {"cli": ["classify", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/current/id", "not_equals": "{var:second}"}}},
    {"assert": {"json": {"path": "/current/model", "equals": "heuristic-v1"}}},
    {"cli": ["classify", "confirm", "WG-1", "security", "--note", "actually a token issue"], "json": true, "save": {"manual": "/id"}},
    {"assert": {"json": {"path": "/is_current", "equals": true}}},
    {"assert": {"json": {"path": "/source", "equals": "manual"}}},
    {"cli": ["classify", "request", "WG-1", "--model", "heuristic-alt", "--now", "--no-promote"], "json": true},
    {"assert": {"json": {"path": "/is_current", "equals": false}}},
    {"cli": ["classify", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/current/id", "equals": "{var:manual}"}}},
    {"assert": {"json": {"path": "/current/source", "equals": "manual"}}},
    {"assert": {"json": {"path": "/history/3", "not_equals": null}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_llm_classification_search.py::test_classification_job_versioning_and_model_policy: the fake Ollama server forces the alternative model (other-model) to answer refactor for the same text, which the heuristic provider cannot do because its output depends only on the task text; the scenario reaches the same alternative-model disagreement by changing the description while classifying with heuristic-alt, and the Ollama wire behaviour itself is covered by SC-17",
      "covered_by": "SC-17"
    }
  ]
}
