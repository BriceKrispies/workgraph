{
  "id": "claude-bind-sessions-unbind",
  "covers": ["C049", "C054", "C056"],
  "setup": [
    {"git": "init", "repo": "work"},
    {"git": "commit", "repo": "work", "files": {"README.md": "work\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Bound task"], "json": true},
    {"cli": ["claude", "bind", "WG-1", "--session", "sess-explicit-1", "--cwd", "{repo:work}", "--workspace", "default"], "json": true, "save": {"binding": "/binding_id"}},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/task", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/session_id", "equals": "sess-explicit-1"}}},
    {"cli": ["claude", "sessions", "--limit", "5"], "json": true},
    {"assert": {"json": {"path": "", "equals": []}}},
    {"cli": ["claude", "unbind", "--cwd", "{repo:work}"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/deactivated", "equals": 1}}},
    {"cli": ["claude", "unbind", "--cwd", "{repo:work}"], "json": true},
    {"assert": {"json": {"path": "/deactivated", "equals": 0}}},
    {"cli": ["claude", "bind", "WG-1", "--session", "sess-explicit-2"], "json": true, "save": {"second": "/binding_id"}},
    {"assert": {"exit": 0}},
    {"cli": ["claude", "unbind", "--binding", "{var:second}"], "json": true},
    {"assert": {"json": {"path": "/deactivated", "equals": 1}}},
    {"cli": ["claude", "sessions"], "json": true},
    {"assert": {"exit": 0}}
  ],
  "not_observable": []
}
