{
  "id": "claude-hook-backfill-transcripts",
  "covers": [
    "C048",
    "C050",
    "C099",
    "P03"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "transcripts"
    },
    {
      "git": "write",
      "repo": "transcripts",
      "files": {
        "agent-b1.jsonl": "{\"type\": \"user\", \"timestamp\": \"2026-10-14T08:54:30.000Z\", \"message\": {\"role\": \"user\", \"content\": \"Do the work.\"}}\n{\"type\": \"assistant\", \"timestamp\": \"2026-10-14T08:54:31.000Z\", \"message\": {\"id\": \"msg_1\", \"model\": \"claude-haiku-4-5-20251001\", \"content\": [{\"type\": \"tool_use\", \"id\": \"tu_1\", \"name\": \"Bash\", \"input\": {}}], \"usage\": {\"input_tokens\": 3, \"cache_creation_input_tokens\": 10, \"cache_read_input_tokens\": 20, \"output_tokens\": 3}}}\n{\"type\": \"assistant\", \"timestamp\": \"2026-10-14T08:54:32.000Z\", \"message\": {\"id\": \"msg_1\", \"model\": \"claude-haiku-4-5-20251001\", \"content\": [], \"usage\": {\"input_tokens\": 3, \"cache_creation_input_tokens\": 10, \"cache_read_input_tokens\": 20, \"output_tokens\": 12}}}\n"
      }
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-late\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SessionStart\", \"source\": \"startup\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-late\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SubagentStart\", \"agent_id\": \"agent-late\", \"agent_type\": \"general-purpose\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-late\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SubagentStop\", \"agent_id\": \"agent-late\", \"agent_type\": \"general-purpose\", \"agent_transcript_path\": \"transcripts/agent-late.jsonl\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "backfill-transcripts"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/parsed",
          "equals": 0
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/missing",
          "equals": 1
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/linked",
          "equals": 0
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/attempts_created",
          "equals": 0
        }
      }
    },
    {
      "cli": [
        "claude",
        "backfill-transcripts"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/parsed",
          "equals": 0
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/missing",
          "equals": 1
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/linked",
          "equals": 0
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/attempts_created",
          "equals": 0
        }
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_claude_hooks.py::test_backfill_transcripts_links_late_transcripts_idempotently: the parsed, linked and attempts_created counts once the transcript exists. Setup runs before every step, so a file cannot appear between two backfill runs",
      "covered_by": "CORE-22"
    }
  ]
}
