{
  "id": "claude-hook-explicit-session-binding",
  "covers": [
    "C050",
    "C049",
    "C054",
    "C066",
    "C099",
    "C152"
  ],
  "setup": [],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Hooked"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "show",
        "WG-1"
      ],
      "json": true,
      "save": {
        "task": "/id"
      }
    },
    {
      "cli": [
        "claude",
        "bind",
        "WG-1",
        "--session",
        "sess-1"
      ],
      "json": true
    },
    {
      "assert": {
        "exit": 0
      }
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-1\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SessionStart\", \"source\": \"startup\", \"model\": \"claude-x\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-1\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"PreToolUse\", \"tool_name\": \"Bash\", \"tool_use_id\": \"t1\", \"tool_input\": {\"command\": \"export TOKEN=sk-ant-abcdefghijklmnopqrstuvwxyz && pytest\"}}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-1\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"PostToolUse\", \"tool_name\": \"Bash\", \"tool_use_id\": \"t1\", \"tool_input\": {\"command\": \"pytest\"}, \"tool_response\": {\"stdout\": \"ok\"}, \"duration_ms\": 1200}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-1\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"PostToolUseFailure\", \"tool_name\": \"Edit\", \"tool_use_id\": \"t2\", \"tool_input\": {\"file_path\": \"/work/a.py\"}, \"error\": \"Exit code 1 password=hunter2\", \"duration_ms\": 5}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-1\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SubagentStart\", \"agent_id\": \"agent-1\", \"agent_type\": \"Explore\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-1\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SubagentStop\", \"agent_id\": \"agent-1\", \"agent_type\": \"Explore\", \"last_assistant_message\": \"Found 3 issues\", \"stop_hook_active\": false}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-1\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"TaskCreated\", \"task_id\": \"task-001\", \"task_subject\": \"Implement part of WG-1\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-1\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"TaskCompleted\", \"task_id\": \"task-001\", \"task_subject\": \"Implement part of WG-1\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-1\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"Stop\", \"last_assistant_message\": \"done\", \"stop_hook_active\": false}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-1\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SessionEnd\", \"reason\": \"other\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "sessions"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/external_session_id",
          "equals": "sess-1"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/binding",
          "equals": "explicit_binding"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/task_id",
          "equals": "{var:task}"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/model",
          "equals": "claude-x"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/tool_calls",
          "equals": 2
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/tool_failures",
          "equals": 1
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/end_reason",
          "equals": "other"
        }
      }
    },
    {
      "cli": [
        "events",
        "list",
        "--prefix",
        "agent_session"
      ],
      "json": true
    },
    {
      "assert": {
        "stdout_contains": "agent_session.started"
      }
    },
    {
      "assert": {
        "stdout_contains": "agent_session.subagent_started"
      }
    },
    {
      "assert": {
        "stdout_contains": "agent_session.subagent_stopped"
      }
    },
    {
      "assert": {
        "stdout_contains": "agent_session.internal_task_created"
      }
    },
    {
      "assert": {
        "stdout_contains": "agent_session.internal_task_completed"
      }
    },
    {
      "assert": {
        "stdout_contains": "agent_session.ended"
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_claude_hooks.py::test_session_correlation_tools_subagents_and_internal_tasks: launched-by-attempt binding (WORKGRAPH_ATTEMPT_ID), the child attempt with its parent link and status, and the orchestrator's hook_tool_calls telemetry. The runner's cli env values are literal and are not resolved against placeholders, so an attempt id cannot be passed to the hook",
      "covered_by": "CORE-22"
    },
    {
      "case": "tests/integration/test_claude_hooks.py::test_session_correlation_tools_subagents_and_internal_tasks: redaction of stored tool payloads and error excerpts (sk-ant token, password in the error). No command reads hook payloads or tool event rows",
      "covered_by": "GV-07"
    },
    {
      "case": "tests/integration/test_claude_hooks.py::test_session_correlation_tools_subagents_and_internal_tasks: tool-event rows (phase order, summary file_path) and the subagent run's own task link. No command lists them",
      "covered_by": "CORE-22"
    }
  ]
}
