{
  "id": "claude-hook-unbound-session-binds-late",
  "covers": [
    "C049",
    "C050",
    "C054",
    "C099",
    "C152"
  ],
  "setup": [],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "External session"
      ],
      "json": true
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"ext-2\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/elsewhere\", \"hook_event_name\": \"SessionStart\", \"source\": \"startup\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "sessions"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/external_session_id",
          "equals": "ext-2"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/binding",
          "equals": "unbound"
        }
      }
    },
    {
      "cli": [
        "claude",
        "bind",
        "WG-1",
        "--session",
        "ext-2"
      ],
      "json": true
    },
    {
      "assert": {
        "exit": 0
      }
    },
    {
      "cli": [
        "claude",
        "sessions"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/binding",
          "equals": "explicit_binding"
        }
      }
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"ext-3\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/elsewhere\", \"hook_event_name\": \"SessionStart\", \"source\": \"startup\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "sessions"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/external_session_id",
          "equals": "ext-3"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/binding",
          "equals": "unbound"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/1/external_session_id",
          "equals": "ext-2"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/1/binding",
          "equals": "explicit_binding"
        }
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_claude_hooks.py::test_unbound_then_explicit_binding_by_cwd: the cwd-prefix binding (`bind --cwd`, then a hook whose payload cwd is a subdirectory). The payload carries a host path inside JSON text and the runner substitutes placeholder paths unescaped, so on Windows the payload is not valid JSON. The session-id binding of the same flow is covered by this scenario",
      "covered_by": "CORE-22"
    }
  ]
}
