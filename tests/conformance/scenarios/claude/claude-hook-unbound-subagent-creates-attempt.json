{
  "id": "claude-hook-unbound-subagent-creates-attempt",
  "covers": [
    "C050",
    "C020",
    "C054",
    "C099",
    "C152",
    "P03"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "transcripts"
    },
    {
      "git": "write",
      "repo": "transcripts",
      "files": {
        "agent-u1.jsonl": "{\"type\": \"user\", \"timestamp\": \"2026-10-14T08:54:30.000Z\", \"message\": {\"role\": \"user\", \"content\": \"Task-ID: WG-1\\nDo the work.\"}}\n{\"type\": \"assistant\", \"timestamp\": \"2026-10-14T08:54:31.000Z\", \"message\": {\"id\": \"msg_1\", \"model\": \"claude-haiku-4-5-20251001\", \"content\": [{\"type\": \"tool_use\", \"id\": \"tu_1\", \"name\": \"Bash\", \"input\": {}}], \"usage\": {\"input_tokens\": 3, \"cache_creation_input_tokens\": 10, \"cache_read_input_tokens\": 20, \"output_tokens\": 3}}}\n{\"type\": \"assistant\", \"timestamp\": \"2026-10-14T08:54:32.000Z\", \"message\": {\"id\": \"msg_1\", \"model\": \"claude-haiku-4-5-20251001\", \"content\": [], \"usage\": {\"input_tokens\": 3, \"cache_creation_input_tokens\": 10, \"cache_read_input_tokens\": 20, \"output_tokens\": 40}}}\n"
      }
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Transcript target"
      ],
      "json": true
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-untracked\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SessionStart\", \"source\": \"startup\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-untracked\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SubagentStart\", \"agent_id\": \"agent-u1\", \"agent_type\": \"general-purpose\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-untracked\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SubagentStop\", \"agent_id\": \"agent-u1\", \"agent_type\": \"general-purpose\", \"agent_transcript_path\": \"transcripts/agent-u1.jsonl\", \"last_assistant_message\": \"done\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "attempt",
        "list",
        "--task",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/adapter",
          "equals": "claude_code_subagent"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/agent_id",
          "equals": "subagent:general-purpose"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/model",
          "equals": "claude-haiku-4-5-20251001"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/parent_attempt_id",
          "equals": null
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/usage/input_tokens",
          "equals": 3
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/usage/output_tokens",
          "equals": 40
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/usage/cache_creation_input_tokens",
          "equals": 10
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/usage/cache_read_input_tokens",
          "equals": 20
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/usage_source",
          "equals": "claude_code_transcript"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/telemetry/tool_uses/Bash",
          "equals": 1
        }
      }
    },
    {
      "cli": [
        "claude",
        "sessions"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/binding",
          "equals": "unbound"
        }
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_claude_hooks.py::test_unbound_subagent_transcript_creates_linked_top_level_attempt: the subagent run's own task link (SubagentRun.task_id). No command lists subagent runs; the attempt's task is asserted through attempt list --task instead",
      "covered_by": "CORE-22"
    }
  ]
}
