{
  "id": "claude-transcript-tool-uses-counted-once",
  "covers": [
    "C050",
    "C018",
    "C020",
    "C152",
    "C099",
    "P03"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "transcripts"
    },
    {
      "git": "write",
      "repo": "transcripts",
      "files": {
        "agent-c1.jsonl": "{\"type\": \"user\", \"timestamp\": \"2026-10-14T08:54:30.000Z\", \"message\": {\"role\": \"user\", \"content\": \"Task-ID: WG-1\\nDo the work.\"}}\n{\"type\": \"assistant\", \"timestamp\": \"2026-10-14T08:54:31.000Z\", \"message\": {\"id\": \"msg_a\", \"model\": \"claude-haiku-4-5-20251001\", \"usage\": {\"input_tokens\": 3, \"output_tokens\": 7}, \"content\": [{\"type\": \"tool_use\", \"id\": \"tu_b\", \"name\": \"Bash\", \"input\": {}}]}}\n{\"type\": \"assistant\", \"timestamp\": \"2026-10-14T08:54:32.000Z\", \"message\": {\"id\": \"msg_a\", \"model\": \"claude-haiku-4-5-20251001\", \"usage\": {\"input_tokens\": 3, \"output_tokens\": 9}, \"content\": [{\"type\": \"tool_use\", \"id\": \"tu_b\", \"name\": \"Bash\", \"input\": {}}]}}\n{\"type\": \"assistant\", \"timestamp\": \"2026-10-14T08:54:33.000Z\", \"message\": {\"id\": \"msg_c\", \"model\": \"claude-haiku-4-5-20251001\", \"usage\": {\"input_tokens\": 3, \"output_tokens\": 7}, \"content\": [{\"type\": \"tool_use\", \"id\": \"tu_e\", \"name\": \"Edit\", \"input\": {}}]}}\n"
      }
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Counted"
      ],
      "json": true
    },
    {
      "cli": [
        "attempt",
        "create",
        "WG-1",
        "--provider",
        "claude_code"
      ],
      "json": true
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-count\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SessionStart\", \"source\": \"startup\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-count\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SubagentStart\", \"agent_id\": \"agent-c1\", \"agent_type\": \"general-purpose\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "claude",
        "hook"
      ],
      "stdin": "{\"session_id\": \"sess-count\", \"transcript_path\": \"/t.jsonl\", \"cwd\": \"/work\", \"hook_event_name\": \"SubagentStop\", \"agent_id\": \"agent-c1\", \"agent_type\": \"general-purpose\", \"agent_transcript_path\": \"transcripts/agent-c1.jsonl\"}",
      "expect_exit": 0
    },
    {
      "cli": [
        "attempt",
        "list",
        "--task",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/telemetry/tool_uses/Bash",
          "equals": 1
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/telemetry/tool_uses/Edit",
          "equals": 1
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/usage/input_tokens",
          "equals": 6
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/usage/output_tokens",
          "equals": 16
        }
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/unit/test_transcript.py: the remaining cases (sidecar reading, missing file, malformed lines, prompt length and markers, list prompt content, telemetry JSON safety, tool-call inputs) and tests/unit/test_transcript_timing.py (classification, breakdown, slowest calls, capping, background launch). They call the parser and classifier directly, not through an interface",
      "covered_by": "GV-07"
    }
  ]
}
