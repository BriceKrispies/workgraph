{
  "id": "config-workspace-override",
  "covers": ["C060", "C061", "C181"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["workspace", "create", "acme"], "json": true},
    {"cli": ["config", "set", "--workspace", "acme", "execution.max_concurrent_runs", "7"], "json": true},
    {"assert": {"json": {"path": "/workspace", "equals": "acme"}}},
    {"assert": {"json": {"path": "/value", "equals": 7}}},
    {"cli": ["config", "show", "--workspace", "acme"], "json": true},
    {"assert": {"json": {"path": "/workspace", "equals": "acme"}}},
    {"assert": {"json": {"path": "/config/execution/max_concurrent_runs", "equals": 7}}},
    {"cli": ["config", "show"], "json": true, "env": {"WORKGRAPH_WORKSPACE": "acme"}},
    {"assert": {"json": {"path": "/workspace", "equals": "acme"}}},
    {"assert": {"json": {"path": "/config/execution/max_concurrent_runs", "equals": 7}}},
    {"cli": ["config", "show"], "json": true},
    {"assert": {"json": {"path": "/workspace", "equals": "default"}}},
    {"assert": {"json": {"path": "/config/execution/max_concurrent_runs", "equals": 2}}}
  ],
  "not_observable": []
}
