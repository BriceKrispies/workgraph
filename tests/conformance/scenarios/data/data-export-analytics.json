{
  "id": "data-export-analytics",
  "covers": ["C084"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Fact one"], "json": true},
    {"cli": ["export", "analytics", "{tmp}/a.json", "--format", "json"], "json": true},
    {"assert": {"file": "{tmp}/a.json", "exists": true}},
    {"cli": ["analytics", "export", "{tmp}/f.csv", "--dataset", "task_facts"], "json": true},
    {"assert": {"file": "{tmp}/f.csv", "exists": true}}
  ],
  "not_observable": []
}
