{
  "id": "data-export-import",
  "covers": ["C085", "C098"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Keep me", "--description", "important"], "json": true},
    {"cli": ["export", "workspace", "{tmp}/ws.jsonl"], "json": true},
    {"assert": {"json": {"path": "/tables/tasks", "equals": 1}}},
    {"assert": {"file": "{tmp}/ws.jsonl", "exists": true, "contains": "\"format\": \"workgraph-workspace-export-v1\""}},
    {"cli": ["init", "--no-workspace"], "json": true, "env": {"WORKGRAPH_HOME": "../other-home"}},
    {"cli": ["import", "{tmp}/ws.jsonl"], "json": true, "env": {"WORKGRAPH_HOME": "../other-home"}},
    {"assert": {"json": {"path": "/tables/tasks", "equals": 1}}},
    {"cli": ["-w", "default", "task", "list"], "json": true, "env": {"WORKGRAPH_HOME": "../other-home"}},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"assert": {"json": {"path": "/items/0/title", "equals": "Keep me"}}},
    {"cli": ["-w", "default", "search", "important", "--mode", "lexical"], "json": true, "env": {"WORKGRAPH_HOME": "../other-home"}},
    {"assert": {"json": {"path": "/hits/0/key", "equals": "WG-1"}}},
    {"cli": ["import", "{tmp}/ws.jsonl"], "json": true, "env": {"WORKGRAPH_HOME": "../other-home"}, "expect_exit": 3}
  ],
  "not_observable": []
}
