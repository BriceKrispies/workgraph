{
  "id": "doctor-health-report",
  "covers": ["C065"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["doctor"], "json": true},
    {"assert": {"json": {"path": "/healthy", "equals": true}}},
    {"assert": {"json": {"path": "/checks/0/check", "equals": "python"}}},
    {"assert": {"json": {"path": "/checks/1/check", "equals": "git"}}},
    {"assert": {"json": {"path": "/checks/2/check", "equals": "schema"}}},
    {"assert": {"json": {"path": "/checks/2/ok", "equals": true}}},
    {"assert": {"json": {"path": "/checks/3/check", "equals": "database integrity"}}},
    {"assert": {"json": {"path": "/checks/3/detail", "equals": "ok"}}},
    {"assert": {"stdout_contains": "configuration"}},
    {"cli": ["doctor", "--no-verify-events"], "json": true},
    {"assert": {"json": {"path": "/healthy", "equals": true}}},
    {"assert": {"stdout_contains": "agent execution"}}
  ],
  "not_observable": []
}
