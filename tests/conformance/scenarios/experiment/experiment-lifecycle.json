{
  "id": "experiment-lifecycle",
  "covers": ["C066", "C068", "C069", "C071", "C072", "C078"],
  "setup": [
    {"git": "init", "repo": "proto"},
    {"git": "commit", "repo": "proto", "files": {"protocol.json": "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40}}"}, "message": "protocol file"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["experiment", "create", "exp-one", "--title", "Experiment one", "--question", "Does it work?", "--protocol", "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40}}", "-w", "default"], "json": true, "save": {"exp_one": "/id"}},
    {"assert": {"json": {"path": "/slug", "equals": "exp-one"}}},
    {"assert": {"json": {"path": "/status", "equals": "draft"}}},
    {"assert": {"json": {"path": "/question", "equals": "Does it work?"}}},
    {"assert": {"json": {"path": "/frozen_at", "equals": null}}},
    {"cli": ["experiment", "create", "exp-two", "--title", "Experiment two", "--protocol", "@{repo:proto}/protocol.json"], "json": true, "save": {"exp_two": "/id"}},
    {"assert": {"json": {"path": "/slug", "equals": "exp-two"}}},
    {"assert": {"json": {"path": "/question", "equals": null}}},
    {"cli": ["experiment", "list"], "json": true},
    {"assert": {"json": {"path": "/0/slug", "equals": "exp-one"}}},
    {"assert": {"json": {"path": "/1/slug", "equals": "exp-two"}}},
    {"cli": ["experiment", "list", "--status", "draft"], "json": true},
    {"assert": {"json": {"path": "/0/slug", "equals": "exp-one"}}},
    {"cli": ["experiment", "freeze", "exp-one", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/slug", "equals": "exp-one"}}},
    {"assert": {"json": {"path": "/status", "equals": "running"}}},
    {"cli": ["experiment", "list", "--status", "running"], "json": true},
    {"assert": {"json": {"path": "/0/slug", "equals": "exp-one"}}},
    {"cli": ["experiment", "list", "--status", "closed"], "json": true},
    {"assert": {"json": {"path": "", "equals": []}}},
    {"cli": ["experiment", "freeze", "{var:exp_two}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "running"}}},
    {"cli": ["experiment", "show", "exp-one"], "json": true},
    {"assert": {"json": {"path": "/experiment/slug", "equals": "exp-one"}}},
    {"assert": {"json": {"path": "/experiment/status", "equals": "running"}}},
    {"assert": {"json": {"path": "/trials", "equals": []}}},
    {"cli": ["experiment", "close", "{var:exp_one}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "closed"}}},
    {"cli": ["experiment", "show", "{var:exp_one}"], "json": true},
    {"assert": {"json": {"path": "/experiment/status", "equals": "closed"}}},
    {"cli": ["experiment", "close", "exp-two", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/slug", "equals": "exp-two"}}},
    {"assert": {"json": {"path": "/status", "equals": "closed"}}},
    {"cli": ["experiment", "list", "--status", "closed"], "json": true},
    {"assert": {"json": {"path": "/1/slug", "equals": "exp-two"}}},
    {"cli": ["experiment", "list", "--status", "running", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "", "equals": []}}},
    {"cli": ["events", "list", "--entity", "{var:exp_one}", "--after", "0"], "json": true},
    {"assert": {"json": {"path": "/0/event_type", "equals": "experiment.created"}}},
    {"assert": {"json": {"path": "/1/event_type", "equals": "experiment.frozen"}}},
    {"assert": {"json": {"path": "/2/event_type", "equals": "experiment.closed"}}},
    {"assert": {"json": {"path": "/3", "absent": true}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_experiments.py::test_frozen_protocol_cannot_change: update_protocol has no CLI command, so a protocol cannot be edited before freezing and the post-freeze refusal and its protocol_updated event cannot be driven; the freeze-twice refusal is covered by experiment-refusals",
      "covered_by": "CORE-25"
    }
  ]
}
