    {
      "cli": [
        "experiment",
        "trial",
        "grade",
        "{var:t_one}"
      ],
      "json": true
    },
    {
      "cli": [
        "experiment",
        "next",
        "one-band"
      ],
      "json": true,
      "expect_exit": 2
    },
    {
      "assert": {
        "exit": 2
      }
    }
