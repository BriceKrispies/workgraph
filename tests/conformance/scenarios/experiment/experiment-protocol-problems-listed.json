{
  "id": "experiment-protocol-problems-listed",
  "covers": ["C069"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["experiment", "create", "exp-many", "--title", "Many problems", "--protocol", "{\"arms\":[{\"name\":\"a\",\"model\":\"sonnet\"},{\"name\":\"a\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"bands\":{\"min\":4,\"max\":2},\"staircase\":{\"per_visit\":0,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":\"forty\"},\"frobnicate\":true}"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"assert": {"stdout_contains": "missing keys: primary_size"}},
    {"assert": {"stdout_contains": "unknown keys: frobnicate"}},
    {"assert": {"stdout_contains": "arms[0].model"}},
    {"assert": {"stdout_contains": "alias"}},
    {"assert": {"stdout_contains": "arms[1].name 'a' is used by another arm"}},
    {"assert": {"stdout_contains": "bands.min must not exceed bands.max"}},
    {"assert": {"stdout_contains": "staircase.per_visit must be an integer >= 1"}},
    {"assert": {"stdout_contains": "budget.trials must be an integer >= 1"}},
    {"cli": ["experiment", "list"], "json": true},
    {"assert": {"json": {"path": "", "equals": []}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_experiments.py::test_bad_protocol_reports_every_problem: the test asserts the problem list has exactly seven entries; the runner has no array-length assertion for JSON output, so only the presence of each problem text is checked",
      "covered_by": "CORE-25"
    }
  ]
}
