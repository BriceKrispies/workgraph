{
  "id": "experiment-refusals",
  "covers": ["C068", "C069", "C071", "C072", "C078"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["experiment", "create", "Not A Slug", "--title", "Title", "--protocol", "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40}}"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"cli": ["experiment", "create", "exp-blank", "--title", "   ", "--protocol", "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40}}"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"cli": ["experiment", "create", "exp-alias", "--title", "Alias", "--protocol", "{\"arms\":[{\"name\":\"arm\",\"model\":\"haiku\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40}}"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"cli": ["experiment", "create", "exp-setup", "--title", "Setup", "--protocol", "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40},\"setup\":\"python\"}"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"cli": ["experiment", "create", "exp-broken", "--title", "Broken", "--protocol", "not json"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"cli": ["experiment", "create", "exp-clone", "--title", "Clone", "--protocol", "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40},\"clone\":\"bogus\"}"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"cli": ["experiment", "create", "exp-many", "--title", "Many problems", "--protocol", "{\"arms\":[{\"name\":\"a\",\"model\":\"sonnet\"},{\"name\":\"a\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"bands\":{\"min\":4,\"max\":2},\"staircase\":{\"per_visit\":0,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":\"forty\"},\"frobnicate\":true}"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"cli": ["experiment", "create", "exp-one", "--title", "Experiment one", "--protocol", "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40}}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "draft"}}},
    {"cli": ["experiment", "create", "exp-one", "--title", "Again", "--protocol", "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40}}"], "json": true, "expect_exit": 3},
    {"assert": {"exit": 3}},
    {"assert": {"json": {"path": "/error/code", "equals": "conflict"}}},
    {"cli": ["experiment", "freeze", "no-such-experiment"], "json": true, "expect_exit": 4},
    {"assert": {"exit": 4}},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}},
    {"cli": ["experiment", "freeze", "exp-one"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "running"}}},
    {"cli": ["experiment", "freeze", "exp-one"], "json": true, "expect_exit": 3},
    {"assert": {"exit": 3}},
    {"cli": ["experiment", "close", "exp-one"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "closed"}}},
    {"cli": ["experiment", "close", "exp-one"], "json": true, "expect_exit": 3},
    {"assert": {"exit": 3}},
    {"cli": ["experiment", "show", "exp-one"], "json": true},
    {"assert": {"json": {"path": "/experiment/status", "equals": "closed"}}}
  ],
  "not_observable": []
}
