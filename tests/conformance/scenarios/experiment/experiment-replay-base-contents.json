{
  "id": "experiment-replay-base-contents",
  "covers": ["C075", "C076", "C079", "C083"],
  "setup": [
    {"git": "init", "repo": "basepy"},
    {"git": "commit", "repo": "basepy", "files": {
      "pyproject.toml": "[project]\nname = \"demo\"\nversion = \"0.1.0\"\n",
      "pkg/__init__.py": "",
      "pkg/mod.py": "def f():\n    return 1\n"
    }, "message": "add project"},
    {"git": "commit", "repo": "basepy", "files": {"tests/test_old.py": "def test_old():\n    assert True\n"}, "message": "old test"},
    {"git": "delete", "repo": "basepy", "args": ["tests/test_old.py"]},
    {"git": "commit", "repo": "basepy", "files": {
      "pkg/mod.py": "def f():\n    return 1\n\n\ndef g():\n    return 2\n",
      "pkg/extra.py": "X = 1\n",
      "tests/test_mod.py": "from pkg.mod import g\n\n\ndef test_g():\n    assert g() == 2\n"
    }, "message": "replace test"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:basepy}"], "json": true},
    {"cli": ["experiment", "replay", "scan", "--repo", "basepy"], "json": true, "save": {"replace_sha": "/0/sha"}},
    {"assert": {"stdout_contains": "tests/test_old.py"}},
    {"cli": ["experiment", "replay", "create", "--repo", "basepy", "{var:replace_sha}"], "json": true, "save": {"base_task": "/0/task_key"}},
    {"assert": {"json": {"path": "/0/status", "equals": "created"}}},
    {"cli": ["experiment", "create", "basecontents", "--title", "Base contents", "--protocol", "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40},\"oracle_template\":[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"]}"], "json": true},
    {"cli": ["experiment", "freeze", "basecontents"], "json": true},
    {"cli": ["experiment", "trial", "add", "basecontents", "{var:base_task}", "--arm", "haiku", "--phase", "live"], "json": true, "save": {"base_trial": "/id"}},
    {"cli": ["experiment", "trial", "start", "{var:base_trial}"], "json": true, "save": {"base_wt": "/worktree"}},
    {"assert": {"file": "{var:base_wt}{sep}tests{sep}test_mod.py", "exists": true, "contains": "def test_g"}},
    {"assert": {"file": "{var:base_wt}{sep}pkg{sep}mod.py", "exists": true}},
    {"assert": {"file": "{var:base_wt}{sep}pkg{sep}extra.py", "exists": false}},
    {"assert": {"file": "{var:base_wt}{sep}tests{sep}test_old.py", "exists": false}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_replay.py::test_create_base_contents: the base's pkg/mod.py equal to the parent's content is only checked by file existence here, and the claims that the user's uncommitted edit, untracked file, index bytes and status are untouched by create_base, and that a second call returns the same ref, are not visible through any command",
      "covered_by": "GV-17"
    },
    {
      "case": "tests/integration/test_replay.py::test_create_base_conflict_raises: a pre-existing wg/replay branch at a different tree needs the twelve-character sha prefix in its name, which no step can compute, and the ValueError is not a CLI-visible error shape",
      "covered_by": "GV-17"
    }
  ]
}
