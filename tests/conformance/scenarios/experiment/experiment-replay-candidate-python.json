{
  "id": "experiment-replay-candidate-python",
  "covers": ["C076"],
  "setup": [
    {"git": "init", "repo": "pyfeat"},
    {"git": "commit", "repo": "pyfeat", "files": {
      "pyproject.toml": "[project]\nname = \"demo\"\nversion = \"0.1.0\"\n",
      "pkg/__init__.py": "",
      "pkg/mod.py": "def f():\n    return 1\n"
    }, "message": "add project"},
    {"git": "commit", "repo": "pyfeat", "files": {
      "pkg/mod.py": "def f():\n    return 1\n\n\ndef g():\n    return 2\n",
      "tests/test_mod.py": "from pkg.mod import g\n\n\ndef test_g():\n    assert g() == 2\n"
    }, "message": "Add g"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:pyfeat}"], "json": true},
    {"cli": ["experiment", "replay", "scan", "--repo", "pyfeat", "--rev", "HEAD~1", "--include-excluded", "--min-lines", "0", "--limit", "1"], "json": true, "save": {"parent_sha": "/0/sha"}},
    {"assert": {"json": {"path": "/0/parent", "equals": null}}},
    {"assert": {"stdout_contains": "\"root\""}},
    {"cli": ["experiment", "replay", "scan", "--repo", "pyfeat"], "json": true, "save": {"feature_sha": "/0/sha"}},
    {"assert": {"json": {"path": "/0/sha", "equals": "{var:feature_sha}"}}},
    {"assert": {"json": {"path": "/0/parent", "equals": "{var:parent_sha}"}}},
    {"assert": {"json": {"path": "/0/subject", "equals": "Add g"}}},
    {"assert": {"json": {"path": "/0/excluded", "equals": []}}},
    {"assert": {"json": {"path": "/0/test_paths", "equals": ["tests/test_mod.py"]}}},
    {"assert": {"json": {"path": "/0/source_paths", "equals": ["pkg/mod.py"]}}},
    {"assert": {"json": {"path": "/0/features/src_lines", "equals": 4}}},
    {"assert": {"json": {"path": "/0/features/test_lines", "equals": 5}}},
    {"assert": {"json": {"path": "/0/features/src_files", "equals": 1}}},
    {"assert": {"json": {"path": "/0/features/test_files", "equals": 1}}},
    {"assert": {"json": {"path": "/0/features/packages", "equals": [""]}}},
    {"assert": {"json": {"path": "/0/features/band", "equals": 2}}},
    {"assert": {"json": {"path": "/0/oracle", "equals": [["python", "-m", "pytest", "-q", "tests/test_mod.py"]]}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_replay.py::test_match_glob: the eighteen parametrized cases exercise the pure match_glob helper directly; no command prints a glob match, so each case is only reachable through the test-path classification that scan applies, and the cases with unusual shapes (a/*.rs, Cargo.lock at a subdirectory, **/generated/**) are not built into repositories",
      "covered_by": "GV-17"
    }
  ]
}
