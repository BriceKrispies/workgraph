{
  "id": "experiment-replay-candidate-rust",
  "covers": ["C076"],
  "setup": [
    {"git": "init", "repo": "rustfeat"},
    {"git": "commit", "repo": "rustfeat", "files": {
      "Cargo.toml": "[workspace]\nmembers = [\"crates/foo\"]\n",
      "crates/foo/Cargo.toml": "[package]\nname = \"foo-core\"\nversion = \"0.1.0\"\n",
      "crates/foo/src/lib.rs": "pub fn one() -> u32 {\n    1\n}\n",
      "crates/foo/tests/common/mod.rs": "pub fn helper() {}\n"
    }, "message": "crate"},
    {"git": "commit", "repo": "rustfeat", "files": {
      "crates/foo/src/lib.rs": "pub fn one() -> u32 {\n    1\n}\n\npub fn two() -> u32 {\n    2\n}\n",
      "crates/foo/src/x_tests.rs": "use crate::two;\n\n#[test]\nfn two_is_two() { assert_eq!(two(), 2); }\n",
      "crates/foo/tests/bar.rs": "use foo_core::two;\n\n#[test]\nfn bar() { assert_eq!(two(), 2); }\n"
    }, "message": "Add two"},
    {"git": "commit", "repo": "rustfeat", "files": {
      "crates/foo/tests/common/mod.rs": "pub fn helper() -> u32 {\n    3\n}\n",
      "crates/foo/src/lib.rs": "pub fn one() -> u32 {\n    1\n}\n\npub fn two() -> u32 {\n    2\n}\n\npub fn three() -> u32 {\n    3\n}\n"
    }, "message": "helper only"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:rustfeat}"], "json": true},
    {"cli": ["experiment", "replay", "scan", "--repo", "rustfeat", "--rev", "HEAD~1", "--limit", "1"], "json": true},
    {"assert": {"json": {"path": "/0/subject", "equals": "Add two"}}},
    {"assert": {"json": {"path": "/0/excluded", "equals": []}}},
    {"assert": {"json": {"path": "/0/features/packages", "equals": ["crates/foo"]}}},
    {"assert": {"json": {"path": "/0/features/src_lines", "equals": 4}}},
    {"assert": {"json": {"path": "/0/features/test_lines", "equals": 8}}},
    {"assert": {"json": {"path": "/0/test_paths", "equals": ["crates/foo/src/x_tests.rs", "crates/foo/tests/bar.rs"]}}},
    {"assert": {"json": {"path": "/0/oracle", "equals": [["cargo", "test", "-p", "foo-core", "--lib"], ["cargo", "test", "-p", "foo-core", "--test", "bar"]]}}},
    {"cli": ["experiment", "replay", "scan", "--repo", "rustfeat", "--include-excluded", "--min-lines", "0", "--limit", "1"], "json": true},
    {"assert": {"json": {"path": "/0/subject", "equals": "helper only"}}},
    {"assert": {"json": {"path": "/0/oracle", "equals": []}}},
    {"assert": {"json": {"path": "/0/excluded", "equals": ["no_oracle"]}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_replay.py::test_rust_oracle_resolution: resolve_oracle's filtering of a deleted test path (gone.rs) and of a non-target helper module (common/mod.rs) is only reachable through the public resolve_oracle function, which no CLI command calls; the scan oracle above covers the analyze_commit path only",
      "covered_by": "GV-17"
    },
    {
      "case": "tests/integration/test_replay.py::test_for_repository_defaults: ReplayConfig's ignore_globs (Cargo.lock, generated trees), source_suffixes tuples and test_globs constants are not printed by any command; the defaults show only indirectly through the scan results asserted in the candidate scenarios",
      "covered_by": "GV-17"
    }
  ]
}
