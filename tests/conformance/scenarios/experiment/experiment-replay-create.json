{
  "id": "experiment-replay-create",
  "covers": [
    "C075"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "lab"
    },
    {
      "git": "commit",
      "repo": "lab",
      "files": {
        "pyproject.toml": "[project]\nname = \"demo\"\nversion = \"0.1.0\"\n",
        ".gitignore": ".pytest_cache/\n__pycache__/\n",
        "pkg/__init__.py": "",
        "pkg/mod.py": "def f():\n    return 1\n",
        "tests/test_mod.py": "from pkg.mod import f\n\n\ndef test_f():\n    assert f() == 1\n",
        "flag.txt": "0\n"
      },
      "message": "add project"
    },
    {
      "git": "commit",
      "repo": "lab",
      "files": {
        "pkg/mod.py": "def f():\n    return 1\nA1_0 = 0\nA1_1 = 1\n",
        "tests/test_mod.py": "from pkg.mod import f\n\n\ndef test_f():\n    assert f() == 1\n\n\ndef test_a():\n    assert True\n",
        "flag.txt": "1\n"
      },
      "message": "add constants a"
    },
    {
      "git": "commit",
      "repo": "lab",
      "files": {
        "flag.txt": "0\n"
      },
      "message": "reset flag after a"
    },
    {
      "git": "commit",
      "repo": "lab",
      "files": {
        "pkg/mod.py": "def f():\n    return 1\nA1_0 = 0\nA1_1 = 1\nB2_0 = 0\nB2_1 = 1\nB2_2 = 2\nB2_3 = 3\n",
        "tests/test_mod.py": "from pkg.mod import f\n\n\ndef test_f():\n    assert f() == 1\n\n\ndef test_a():\n    assert True\n\n\ndef test_b():\n    assert True\n",
        "flag.txt": "1\n"
      },
      "message": "add constants b"
    },
    {
      "git": "commit",
      "repo": "lab",
      "files": {
        "flag.txt": "0\n"
      },
      "message": "reset flag after b"
    },
    {
      "git": "commit",
      "repo": "lab",
      "files": {
        "pkg/mod.py": "def f():\n    return 1\nA1_0 = 0\nA1_1 = 1\nB2_0 = 0\nB2_1 = 1\nB2_2 = 2\nB2_3 = 3\nC3_0 = 0\nC3_1 = 1\nC3_2 = 2\nC3_3 = 3\nC3_4 = 4\nC3_5 = 5\nC3_6 = 6\nC3_7 = 7\n",
        "tests/test_mod.py": "from pkg.mod import f\n\n\ndef test_f():\n    assert f() == 1\n\n\ndef test_a():\n    assert True\n\n\ndef test_b():\n    assert True\n\n\ndef test_c():\n    assert True\n",
        "flag.txt": "1\n"
      },
      "message": "add constants c"
    },
    {
      "git": "commit",
      "repo": "lab",
      "files": {
        "flag.txt": "0\n"
      },
      "message": "reset flag after c"
    },
    {
      "git": "commit",
      "repo": "lab",
      "files": {
        "pkg/mod.py": "def f():\n    return 1\nA1_0 = 0\nA1_1 = 1\nB2_0 = 0\nB2_1 = 1\nB2_2 = 2\nB2_3 = 3\nC3_0 = 0\nC3_1 = 1\nC3_2 = 2\nC3_3 = 3\nC3_4 = 4\nC3_5 = 5\nC3_6 = 6\nC3_7 = 7\nD4_0 = 0\nD4_1 = 1\nD4_2 = 2\nD4_3 = 3\nD4_4 = 4\nD4_5 = 5\nD4_6 = 6\nD4_7 = 7\nD4_8 = 8\nD4_9 = 9\nD4_10 = 10\nD4_11 = 11\nD4_12 = 12\nD4_13 = 13\nD4_14 = 14\nD4_15 = 15\n",
        "tests/test_mod.py": "from pkg.mod import f\n\n\ndef test_f():\n    assert f() == 1\n\n\ndef test_a():\n    assert True\n\n\ndef test_b():\n    assert True\n\n\ndef test_c():\n    assert True\n\n\ndef test_d():\n    assert True\n",
        "flag.txt": "1\n"
      },
      "message": "add constants d"
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:lab}"
      ],
      "json": true
    },
    {
      "cli": [
        "experiment",
        "replay",
        "scan",
        "--repo",
        "lab"
      ],
      "json": true,
      "save": {
        "sha4": "/0/sha",
        "sha3": "/1/sha",
        "sha2": "/2/sha",
        "sha1": "/3/sha"
      }
    },
    {
      "cli": [
        "experiment",
        "replay",
        "scan",
        "--repo",
        "lab",
        "--min-lines",
        "0",
        "--include-excluded"
      ],
      "json": true,
      "save": {
        "reset3": "/1/sha"
      }
    },
    {
      "cli": [
        "experiment",
        "replay",
        "create",
        "--repo",
        "lab",
        "{var:sha4}",
        "--validate",
        "--oracle-template",
        "[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"]",
        "--env",
        "FLAG_MODE=strict",
        "--timeout",
        "600"
      ],
      "json": true,
      "save": {
        "task4": "/0/task_key"
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/status",
          "equals": "created"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/reason",
          "equals": null
        }
      }
    },
    {
      "cli": [
        "experiment",
        "replay",
        "create",
        "--repo",
        "lab",
        "{var:sha4}",
        "--oracle-template",
        "[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"]"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/status",
          "equals": "exists"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/task_key",
          "equals": "{var:task4}"
        }
      }
    },
    {
      "cli": [
        "experiment",
        "replay",
        "create",
        "--repo",
        "lab",
        "{var:sha3}",
        "{var:sha2}",
        "--oracle-template",
        "[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"]"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/status",
          "equals": "created"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/1/status",
          "equals": "created"
        }
      }
    },
    {
      "cli": [
        "experiment",
        "replay",
        "create",
        "--repo",
        "lab",
        "{var:reset3}",
        "--oracle-template",
        "[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"]"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/status",
          "equals": "skipped"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/reason",
          "equals": "no_tests,no_source,no_oracle"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/task_key",
          "equals": null
        }
      }
    },
    {
      "cli": [
        "experiment",
        "replay",
        "create",
        "--repo",
        "lab",
        "{var:sha1}",
        "--validate",
        "--oracle-template",
        "[\"python\",\"-c\",\"import sys; sys.exit(1)\"]"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/status",
          "equals": "rejected"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/reason",
          "equals": "oracle_red_at_solution"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/task_key",
          "equals": null
        }
      }
    },
    {
      "cli": [
        "experiment",
        "replay",
        "create",
        "--repo",
        "lab",
        "{var:sha1}",
        "--validate",
        "--oracle-template",
        "[\"python\",\"-c\",\"import sys; sys.exit(0)\"]"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/status",
          "equals": "rejected"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/reason",
          "equals": "oracle_green_at_base"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/task_key",
          "equals": null
        }
      }
    },
    {
      "cli": [
        "experiment",
        "replay",
        "create",
        "--repo",
        "lab",
        "{var:sha1}",
        "--oracle-template",
        "not json"
      ],
      "json": true,
      "expect_exit": 2
    },
    {
      "assert": {
        "exit": 2
      }
    },
    {
      "cli": [
        "experiment",
        "replay",
        "create",
        "--repo",
        "lab",
        "{var:sha1}",
        "--oracle-template",
        "[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"]",
        "--env",
        "NOEQUALS"
      ],
      "json": true,
      "expect_exit": 2
    },
    {
      "assert": {
        "exit": 2
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_replay.py::test_validate_accepts_red_base_and_green_solution: the create output gives only the status and reason, so the per-command exit codes of the base and solution runs and the removal of the temporary validation worktree and workdir are not visible",
      "covered_by": "GV-17"
    },
    {
      "case": "tests/integration/test_replay.py::test_validate_rejects_green_base: the rejection status and reason are asserted above, but the solution exit codes and the removal of the temporary validation worktree and workdir are not printed",
      "covered_by": "GV-17"
    },
    {
      "case": "tests/integration/test_replay.py::test_validate_rejects_red_solution: the rejection status and reason are asserted above, but the empty base exit codes (the solution runs first) and the removal of the temporary validation worktree are not printed",
      "covered_by": "GV-17"
    }
  ]
}
