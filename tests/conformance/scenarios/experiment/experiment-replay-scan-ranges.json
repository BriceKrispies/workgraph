{
  "id": "experiment-replay-scan-ranges",
  "covers": ["C076"],
  "setup": [
    {"git": "init", "repo": "ranges"},
    {"git": "commit", "repo": "ranges", "files": {
      "pyproject.toml": "[project]\nname = \"demo\"\nversion = \"0.1.0\"\n",
      "pkg/__init__.py": "",
      "pkg/mod.py": "def f():\n    return 1\n"
    }, "message": "add project"},
    {"git": "commit", "repo": "ranges", "files": {"pkg/a.py": "V0 = 0\n", "tests/test_a.py": "def test_x():\n    pass\n"}, "message": "add a"},
    {"git": "commit", "repo": "ranges", "files": {"pkg/b.py": "V0 = 0\nV1 = 1\nV2 = 2\nV3 = 3\n", "tests/test_b.py": "def test_x():\n    pass\n"}, "message": "add b"},
    {"git": "commit", "repo": "ranges", "files": {"pkg/c.py": "V0 = 0\nV1 = 1\nV2 = 2\nV3 = 3\nV4 = 4\nV5 = 5\nV6 = 6\nV7 = 7\nV8 = 8\nV9 = 9\n", "tests/test_c.py": "def test_x():\n    pass\n"}, "message": "add c"},
    {"git": "commit", "repo": "ranges", "files": {"tests/test_d.py": "def test_d():\n    pass\n"}, "message": "tests only"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:ranges}"], "json": true},
    {"cli": ["experiment", "replay", "scan", "--repo", "ranges"], "json": true, "save": {"sha_c": "/0/sha", "sha_b": "/1/sha", "sha_a": "/2/sha"}},
    {"assert": {"json": {"path": "/0/features/src_lines", "equals": 10}}},
    {"assert": {"json": {"path": "/1/features/src_lines", "equals": 4}}},
    {"assert": {"json": {"path": "/2/features/src_lines", "equals": 1}}},
    {"assert": {"json": {"path": "/3", "absent": true}}},
    {"cli": ["experiment", "replay", "scan", "--repo", "ranges", "--min-lines", "2", "--max-lines", "8"], "json": true},
    {"assert": {"json": {"path": "/0/sha", "equals": "{var:sha_b}"}}},
    {"assert": {"json": {"path": "/1", "absent": true}}},
    {"cli": ["experiment", "replay", "scan", "--repo", "ranges", "--limit", "2"], "json": true},
    {"assert": {"json": {"path": "/0/sha", "equals": "{var:sha_c}"}}},
    {"assert": {"json": {"path": "/1/sha", "equals": "{var:sha_b}"}}},
    {"assert": {"json": {"path": "/2", "absent": true}}},
    {"cli": ["experiment", "replay", "scan", "--repo", "ranges", "--min-lines", "0", "--include-excluded", "--limit", "1"], "json": true},
    {"assert": {"json": {"path": "/0/features/src_lines", "equals": 0}}},
    {"assert": {"stdout_contains": "\"no_source\""}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_replay.py::test_scan_respects_range_limit_and_writes_nothing: the range, limit and include-excluded results are asserted above, but the claim that scan leaves HEAD, refs, the index and the work tree unchanged reads git state that no command prints",
      "covered_by": "GV-17"
    }
  ]
}
