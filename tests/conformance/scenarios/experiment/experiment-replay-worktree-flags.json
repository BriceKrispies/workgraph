    {"cli": ["experiment", "freeze", "flagexp"], "json": true},
    {"cli": ["experiment", "trial", "add", "flagexp", "{var:flag_task}", "--arm", "haiku", "--phase", "live"], "json": true, "save": {"flag_trial": "/id"}},
    {"cli": ["experiment", "trial", "start", "{var:flag_trial}"], "json": true},
