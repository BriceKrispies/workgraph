{
  "id": "experiment-trial-add-preconditions",
  "covers": ["C068", "C069", "C071", "C079", "C080"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Measured change"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-1"}}},
    {"cli": ["experiment", "create", "exp-one", "--title", "Experiment one", "--protocol", "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":5},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40}}"], "json": true},
    {"cli": ["experiment", "trial", "add", "exp-one", "WG-1", "--arm", "haiku", "--phase", "staircase"], "json": true, "expect_exit": 3},
    {"assert": {"exit": 3}},
    {"cli": ["experiment", "freeze", "exp-one"], "json": true},
    {"cli": ["experiment", "trial", "add", "exp-one", "WG-1", "--arm", "missing", "--phase", "staircase"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"assert": {"stdout_contains": "not in the protocol"}},
    {"cli": ["experiment", "trial", "add", "exp-one", "WG-1", "--arm", "haiku", "--phase", "warmup"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"assert": {"stdout_contains": "phase"}},
    {"cli": ["experiment", "trial", "add", "exp-one", "WG-1", "--arm", "haiku", "--phase", "staircase", "--band", "9"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"assert": {"stdout_contains": "band 9"}},
    {"cli": ["experiment", "trial", "add", "exp-one", "WG-1", "--arm", "haiku", "--phase", "staircase", "--band", "3"], "json": true, "save": {"trial_first": "/id"}},
    {"assert": {"json": {"path": "/seq", "equals": 1}}},
    {"assert": {"json": {"path": "/requested_model", "equals": "claude-haiku-5-5"}}},
    {"assert": {"json": {"path": "/status", "equals": "planned"}}},
    {"assert": {"json": {"path": "/task_key", "equals": "WG-1"}}},
    {"cli": ["experiment", "trial", "classify", "{var:trial_first}", "--cause", "too_big", "--source", "agent"], "json": true, "expect_exit": 3},
    {"assert": {"exit": 3}},
    {"cli": ["experiment", "trial", "add", "exp-one", "WG-1", "--arm", "haiku", "--phase", "repeat"], "json": true},
    {"assert": {"json": {"path": "/seq", "equals": 2}}},
    {"cli": ["experiment", "close", "exp-one"], "json": true},
    {"cli": ["experiment", "trial", "add", "exp-one", "WG-1", "--arm", "haiku", "--phase", "staircase"], "json": true, "expect_exit": 3},
    {"assert": {"exit": 3}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_experiments.py::test_add_trial_requires_running_experiment_and_known_arm: the test passes features={'source_lines': 120} and asserts the stored predicted features; the trial add command takes no features argument, so that sub-case cannot be set or checked from the CLI",
      "covered_by": "CORE-25"
    }
  ]
}
