      "json": true,
      "expect_exit": 2
    },
    {
      "assert": {
        "exit": 2
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "show",
        "{var:trial_fail}",
        "-w",
        "default"
      ],
      "json": true
