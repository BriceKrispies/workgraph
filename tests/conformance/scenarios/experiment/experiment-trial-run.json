        "--protocol",
        "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40},\"oracle_template\":[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"],\"setup\":[[\"python\",\"-c\",\"import sys; open(sys.argv[1], 'w').write('1')\",\"{worktree}/flag.txt\"]],\"gates\":[[\"python\",\"-c\",\"raise SystemExit(1)\"]]}"
      ],
      "json": true
