        }
      }
    },
    {"cli": ["experiment", "trial", "classify", "{var:trial_pass}", "--cause", "too_big", "--source", "agent"], "json": true, "expect_exit": 3},
    {"assert": {"exit": 3}},
    {"cli": ["experiment", "trial", "classify", "{var:trial_fail}", "--cause", "too_big", "--source", "agent"], "json": true, "expect_exit": 3},
    {"assert": {"exit": 3}},
    {"cli": ["events", "list", "--entity", "{var:trial_fail}", "--after", "0"], "json": true},
    {"assert": {"json": {"path": "/0/event_type", "equals": "experiment_trial.added"}}},
    {"assert": {"json": {"path": "/1/event_type", "equals": "experiment_trial.started"}}},
