        "json": {
          "path": "/failure_cause",
          "equals": "too_big"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/failure_cause_source",
          "equals": "agent"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/notes",
          "equals": "whole feature"
        }
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "classify",
        "{var:trial_fail}",
        "--cause",
        "nonsense",
        "--source",
        "agent"
      ],
      "json": true,
      "expect_exit": 2
    },
    {
      "assert": {
        "exit": 2
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "classify",
        "{var:trial_fail}",
        "--cause",
        "too_big",
        "--source",
        "robot"
