  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:lab}"
      ],
      "json": true
    },
    {
      "cli": [
        "experiment",
        "replay",
        "scan",
        "--repo",
        "lab"
      ],
      "json": true,
      "save": {
        "sha4": "/0/sha",
        "sha3": "/1/sha"
      }
    },
    {
      "cli": [
        "experiment",
        "replay",
        "create",
        "--repo",
        "lab",
        "{var:sha4}",
        "{var:sha3}",
        "--validate",
        "--oracle-template",
        "[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"]"
      ],
      "json": true,
      "save": {
        "task4": "/0/task_key",
        "task3": "/1/task_key"
      }
    },
    {
      "assert": {
        "json": {
          "path": "/0/status",
          "equals": "created"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/1/status",
          "equals": "created"
        }
      }
    },
    {
      "cli": [
        "experiment",
        "create",
        "run-fail",
        "--title",
        "Run fail",
        "--question",
        "Does a no-change trial fail?",
        "--protocol",
        "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40},\"oracle_template\":[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"]}"
      ],
      "json": true
    },
    {
      "cli": [
        "experiment",
        "freeze",
        "run-fail"
      ],
      "json": true
    },
    {
      "cli": [
        "experiment",
        "trial",
        "add",
        "run-fail",
        "{var:task4}",
        "--arm",
        "haiku",
        "--phase",
        "staircase",
        "--band",
        "4",
        "-w",
        "default"
      ],
      "json": true,
      "save": {
        "trial_fail": "/id"
      }
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "planned"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/band",
          "equals": 4
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/seq",
          "equals": 1
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/requested_model",
          "equals": "claude-haiku-5-5"
        }
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "add",
        "run-fail",
        "{var:task4}",
        "--arm",
        "haiku",
        "--phase",
        "live"
      ],
      "json": true,
      "save": {
        "trial_live": "/id"
      }
    },
    {
      "assert": {
        "json": {
          "path": "/seq",
          "equals": 2
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/band",
          "equals": null
        }
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "add",
        "run-fail",
        "{var:task4}",
        "--arm",
        "missing",
        "--phase",
        "staircase"
      ],
      "json": true,
      "expect_exit": 2
    },
    {
      "assert": {
        "exit": 2
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "add",
        "run-fail",
        "{var:task4}",
        "--arm",
        "haiku",
        "--phase",
        "warmup"
      ],
      "json": true,
      "expect_exit": 2
    },
    {
      "assert": {
        "exit": 2
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "add",
        "run-fail",
        "{var:task4}",
        "--arm",
        "haiku",
        "--phase",
        "staircase",
        "--band",
        "9"
      ],
      "json": true,
      "expect_exit": 2
    },
    {
      "assert": {
        "exit": 2
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "show",
        "{var:trial_fail}",
        "-w",
        "default"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "planned"
        }
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "grade",
        "{var:trial_live}"
      ],
      "json": true,
      "expect_exit": 3
    },
    {
      "assert": {
        "exit": 3
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "start",
        "{var:trial_fail}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/trial/status",
          "equals": "running"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/trial/id",
          "equals": "{var:trial_fail}"
        }
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "start",
        "{var:trial_fail}"
      ],
      "json": true,
      "expect_exit": 3
    },
    {
      "assert": {
        "exit": 3
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "grade",
        "{var:trial_fail}",
        "--timeout",
        "600"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "graded"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/outcome",
          "equals": "fail"
        }
      }
    },
    {
