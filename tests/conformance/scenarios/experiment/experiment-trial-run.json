    {
      "assert": {
        "json": {
          "path": "/failure_cause",
          "equals": "too_big"
        }
      }
    },
    {
      "cli": [
        "experiment",
        "close",
        "run-fail"
      ],
      "json": true
    },
    {
      "cli": [
        "experiment",
        "trial",
        "add",
        "run-fail",
        "{var:task4}",
        "--arm",
        "haiku",
        "--phase",
        "repeat"
      ],
      "json": true,
      "expect_exit": 3
    },
    {
      "assert": {
        "exit": 3
      }
    },
    {
      "cli": [
        "experiment",
        "create",
        "run-pass",
        "--title",
        "Run pass",
        "--protocol",
        "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40},\"oracle_template\":[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"],\"setup\":[[\"python\",\"-c\",\"import sys; open(sys.argv[1], 'w').write('1')\",\"{worktree}/flag.txt\"]]}"
      ],
      "json": true
    },
    {
      "cli": [
        "experiment",
        "freeze",
        "run-pass"
      ],
      "json": true
    },
    {
      "cli": [
        "experiment",
        "trial",
        "add",
        "run-pass",
        "{var:task3}",
        "--arm",
        "haiku",
        "--phase",
        "staircase",
        "--band",
        "3"
      ],
      "json": true,
      "save": {
        "trial_pass": "/id"
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "start",
        "{var:trial_pass}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/trial/status",
          "equals": "running"
        }
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "grade",
        "{var:trial_pass}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "graded"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/outcome",
          "equals": "pass"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/failure_cause",
          "equals": null
        }
      }
    },
    {
      "cli": [
        "experiment",
        "trial",
        "show",
        "{var:trial_pass}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/outcome",
          "equals": "pass"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/task_key",
          "equals": "{var:task3}"
        }
      }
    },
    {
      "cli": [
        "experiment",
        "create",
        "bad-setup",
        "--title",
        "Bad setup",
        "--protocol",
        "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":4},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40},\"oracle_template\":[\"python\",\"-c\",\"import sys; sys.exit(0 if open('flag.txt').read().strip() == '1' else 1)\"],\"setup\":[[\"python\",\"-c\",\"raise SystemExit(3)\"]]}"
      ],
      "json": true
    },
    {
      "cli": [
        "experiment",
        "freeze",
        "bad-setup"
      ],
      "json": true
    },
    {
      "cli": [
        "experiment",
        "trial",
        "add",
        "bad-setup",
        "{var:task4}",
        "--arm",
        "haiku",
        "--phase",
        "staircase"
      ],
      "json": true,
      "save": {
