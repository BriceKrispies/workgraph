{
  "id": "foundations-config-invalid-documents",
  "covers": ["C061", "C062", "E01"],
  "setup": [
    {"git": "init", "repo": "cfg-port"},
    {"git": "write", "repo": "cfg-port", "files": {"config/config.toml": "[server]\nport = 0\n"}},
    {"git": "init", "repo": "cfg-toml"},
    {"git": "write", "repo": "cfg-toml", "files": {"config/config.toml": "not = [valid\n"}}
  ],
  "steps": [
    {"cli": ["--home", "{repo:cfg-port}", "config", "show"], "json": true, "expect_exit": 7},
    {"assert": {"stdout_contains": "config_error"}},
    {"assert": {"stdout_contains": "port"}},
    {"cli": ["--home", "{repo:cfg-port}", "config", "validate"], "json": true, "expect_exit": 7},
    {"assert": {"json": {"path": "/valid", "equals": false}}},
    {"cli": ["--home", "{repo:cfg-toml}", "config", "show"], "json": true, "expect_exit": 7},
    {"assert": {"stdout_contains": "config_error"}},
    {"cli": ["--home", "{repo:cfg-toml}", "config", "validate"], "json": true, "expect_exit": 7},
    {"assert": {"json": {"path": "/valid", "equals": false}}}
  ],
  "not_observable": []
}
