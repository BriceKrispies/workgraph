{
  "id": "foundations-config-schema-version-type",
  "covers": ["C058", "C061", "E01"],
  "setup": [
    {"git": "init", "repo": "sv-text"},
    {"git": "write", "repo": "sv-text", "files": {"config/config.toml": "schema_version = \"two\"\n"}},
    {"git": "init", "repo": "sv-float"},
    {"git": "write", "repo": "sv-float", "files": {"config/config.toml": "schema_version = 2.0\n"}}
  ],
  "steps": [
    {"cli": ["--home", "{repo:sv-text}", "config", "show"], "json": true, "expect_exit": 7},
    {"assert": {"stdout_contains": "schema_version"}},
    {"cli": ["--home", "{repo:sv-text}", "config", "migrate"], "json": true, "expect_exit": 7},
    {"assert": {"stdout_contains": "schema_version"}},
    {"cli": ["--home", "{repo:sv-float}", "config", "show"], "json": true, "expect_exit": 7},
    {"assert": {"stdout_contains": "schema_version"}},
    {"cli": ["--home", "{repo:sv-float}", "config", "migrate"], "json": true, "expect_exit": 7},
    {"assert": {"stdout_contains": "schema_version"}}
  ],
  "not_observable": []
}
