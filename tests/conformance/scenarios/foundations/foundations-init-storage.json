{
  "id": "foundations-init-storage",
  "covers": ["C099", "E01"],
  "steps": [
    {"cli": ["init"], "json": true},
    {"assert": {"json": {"path": "/workspace_created", "equals": "default"}}},
    {"assert": {"json": {"path": "/schema_revision", "equals": "0011"}}},
    {"assert": {"json": {"path": "/default_workspace", "equals": "default"}}},
    {"assert": {"file": "data/workgraph.db", "exists": true}},
    {"assert": {"file": "config/config.toml", "exists": true}},
    {"assert": {"file": "config/api-token", "exists": true}},
    {"cli": ["init"], "json": true},
    {"assert": {"json": {"path": "/workspace_created", "equals": null}}},
    {"assert": {"json": {"path": "/schema_revision", "equals": "0011"}}},
    {"cli": ["workspace", "list"], "json": true},
    {"assert": {"json": {"path": "/0/slug", "equals": "default"}}},
    {"cli": ["init", "--workspace", "team", "--name", "Team Alpha", "--prefix", "TA"], "json": true},
    {"assert": {"json": {"path": "/workspace_created", "equals": "team"}}},
    {"cli": ["workspace", "list"], "json": true},
    {"assert": {"json": {"path": "/1/slug", "equals": "team"}}},
    {"cli": ["init", "--workspace", "quiet", "--no-workspace"], "json": true},
    {"assert": {"json": {"path": "/workspace_created", "equals": null}}},
    {"cli": ["workspace", "list", "--all"], "json": true},
    {"assert": {"json": {"path": "/1/slug", "equals": "team"}}}
  ],
  "not_observable": []
}
