{
  "id": "git-attribution-trailers",
  "covers": ["C092", "C095", "C118", "C152"],
  "setup": [
    {"git": "init", "repo": "attr"},
    {"git": "commit", "repo": "attr", "files": {"a.txt": "a\n"}, "message": "implement thing\n\nTask-ID: WG-1"},
    {"git": "commit", "repo": "attr", "files": {"b.txt": "b\n"}, "message": "touches WG-1 and WG-2"},
    {"git": "commit", "repo": "attr", "files": {"c.txt": "c\n"}, "message": "mentions WG-999 which does not exist"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "One"], "json": true},
    {"cli": ["task", "create", "Two"], "json": true},
    {"cli": ["repo", "register", "{repo:attr}"], "json": true},
    {"cli": ["git", "sync", "attr"], "json": true},
    {"cli": ["git", "log", "attr", "--linked"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 2}}},
    {"assert": {"json": {"path": "/items/1/subject", "equals": "implement thing"}}},
    {"assert": {"json": {"path": "/items/1/tasks/0/task_key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/items/1/tasks/0/source", "equals": "trailer"}}},
    {"assert": {"json": {"path": "/items/0/subject", "equals": "touches WG-1 and WG-2"}}},
    {"assert": {"json": {"path": "/items/0/tasks/0/task_key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/items/0/tasks/0/source", "equals": "message_inference"}}},
    {"assert": {"json": {"path": "/items/0/tasks/0/confidence", "equals": 0.35}}},
    {"assert": {"json": {"path": "/items/0/tasks/1/task_key", "equals": "WG-2"}}},
    {"assert": {"json": {"path": "/items/0/tasks/1/confidence", "equals": 0.35}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_git.py::test_attribution_trailer_inference_and_ambiguity: the ambiguous evidence flag on the links of 'touches WG-1 and WG-2' (evidence.ambiguous is true) is not in the git log output; it is only visible through git show of that commit, which this scenario does not read. Covered by the confidence assertions and by GV-04",
      "covered_by": "GV-04"
    }
  ]
}
