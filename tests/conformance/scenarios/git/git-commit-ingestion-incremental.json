{
  "id": "git-commit-ingestion-incremental",
  "covers": ["C092", "C093", "C095", "C118"],
  "setup": [
    {"git": "init", "repo": "ingest"},
    {"git": "commit", "repo": "ingest", "files": {"README.md": "ingest\n"}, "message": "initial"},
    {"git": "commit", "repo": "ingest", "files": {"src/app.py": "def a():\n    return 1\n", "bin.dat": "x\u0000y"}, "message": "add module"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:ingest}"], "json": true},
    {"cli": ["git", "sync", "ingest"], "json": true},
    {"assert": {"json": {"path": "/0/new_commits", "equals": 2}}},
    {"cli": ["git", "log", "ingest"], "json": true, "save": {"add_sha": "/items/0/sha"}},
    {"assert": {"json": {"path": "/items/0/subject", "equals": "add module"}}},
    {"cli": ["git", "show", "ingest", "{var:add_sha}"], "json": true},
    {"assert": {"json": {"path": "/insertions", "equals": 2}}},
    {"assert": {"json": {"path": "/files/0/path", "equals": "bin.dat"}}},
    {"assert": {"json": {"path": "/files/0/binary", "equals": true}}},
    {"cli": ["git", "sync", "ingest"], "json": true},
    {"assert": {"json": {"path": "/0/new_commits", "equals": 0}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_git.py::test_commit_ingestion_stats_renames_and_incremental: (a) the rename of src/app.py to src/core.py is detected as change type R with old_path, because the runner's setup operations cannot delete or move files (no git mv or rm); (b) a commit made after an earlier sync is picked up by the next sync (new_commits 1), because setup runs before every step and no step creates commits",
      "covered_by": "GV-03"
    }
  ]
}
