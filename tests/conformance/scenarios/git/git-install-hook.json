{
  "id": "git-install-hook",
  "covers": ["C090", "C118"],
  "setup": [
    {"git": "init", "repo": "hooked"},
    {"git": "commit", "repo": "hooked", "files": {"README.md": "hooked\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:hooked}"], "json": true},
    {"cli": ["git", "install-hook", "hooked"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"file": "{repo:hooked}/.git/hooks/post-commit", "exists": true, "contains": "workgraph-managed hook"}},
    {"cli": ["git", "install-hook", "hooked", "-w", "default"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"file": "{repo:hooked}/.git/hooks/post-commit", "exists": true, "contains": "job enqueue git_sync"}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_git.py: install-hook with no available checkout (exit 4) needs the checkout directory deleted, which the runner cannot do",
      "covered_by": "CORE-08"
    }
  ]
}
