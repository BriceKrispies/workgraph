{
  "id": "git-log-limit-link-unlink",
  "covers": ["C091", "C092", "C093", "C095", "C096", "C118"],
  "setup": [
    {"git": "init", "repo": "ledger"},
    {"git": "commit", "repo": "ledger", "files": {"a.txt": "one\n"}, "message": "first"},
    {"git": "commit", "repo": "ledger", "files": {"b.txt": "two\n"}, "message": "second"},
    {"git": "commit", "repo": "ledger", "files": {"c.txt": "three\n"}, "message": "third"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:ledger}"], "json": true},
    {"cli": ["task", "create", "One"], "json": true},
    {"cli": ["git", "sync", "ledger"], "json": true},
    {"cli": ["git", "log", "ledger", "--limit", "2"], "json": true, "save": {"newest": "/items/0/sha"}},
    {"assert": {"json": {"path": "/items/0/subject", "equals": "third"}}},
    {"assert": {"json": {"path": "/items/1/subject", "equals": "second"}}},
    {"assert": {"json": {"path": "/total", "equals": 3}}},
    {"cli": ["git", "log", "ledger", "--linked"], "json": true},
    {"assert": {"json": {"path": "/items", "equals": []}}},
    {"cli": ["git", "link", "WG-1", "{var:newest}", "--repository", "ledger", "--note", "manual evidence"], "json": true},
    {"cli": ["git", "log", "ledger", "--linked"], "json": true},
    {"assert": {"json": {"path": "/items/0/sha", "equals": "{var:newest}"}}},
    {"cli": ["git", "show", "ledger", "{var:newest}"], "json": true},
    {"assert": {"json": {"path": "/subject", "equals": "third"}}},
    {"assert": {"json": {"path": "/tasks/0/task_key", "equals": "WG-1"}}},
    {"cli": ["git", "unlink", "WG-1", "{var:newest}"], "json": true},
    {"assert": {"json": {"path": "/removed", "equals": 1}}},
    {"cli": ["git", "log", "ledger", "--linked"], "json": true},
    {"assert": {"json": {"path": "/items", "equals": []}}}
  ],
  "not_observable": []
}
