{
  "id": "git-merge-commits",
  "covers": ["C092", "C093", "C095", "C118"],
  "setup": [
    {"git": "init", "repo": "merging"},
    {"git": "commit", "repo": "merging", "files": {"base.txt": "base\n"}, "message": "initial"},
    {"git": "checkout", "repo": "merging", "args": ["-b", "feature"]},
    {"git": "commit", "repo": "merging", "files": {"f.txt": "feature\n"}, "message": "feature work"},
    {"git": "checkout", "repo": "merging", "args": ["main"]},
    {"git": "commit", "repo": "merging", "files": {"m.txt": "main\n"}, "message": "main work"},
    {"git": "merge", "repo": "merging", "args": ["feature"]}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:merging}"], "json": true},
    {"cli": ["git", "sync", "merging"], "json": true},
    {"cli": ["git", "log", "merging"], "json": true, "save": {"merge_sha": "/items/0/sha"}},
    {"assert": {"json": {"path": "/items/0/subject", "equals": "Merge branch 'feature'"}}},
    {"assert": {"json": {"path": "/items/0/is_merge", "equals": true}}},
    {"assert": {"json": {"path": "/items/0/files_changed", "equals": 1}}},
    {"cli": ["git", "show", "merging", "{var:merge_sha}"], "json": true, "save": {"first_parent": "/parents/0", "second_parent": "/parents/1"}},
    {"assert": {"json": {"path": "/is_merge", "equals": true}}}
  ],
  "not_observable": []
}
