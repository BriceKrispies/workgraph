{
  "id": "git-rebase-and-cherry-pick-link",
  "covers": ["C091", "C092", "C095", "C118", "C152"],
  "setup": [
    {"git": "init", "repo": "rewrite"},
    {"git": "commit", "repo": "rewrite", "files": {"README.md": "rewrite\n"}, "message": "initial"},
    {"git": "checkout", "repo": "rewrite", "args": ["-b", "topic"]},
    {"git": "commit", "repo": "rewrite", "files": {"t.txt": "topic\n"}, "message": "topic change"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:rewrite}"], "json": true},
    {"cli": ["task", "create", "Rewrite me", "--repo", "rewrite"], "json": true},
    {"cli": ["git", "sync", "rewrite"], "json": true},
    {"cli": ["git", "log", "rewrite"], "json": true, "save": {"original_sha": "/items/0/sha"}},
    {"cli": ["git", "link", "WG-1", "{var:original_sha}"], "json": true},
    {"assert": {"json": {"path": "/0/source", "equals": "explicit"}}},
    {"assert": {"json": {"path": "/0/confidence", "equals": 1.0}}},
    {"git": "checkout", "cwd": "{repo:rewrite}", "args": ["main"]},
    {"git": "commit", "cwd": "{repo:rewrite}", "files": {"m.txt": "m\n"}, "message": "main moves"},
    {"git": "checkout", "cwd": "{repo:rewrite}", "args": ["topic"]},
    {"git": "rebase", "cwd": "{repo:rewrite}", "args": ["main"]},
    {"cli": ["git", "sync", "rewrite", "--full"], "json": true},
    {"assert": {"json": {"path": "/0/marked_unreachable", "equals": 1}}},
    {"cli": ["git", "log", "rewrite", "--linked"], "json": true},
    {"assert": {"stdout_contains": "rewrite_reconciliation"}},
    {"cli": ["git", "log", "rewrite"], "json": true, "save": {"topic_sha": "/items/0/sha"}},
    {"git": "checkout", "cwd": "{repo:rewrite}", "args": ["main"]},
    {"git": "cherry-pick", "cwd": "{repo:rewrite}", "args": ["{var:topic_sha}"]},
    {"cli": ["git", "sync", "rewrite"], "json": true},
    {"assert": {"json": {"path": "/0/new_commits", "equals": 1}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_git.py::test_rebase_reconciliation_and_cherry_pick: the reachability flag of the original commit (not reachable) and the equivalence kind rewrite are asserted on the database rows; no CLI command in this scenario prints them, so only the marked_unreachable count and the carried rewrite_reconciliation link are checked.",
      "covered_by": "CORE-10"
    }
  ]
}
