{
  "id": "git-register-identity",
  "covers": ["C118"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"README.md": "svc\n"}, "message": "initial"},
    {"git": "branch", "repo": "svc", "args": ["second"]},
    {"git": "worktree", "repo": "svc", "args": ["../svc-copy", "second"]}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true, "save": {"repo_id": "/id", "checkout_id": "/checkouts/0/id"}},
    {"assert": {"json": {"path": "/name", "equals": "svc"}}},
    {"assert": {"json": {"path": "/checkouts/0/is_primary", "equals": true}}},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"assert": {"json": {"path": "/id", "equals": "{var:repo_id}"}}},
    {"assert": {"json": {"path": "/checkouts/0/id", "equals": "{var:checkout_id}"}}},
    {"cli": ["repo", "register", "{repo:svc-copy}"], "json": true},
    {"assert": {"json": {"path": "/id", "equals": "{var:repo_id}"}}},
    {"assert": {"json": {"path": "/checkouts/1/path", "equals": "{repo:svc-copy}"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_git.py::test_register_identity_and_relocation: the checkout directory is deleted, then repo refresh reports the repository degraded and the surviving clone is the available checkout. The runner has no setup or step that removes a directory",
      "covered_by": "CORE-08"
    }
  ]
}
