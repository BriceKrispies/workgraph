{
  "id": "git-repo-without-remote-and-removal",
  "covers": ["C116", "C118", "C119"],
  "setup": [
    {"git": "init", "repo": "local-only"},
    {"git": "commit", "repo": "local-only", "files": {"README.md": "local\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:local-only}"], "json": true},
    {"assert": {"json": {"path": "/remotes", "equals": []}}},
    {"cli": ["repo", "remove", "local-only"], "json": true},
    {"assert": {"file": "{repo:local-only}/README.md", "exists": true}},
    {"cli": ["repo", "list"], "json": true},
    {"assert": {"json": {"path": "", "equals": []}}},
    {"cli": ["repo", "list", "--all"], "json": true},
    {"assert": {"json": {"path": "/0/name", "equals": "local-only"}}}
  ],
  "not_observable": []
}
