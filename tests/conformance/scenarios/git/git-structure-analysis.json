{
  "id": "git-structure-analysis",
  "covers": ["C086", "C093", "C095", "C118"],
  "setup": [
    {"git": "init", "repo": "structure"},
    {"git": "commit", "repo": "structure", "files": {"pkg/a.py": "class A:\n    def m(self):\n        return 1\n\ndef top():\n    return 2\n"}, "message": "python"},
    {"git": "commit", "repo": "structure", "files": {"pkg/a.py": "class A:\n    def m(self):\n        return 10\n\ndef top():\n    return 2\n\ndef new():\n    pass\n"}, "message": "change"},
    {"git": "commit", "repo": "structure", "files": {"README.md": "# changed\n"}, "message": "docs"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:structure}"], "json": true},
    {"cli": ["git", "sync", "structure"], "json": true},
    {"cli": ["git", "log", "structure"], "json": true, "save": {"docs_sha": "/items/0/sha", "change_sha": "/items/1/sha"}},
    {"cli": ["git", "analyze", "structure"], "json": true},
    {"assert": {"json": {"path": "/analyzed", "equals": 3}}},
    {"cli": ["git", "show", "structure", "{var:change_sha}"], "json": true},
    {"assert": {"stdout_contains": "\"name\": \"A.m\""}},
    {"assert": {"stdout_contains": "\"change\": \"modified\""}},
    {"assert": {"stdout_contains": "\"name\": \"new\""}},
    {"assert": {"stdout_contains": "\"change\": \"added\""}},
    {"assert": {"json": {"path": "/analysis/functions_affected", "equals": 2}}},
    {"cli": ["git", "show", "structure", "{var:docs_sha}"], "json": true},
    {"assert": {"json": {"path": "/files/0/file_class", "equals": "docs"}}},
    {"assert": {"json": {"path": "/analysis/files_fallback", "equals": 1}}}
  ],
  "not_observable": []
}
