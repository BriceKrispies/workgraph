{
  "id": "git-sync-workspace-and-full",
  "covers": ["C095", "C118"],
  "setup": [
    {"git": "init", "repo": "alpha"},
    {"git": "commit", "repo": "alpha", "files": {"a.txt": "alpha\n"}, "message": "alpha initial"},
    {"git": "init", "repo": "beta"},
    {"git": "commit", "repo": "beta", "files": {"b.txt": "beta\n"}, "message": "beta initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:alpha}"], "json": true},
    {"cli": ["repo", "register", "{repo:beta}"], "json": true},
    {"cli": ["git", "sync"], "json": true},
    {"assert": {"json": {"path": "/0/repository", "equals": "alpha"}}},
    {"assert": {"json": {"path": "/0/mode", "equals": "incremental"}}},
    {"assert": {"json": {"path": "/0/new_commits", "equals": 1}}},
    {"assert": {"json": {"path": "/1/repository", "equals": "beta"}}},
    {"assert": {"json": {"path": "/1/new_commits", "equals": 1}}},
    {"cli": ["git", "sync", "alpha", "--full"], "json": true},
    {"assert": {"json": {"path": "/0/repository", "equals": "alpha"}}},
    {"assert": {"json": {"path": "/0/mode", "equals": "full"}}},
    {"assert": {"json": {"path": "/0/new_commits", "equals": 0}}},
    {"cli": ["git", "sync", "beta", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/0/mode", "equals": "incremental"}}},
    {"assert": {"json": {"path": "/0/new_commits", "equals": 0}}}
  ],
  "not_observable": []
}
