{
  "id": "http-attempts-runs-seeded",
  "covers": ["H071", "H072", "H073", "H074", "H075", "H076", "H077", "H078", "H079", "H088", "H089"],
  "setup": [],
  "steps": [
    {"cli": ["demo", "seed", "--workspace", "default"]},
    {"http": "GET", "path": "/api/v1/ws/{ws}/attempts?limit=5", "save": {"attempt": "/items/0/id", "other": "/items/1/id"}},
    {"http": "GET", "path": "/api/v1/ws/{ws}/attempts?status=failed&limit=1", "save": {"failed": "/items/0/id"}},
    {"http": "GET", "path": "/api/v1/ws/{ws}/attempts?task=DEMO-1&provider=scripted&limit=2&offset=0"},
    {"http": "GET", "path": "/api/v1/attempts/compare?a={var:attempt}&b={var:other}"},
    {"http": "GET", "path": "/api/v1/attempts/compare?a={var:attempt}&b=00000000-0000-4000-8000-000000000000"},
    {"http": "GET", "path": "/api/v1/attempts/{var:attempt}?events=5"},
    {"http": "GET", "path": "/api/v1/attempts/00000000-0000-4000-8000-000000000000"},
    {"http": "GET", "path": "/api/v1/attempts/{var:attempt}/manifests"},
    {"http": "GET", "path": "/api/v1/attempts/{var:attempt}/log?tail=5"},
    {"http": "POST", "path": "/api/v1/ws/{ws}/tasks", "body": {"title": "Runnable task", "status": "ready", "repositories": ["auth-service"]}, "save": {"runnable": "/key"}},
    {"http": "POST", "path": "/api/v1/ws/{ws}/runs", "body": {"task": "{var:runnable}", "agent": "scripted", "instructions": "conformance run"}, "save": {"queued": "/id"}},
    {"http": "POST", "path": "/api/v1/ws/{ws}/runs", "body": {"task": "DEMO-999"}},
    {"http": "POST", "path": "/api/v1/ws/{ws}/runs", "body": {"task": 5}},
    {"http": "POST", "path": "/api/v1/ws/{ws}/runs", "body": {"task": "DEMO-1", "agent": "scripted"}},
    {"http": "POST", "path": "/api/v1/attempts/{var:queued}/cancel", "body": {"reason": "conformance cancel"}},
    {"http": "POST", "path": "/api/v1/attempts/{var:queued}/cancel"},
    {"http": "POST", "path": "/api/v1/attempts/{var:failed}/retry"},
    {"http": "POST", "path": "/api/v1/attempts/{var:attempt}/rerun"},
    {"http": "POST", "path": "/api/v1/attempts/00000000-0000-4000-8000-000000000000/cancel"},
    {"http": "POST", "path": "/api/v1/attempts/00000000-0000-4000-8000-000000000000/retry"},
    {"http": "POST", "path": "/api/v1/attempts/00000000-0000-4000-8000-000000000000/rerun"},
    {"http": "GET", "path": "/api/v1/ws/{ws}/verification/runs?limit=3", "save": {"vrun": "/0/id"}},
    {"http": "GET", "path": "/api/v1/verification/runs/{var:vrun}"},
    {"http": "GET", "path": "/api/v1/verification/runs/00000000-0000-4000-8000-000000000000"},
    {"cli": ["attempt", "show", "{var:queued}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "cancelled"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_runs.py::test_successful_cross_repo_run_with_verification: a run that executes an agent and passes verification needs an enabled fake agent that points at the test interpreter, which a corpus scenario cannot name portably; the 200 path of attempts that ran is covered by the seeded demo runs above",
      "covered_by": "SC-03"
    }
  ]
}
