{
  "id": "http-stacks-integrate-verify",
  "covers": ["H069", "H070"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"base.txt": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["task", "create", "Parent work", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "First change", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"cli": ["stack", "create", "WG-1"], "json": true},
    {"http": "POST", "path": "/api/v1/ws/{ws}/stacks/WG-1/integrate"},
    {"http": "POST", "path": "/api/v1/ws/{ws}/stacks/WG-1/verify"},
    {"http": "POST", "path": "/api/v1/ws/{ws}/stacks/WG-999/integrate"},
    {"http": "POST", "path": "/api/v1/ws/{ws}/stacks/WG-999/verify"},
    {"cli": ["job", "list"], "json": true},
    {"cli": ["stack", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/parent_key", "equals": "WG-1"}}}
  ],
  "not_observable": []
}
