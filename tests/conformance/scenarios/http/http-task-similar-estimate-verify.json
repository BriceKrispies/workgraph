{
  "id": "http-task-similar-estimate-verify",
  "covers": ["H055", "H056", "H057", "H058", "H059", "H060", "H061"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"README.md": "svc\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"http": "POST", "path": "/api/v1/ws/default/tasks", "body": {"title": "Fix token crash", "status": "ready", "repositories": ["svc"]}},
    {"http": "POST", "path": "/api/v1/ws/default/tasks", "body": {"title": "Fix token refresh crash", "status": "ready", "repositories": ["svc"], "depends_on": ["WG-1"]}},
    {"http": "GET", "path": "/api/v1/ws/default/tasks/WG-1/similar?limit=5"},
    {"http": "GET", "path": "/api/v1/ws/default/tasks/WG-1/estimate"},
    {"http": "GET", "path": "/api/v1/ws/default/tasks/WG-1/verification"},
    {"http": "GET", "path": "/api/v1/ws/default/tasks/WG-1/checks"},
    {"http": "POST", "path": "/api/v1/ws/default/tasks/WG-1/verify?tier=fast"},
    {"http": "POST", "path": "/api/v1/ws/default/tasks/WG-1/decompose?create=false"},
    {"http": "GET", "path": "/api/v1/ws/default/tasks/WG-2/schedulability"},
    {"http": "GET", "path": "/api/v1/ws/default/tasks/WG-999/schedulability"},
    {"cli": ["task", "show", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-2"}}}
  ],
  "not_observable": []
}
