{
  "id": "job-compact-dry-run-and-apply",
  "covers": ["C101", "C118"],
  "setup": [
    {"git": "init", "repo": "retention"},
    {"git": "commit", "repo": "retention", "files": {"README.md": "retention\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["job", "compact"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["job", "compact", "--dry-run"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["job", "compact", "--apply"], "json": true},
    {"assert": {"exit": 0}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_jobs.py: retention past the window, where hook payloads and run logs older than the window are removed. Those rows need run history older than the retention window, which the runner cannot backdate",
      "covered_by": "SC-24"
    }
  ]
}
