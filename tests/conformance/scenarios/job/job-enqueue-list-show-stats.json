{
  "id": "job-enqueue-list-show-stats",
  "covers": ["C102", "C103", "C105", "C106", "C118"],
  "setup": [
    {"git": "init", "repo": "jobs"},
    {"git": "commit", "repo": "jobs", "files": {"README.md": "jobs\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["job", "enqueue", "noop", "--payload", "{\"n\": 1}", "--key", "nightly"], "json": true, "save": {"first": "/job_id"}},
    {"assert": {"json": {"path": "/job_id", "equals": "{var:first}"}}},
    {"cli": ["job", "enqueue", "noop", "--key", "nightly"], "json": true},
    {"assert": {"json": {"path": "/job_id", "equals": "{var:first}"}}},
    {"cli": ["job", "enqueue", "noop"], "json": true, "save": {"second": "/job_id"}},
    {"cli": ["job", "list"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 2}}},
    {"assert": {"json": {"path": "/items/0/id", "equals": "{var:second}"}}},
    {"assert": {"json": {"path": "/items/1/id", "equals": "{var:first}"}}},
    {"cli": ["job", "list", "--status", "queued", "-s", "dead", "--kind", "noop", "--limit", "1", "--offset", "1"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 2}}},
    {"assert": {"json": {"path": "/items/0/id", "equals": "{var:first}"}}},
    {"cli": ["job", "show", "{var:first}"], "json": true},
    {"assert": {"json": {"path": "/kind", "equals": "noop"}}},
    {"assert": {"json": {"path": "/status", "equals": "queued"}}},
    {"assert": {"json": {"path": "/payload/n", "equals": 1}}},
    {"assert": {"json": {"path": "/runs", "equals": []}}},
    {"cli": ["job", "stats"], "json": true},
    {"assert": {"json": {"path": "/queued", "equals": 2}}},
    {"cli": ["job", "enqueue", "no_such_kind"], "json": true},
    {"assert": {"exit": 2}}
  ],
  "not_observable": []
}
