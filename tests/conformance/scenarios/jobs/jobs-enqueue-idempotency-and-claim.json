{
  "id": "jobs-enqueue-idempotency-and-claim",
  "covers": ["C102", "C179", "C105", "B03"],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["job", "enqueue", "noop", "--payload", "{\"x\": 1}", "--key", "k1"], "json": true, "save": {"a": "/job_id"}},
    {"cli": ["job", "enqueue", "noop", "--payload", "{\"x\": 2}", "--key", "k1"], "json": true},
    {"assert": {"json": {"path": "/job_id", "equals": "{var:a}"}}},
    {"cli": ["job", "show", "{var:a}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "queued"}}},
    {"cli": ["worker", "run", "--once"], "json": true},
    {"assert": {"stdout_contains": "\"completed\": 1"}},
    {"cli": ["job", "show", "{var:a}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "succeeded"}}},
    {"assert": {"json": {"path": "/attempts", "equals": 1}}}
  ],
  "not_observable": [
    {
      "case": "tests/unit/test_jobs.py::test_enqueue_idempotency_and_claim: the second claim by another worker returning None while the job is held, and the ConflictError from completing an already succeeded job; no step claims a job without running it, and `job` commands have no complete or claim action",
      "covered_by": "CORE-19"
    }
  ]
}
