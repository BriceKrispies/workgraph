{
  "id": "mcp-analytics-subagents-agent-time-bottlenecks",
  "covers": ["M61", "M62", "M63"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"mcp": "analytics_subagents", "args": {"period": "week"}},
    {"assert": {"exit": 0}},
    {"mcp": "analytics_subagents", "args": {"period": "month", "since": "2026-01-01", "until": "2026-12-31", "model": "claude-haiku-5-5"}},
    {"assert": {"exit": 0}},
    {"mcp": "analytics_subagents", "args": {"since": "not-a-date"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "invalid date"}},
    {"mcp": "analytics_subagents", "args": {"period": "day"}},
    {"assert": {"exit": 1}},
    {"mcp": "analytics_agent_time", "args": {"by": "class"}},
    {"assert": {"exit": 0}},
    {"mcp": "analytics_agent_time", "args": {"by": "model", "since": "2026-01-01", "until": "2026-12-31"}},
    {"assert": {"exit": 0}},
    {"mcp": "analytics_agent_time", "args": {"until": "yesterday"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "invalid date"}},
    {"mcp": "analytics_agent_time", "args": {"by": "color"}},
    {"assert": {"exit": 1}},
    {"mcp": "analytics_bottlenecks", "args": {"top": 5}},
    {"assert": {"exit": 0}},
    {"mcp": "analytics_bottlenecks", "args": {"since": "2026-01-01"}},
    {"assert": {"exit": 0}},
    {"mcp": "analytics_bottlenecks", "args": {"since": "not-a-date"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "invalid date"}},
    {"mcp": "analytics_bottlenecks", "args": {"top": 0}},
    {"assert": {"exit": 1}}
  ],
  "not_observable": []
}
