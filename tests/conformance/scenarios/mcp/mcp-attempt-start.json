{
  "id": "mcp-attempt-start",
  "covers": ["M48", "M26"],
  "setup": [
    {"git": "init", "repo": "app"},
    {"git": "commit", "repo": "app", "files": {"README.md": "app\n"}, "message": "Initial app"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:app}"], "json": true},
    {"mcp": "task_create", "args": {"title": "Feature", "ready": true, "repositories": ["app"]}},
    {"mcp": "attempt_start", "args": {"task": "WG-1", "model": "test-model", "isolation": "in_place"}},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/task_key", "equals": "WG-1"}}},
    {"mcp": "task_create", "args": {"title": "Not ready", "repositories": ["app"]}},
    {"mcp": "attempt_start", "args": {"task": "WG-2", "isolation": "in_place"}},
    {"assert": {"exit": 1}},
    {"mcp": "attempt_start", "args": {"task": "WG-1", "isolation": "sideways"}},
    {"assert": {"exit": 1}},
    {"mcp": "attempt_start", "args": {"task": "WG-404"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}}
  ],
  "not_observable": []
}
