{
  "id": "mcp-classification-get-request",
  "covers": ["M57", "M58"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"mcp": "task_create", "args": {"title": "Classify me", "ready": true}},
    {"mcp": "classification_get", "args": {"task": "WG-1"}},
    {"assert": {"exit": 0}},
    {"mcp": "classification_request", "args": {"task": "WG-1"}},
    {"assert": {"exit": 0}},
    {"mcp": "classification_get", "args": {"task": "WG-404"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}},
    {"mcp": "classification_request", "args": {"task": "WG-404"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}}
  ],
  "not_observable": []
}
