{
  "id": "mcp-experiments",
  "covers": ["M17", "M18", "M19", "M20", "M21", "M22", "M23", "M24", "M25"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"pyproject.toml": "[project]\nname = \"demo\"\nversion = \"0.1.0\"\n", "pkg/__init__.py": "", "pkg/mod.py": "def f():\n    return 1\n", "tests/test_mod.py": "from pkg.mod import f\n\n\ndef test_f():\n    assert f() == 1\n"}, "message": "base"},
    {"git": "commit", "repo": "svc", "files": {"pkg/mod.py": "def f():\n    return 1\n\n\ndef g():\n    return 2\n", "tests/test_g.py": "from pkg.mod import g\n\n\ndef test_g():\n    assert g() == 2\n"}, "message": "add g"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["experiment", "create", "mcp-exp", "--title", "MCP experiment", "--protocol", "{\"arms\":[{\"name\":\"haiku\",\"model\":\"claude-haiku-5-5\"}],\"brief_template\":\"replay-v1\",\"primary_size\":\"src_lines\",\"bands\":{\"min\":1,\"max\":5},\"staircase\":{\"per_visit\":2,\"up\":1,\"down\":2,\"max_reversals\":6,\"max_trials\":24},\"budget\":{\"trials\":40},\"oracle_template\":[\"git\",\"--no-such-option-wg\"]}"], "json": true},
    {"cli": ["experiment", "freeze", "mcp-exp"], "json": true},
    {"cli": ["experiment", "replay", "scan", "--repo", "svc"], "json": true, "save": {"sha": "/0/sha"}},
    {"cli": ["experiment", "replay", "create", "{var:sha}", "--repo", "svc", "--oracle-template", "[\"git\",\"--no-such-option-wg\"]"], "json": true},
    {"cli": ["experiment", "trial", "add", "mcp-exp", "WG-1", "--arm", "haiku", "--phase", "staircase"], "json": true, "save": {"trial_id": "/id"}},
    {"mcp": "experiment_list", "args": {}},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "mcp-exp"}},
    {"mcp": "experiment_list", "args": {"status": "closed"}},
    {"assert": {"exit": 0}},
    {"mcp": "experiment_get", "args": {"experiment": "mcp-exp"}},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/experiment/status", "equals": "running"}}},
    {"mcp": "experiment_get", "args": {"experiment": "no-such-experiment"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}},
    {"mcp": "experiment_next", "args": {"experiment": "mcp-exp"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "permission_denied"}},
    {"mcp": "experiment_next", "args": {"experiment": "mcp-exp"}, "grants": ["experiment:write"]},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "pending"}},
    {"mcp": "trial_start", "args": {"trial": "{var:trial_id}"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "permission_denied"}},
    {"mcp": "trial_start", "args": {"trial": "{var:trial_id}"}, "grants": ["experiment:write"]},
    {"assert": {"exit": 0}},
    {"mcp": "trial_grade", "args": {"trial": "{var:trial_id}", "timeout": 60}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "permission_denied"}},
    {"mcp": "trial_grade", "args": {"trial": "{var:trial_id}", "timeout": 60}, "grants": ["experiment:write"]},
    {"assert": {"exit": 0}},
    {"mcp": "trial_classify", "args": {"trial": "{var:trial_id}", "cause": "too_big", "source": "agent"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "permission_denied"}},
    {"mcp": "trial_classify", "args": {"trial": "{var:trial_id}", "cause": "sometimes", "source": "agent"}, "grants": ["experiment:write"]},
    {"assert": {"exit": 1}},
    {"mcp": "trial_classify", "args": {"trial": "{var:trial_id}", "cause": "too_big", "source": "agent", "notes": "whole feature"}, "grants": ["experiment:write"]},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/failure_cause", "equals": "too_big"}}},
    {"mcp": "experiment_report", "args": {"experiment": "mcp-exp"}},
    {"assert": {"exit": 0}},
    {"mcp": "experiment_report", "args": {"experiment": "no-such-experiment"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}},
    {"mcp": "experiment_fit", "args": {"model": "claude-haiku-5-5", "repo_penalty": 1.0, "feature_penalty": 0.01, "samples": 20, "seed": 0}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "permission_denied"}},
    {"mcp": "experiment_predict", "args": {"model": "claude-haiku-5-5", "task": "WG-1"}},
    {"assert": {"exit": 1}},
    {"mcp": "experiment_fit", "args": {"model": "claude-haiku-5-5", "repo_penalty": 1.0, "feature_penalty": 0.01, "samples": 20, "seed": 0}, "grants": ["experiment:write"]},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "validation_failed"}},
    {"mcp": "experiment_predict", "args": {"model": "claude-haiku-5-5", "repository": "svc", "src_lines": 10, "src_files": 1, "packages": ["pkg"]}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}}
  ],
  "not_observable": []
}
