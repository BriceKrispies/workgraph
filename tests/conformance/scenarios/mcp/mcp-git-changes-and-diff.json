{
  "id": "mcp-git-changes-and-diff",
  "covers": ["M55", "M56"],
  "setup": [
    {"git": "init", "repo": "ledger"},
    {"git": "commit", "repo": "ledger", "files": {"a.txt": "one\n"}, "message": "Seed the ledger"},
    {"git": "commit", "repo": "ledger", "files": {"b.txt": "two\n"}, "message": "Add b\n\nTask-ID: WG-1"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:ledger}"], "json": true},
    {"cli": ["task", "create", "Ledger work"], "json": true},
    {"cli": ["git", "sync", "ledger"], "json": true},
    {"mcp": "git_get_changes", "args": {"task": "WG-1", "min_confidence": 0.5}},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "Add b"}},
    {"mcp": "git_get_changes", "args": {"task": "WG-1", "min_confidence": 1.5}},
    {"assert": {"exit": 1}},
    {"mcp": "git_get_changes", "args": {"task": "WG-404"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}},
    {"mcp": "git_get_task_diff", "args": {"task": "WG-1", "repository": "ledger", "max_bytes": 200000}},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "b.txt"}},
    {"mcp": "git_get_task_diff", "args": {"task": "WG-1", "max_bytes": 10}},
    {"assert": {"exit": 1}},
    {"mcp": "git_get_task_diff", "args": {"task": "WG-404"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}}
  ],
  "not_observable": []
}
