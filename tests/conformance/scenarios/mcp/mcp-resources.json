{
  "id": "mcp-resources",
  "covers": [],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["project", "create", "core"], "json": true},
    {"cli": ["task", "create", "Read me", "--ready", "--project", "core"], "json": true},
    {"mcp_resource": "workgraph://workspaces"},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "default"}},
    {"mcp_resource": "workgraph://analytics/catalog"},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "cumulative_churn"}},
    {"mcp_resource": "workgraph://workspaces/default/summary"},
    {"assert": {"exit": 0}},
    {"mcp_resource": "workgraph://workspaces/default/projects/core"},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "core"}},
    {"mcp_resource": "workgraph://workspaces/default/tasks/WG-1"},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "Read me"}},
    {"mcp_resource": "workgraph://workspaces/default/tasks/WG-1/history"},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "task.created"}},
    {"mcp_resource": "workgraph://workspaces/default/analytics/cumulative_churn"},
    {"assert": {"exit": 0}},
    {"mcp_resource": "workgraph://workspaces/default/tasks/WG-999"},
    {"assert": {"exit": 1}},
    {"mcp_resource": "workgraph://workspaces/default/projects/no-such-project"},
    {"assert": {"exit": 1}},
    {"mcp_resource": "workgraph://workspaces/default/analytics/no-such-metric"},
    {"assert": {"exit": 1}}
  ],
  "not_observable": []
}
