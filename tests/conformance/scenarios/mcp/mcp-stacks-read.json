{
  "id": "mcp-stacks-read",
  "covers": ["M09", "M10", "M11"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"base.txt": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["task", "create", "Parent work", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "First change", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"mcp": "stack_get", "args": {"parent": "WG-1"}},
    {"assert": {"exit": 1}},
    {"mcp": "stack_history", "args": {"parent": "WG-1"}},
    {"assert": {"exit": 1}},
    {"mcp": "stack_list", "args": {}},
    {"assert": {"exit": 0}},
    {"cli": ["stack", "create", "WG-1"], "json": true},
    {"assert": {"exit": 0}},
    {"mcp": "stack_get", "args": {"parent": "WG-1"}},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/parent_key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/items/0/task_key", "equals": "WG-2"}}},
    {"assert": {"json": {"path": "/items/0/state", "equals": "pending"}}},
    {"mcp": "stack_list", "args": {}},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "WG-1"}},
    {"mcp": "stack_list", "args": {"include_inactive": true}},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "WG-1"}},
    {"mcp": "stack_history", "args": {"parent": "WG-1"}},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "stack.created"}},
    {"mcp": "stack_get", "args": {"parent": "WG-99"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}}
  ],
  "not_observable": []
}
