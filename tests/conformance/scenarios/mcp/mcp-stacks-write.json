{
  "id": "mcp-stacks-write",
  "covers": ["M12", "M13", "M14", "M15", "M16"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"base.txt": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["task", "create", "Parent work", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "First change", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"mcp": "stack_create", "args": {"parent": "WG-1"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "permission_denied"}},
    {"mcp": "stack_create", "args": {"parent": "WG-1"}, "grants": ["stack:write"]},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/parent_key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/items/0/task_key", "equals": "WG-2"}}},
    {"cli": ["task", "create", "Late", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"mcp": "stack_add_item", "args": {"parent": "WG-1", "task": "WG-3"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "permission_denied"}},
    {"mcp": "stack_add_item", "args": {"parent": "WG-1", "task": "WG-3"}, "grants": ["stack:write"]},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/items/1/task_key", "equals": "WG-3"}}},
    {"mcp": "stack_add_item", "args": {"parent": "WG-99", "task": "WG-3"}, "grants": ["stack:write"]},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}},
    {"mcp": "stack_remove_item", "args": {"parent": "WG-1", "task": "WG-3"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "permission_denied"}},
    {"mcp": "stack_remove_item", "args": {"parent": "WG-1", "task": "WG-3"}, "grants": ["stack:write"]},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/items/0/task_key", "equals": "WG-2"}}},
    {"mcp": "stack_integrate", "args": {"parent": "WG-1"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "permission_denied"}},
    {"mcp": "stack_integrate", "args": {"parent": "WG-1"}, "grants": ["stack:write"]},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/jobs/0/repository", "equals": "svc"}}},
    {"mcp": "stack_integrate", "args": {"parent": "WG-99"}, "grants": ["stack:write"]},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}},
    {"mcp": "stack_verify", "args": {"parent": "WG-1"}},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "permission_denied"}},
    {"mcp": "stack_verify", "args": {"parent": "WG-1"}, "grants": ["stack:write"]},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/stack", "equals": "WG-1"}}},
    {"mcp": "stack_verify", "args": {"parent": "WG-99"}, "grants": ["stack:write"]},
    {"assert": {"exit": 1}},
    {"assert": {"stderr_contains": "not_found"}}
  ],
  "not_observable": []
}
