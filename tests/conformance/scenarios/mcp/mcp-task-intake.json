{
  "id": "mcp-task-intake",
  "covers": [],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "tasks.intake_proposed", "true"], "json": true},
    {"mcp": "task_create", "args": {"title": "Parser panics on empty input", "description": "Seen in review", "acceptance_criteria": ["no panic"], "ready": true}},
    {"assert": {"json": {"path": "/status", "equals": "proposed"}}},
    {"mcp": "task_create", "args": {"title": "Cache invalidation", "acceptance_criteria": ["covered"]}},
    {"assert": {"json": {"path": "/status", "equals": "proposed"}}},
    {"mcp": "task_create", "args": {"title": "Render the skeleton", "acceptance_criteria": ["rendered"]}},
    {"mcp": "task_create", "args": {"title": "Wire the settings page", "acceptance_criteria": ["wired"]}},
    {"mcp": "task_get_ready", "args": {}},
    {"assert": {"json": {"path": "/tasks", "equals": []}}},
    {"cli": ["task", "promote-ready", "--all", "--dry-run"], "json": true},
    {"assert": {"json": {"path": "/promoted", "equals": []}}},
    {"cli": ["task", "list", "--status", "proposed"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 4}}},
    {"cli": ["task", "list", "--status", "backlog"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 0}}},
    {"cli": ["task", "intake", "list"], "json": true},
    {"assert": {"json": {"path": "/count", "equals": 4}}},
    {"cli": ["task", "intake", "admit", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/done", "equals": 1}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "backlog"}}},
    {"cli": ["task", "intake", "admit", "WG-2", "--ready"], "json": true},
    {"cli": ["task", "show", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"cli": ["task", "intake", "admit", "WG-1"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/failed", "equals": 1}}},
    {"cli": ["task", "intake", "merge", "WG-3", "--into", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/done", "equals": 1}}},
    {"cli": ["task", "show", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "cancelled"}}},
    {"cli": ["task", "show", "WG-2"], "json": true},
    {"assert": {"stdout_contains": "Render the skeleton"}},
    {"cli": ["task", "intake", "drop", "WG-4", "--reason", "out of scope"], "json": true},
    {"cli": ["task", "show", "WG-4"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "cancelled"}}},
    {"cli": ["task", "intake", "list"], "json": true},
    {"assert": {"json": {"path": "/count", "equals": 0}}},
    {"mcp": "task_intake", "args": {"action": "list"}},
    {"assert": {"json": {"path": "/count", "equals": 0}}},
    {"cli": ["config", "set", "tasks.intake_proposed", "false"], "json": true},
    {"mcp": "task_create", "args": {"title": "Another unrelated item", "acceptance_criteria": ["x"]}},
    {"assert": {"json": {"path": "/status", "equals": "backlog"}}},
    {"mcp": "task_create", "args": {"title": "Ready on arrival entry", "acceptance_criteria": ["y"], "ready": true}},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}}
  ],
  "not_observable": []
}
