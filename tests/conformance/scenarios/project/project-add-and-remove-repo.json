{
  "id": "project-add-and-remove-repo",
  "covers": ["C108", "C109", "C111", "C118", "C181"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"README.md": "svc\n"}, "message": "initial"},
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "api\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["workspace", "create", "acme"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true, "save": {"svc_id": "/id"}},
    {"cli": ["repo", "register", "{repo:api}", "--workspace", "default"], "json": true, "save": {"api_id": "/id"}},
    {"cli": ["project", "create", "core", "--repo", "svc"], "json": true},
    {"assert": {"json": {"path": "/repository_ids/0", "equals": "{var:svc_id}"}}},
    {"cli": ["project", "add-repo", "core", "api", "--role", "maintainer", "--workspace", "default"], "json": true},
    {"cli": ["project", "show", "core", "--workspace", "default"], "json": true},
    {"assert": {"json": {"path": "/repositories/0/id", "equals": "{var:api_id}"}}},
    {"assert": {"json": {"path": "/repositories/1/id", "equals": "{var:svc_id}"}}},
    {"cli": ["project", "remove-repo", "core", "api", "--workspace", "default"], "json": true},
    {"assert": {"json": {"path": "/repository_ids/0", "equals": "{var:svc_id}"}}},
    {"cli": ["project", "create", "side", "-w", "acme"], "json": true},
    {"assert": {"json": {"path": "/slug", "equals": "side"}}},
    {"assert": {"json": {"path": "/repository_ids", "equals": []}}}
  ],
  "not_observable": []
}
