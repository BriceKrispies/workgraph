{
  "id": "project-create-show-update",
  "covers": ["C109", "C110", "C113", "C114", "C118"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"README.md": "svc\n"}, "message": "initial"},
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "api\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true, "save": {"api_id": "/id"}},
    {"cli": ["project", "create", "core", "--name", "Core Platform", "--description", "Shared core", "--repo", "svc", "-r", "api"], "json": true},
    {"assert": {"json": {"path": "/slug", "equals": "core"}}},
    {"assert": {"json": {"path": "/name", "equals": "Core Platform"}}},
    {"assert": {"json": {"path": "/description", "equals": "Shared core"}}},
    {"assert": {"json": {"path": "/status", "equals": "active"}}},
    {"cli": ["project", "list"], "json": true},
    {"assert": {"json": {"path": "/0/slug", "equals": "core"}}},
    {"cli": ["project", "list", "--all", "--workspace", "default"], "json": true},
    {"assert": {"json": {"path": "/0/slug", "equals": "core"}}},
    {"cli": ["project", "show", "core", "--workspace", "default"], "json": true},
    {"assert": {"json": {"path": "/project/slug", "equals": "core"}}},
    {"assert": {"json": {"path": "/project/name", "equals": "Core Platform"}}},
    {"cli": ["project", "update", "core", "--name", "Core", "--description", "Renamed"], "json": true},
    {"assert": {"json": {"path": "/name", "equals": "Core"}}},
    {"assert": {"json": {"path": "/description", "equals": "Renamed"}}},
    {"cli": ["project", "update", "core", "--status", "archived"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "archived"}}},
    {"cli": ["project", "list", "--all"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "archived"}}},
    {"cli": ["project", "update", "core", "--status", "active"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "active"}}}
  ],
  "not_observable": []
}
