{
  "id": "project-rename-term",
  "covers": ["C109", "C112"],
  "setup": [],
  "steps": [
    {"cli": ["init", "--workspace", "acme", "--prefix", "AC"], "json": true},
    {"cli": ["project", "create", "rho", "--name", "Rho"], "json": true},
    {"cli": ["task", "create", "Port the Rho lexer and the Rhombus driver", "--project", "rho", "--tag", "rho"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "AC-1"}}},
    {"cli": ["project", "rename-term", "rho", "--from", "Rho", "--to", "Nyn", "--keep", "Rhombus", "--dry-run", "--workspace", "acme"], "json": true},
    {"assert": {"json": {"path": "/dry_run", "equals": true}}},
    {"assert": {"json": {"path": "/tasks/0/key", "equals": "AC-1"}}},
    {"cli": ["task", "show", "AC-1"], "json": true},
    {"assert": {"json": {"path": "/title", "equals": "Port the Rho lexer and the Rhombus driver"}}},
    {"cli": ["project", "rename-term", "rho", "--from", "Rho", "--to", "Nyn", "--keep", "Rhombus", "--workspace", "acme"], "json": true},
    {"assert": {"json": {"path": "/dry_run", "equals": false}}},
    {"cli": ["task", "show", "AC-1"], "json": true},
    {"assert": {"json": {"path": "/title", "equals": "Port the Nyn lexer and the Rhombus driver"}}},
    {"assert": {"json": {"path": "/tags", "equals": ["nyn"]}}}
  ],
  "not_observable": []
}
