{
  "id": "providers-claude-adapter-unavailable",
  "covers": ["C002", "C060"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "agents.claude_code.executable", "claude-not-installed-anywhere"], "json": true},
    {"cli": ["config", "show"], "json": true},
    {"assert": {"json": {"path": "/config/agents/claude_code/executable", "equals": "claude-not-installed-anywhere"}}},
    {"cli": ["agent", "list"], "json": true},
    {"assert": {"json": {"path": "/0/name", "equals": "claude_code"}}},
    {"assert": {"json": {"path": "/0/available", "equals": false}}},
    {"assert": {"stdout_contains": "install Claude Code"}}
  ],
  "not_observable": []
}
