{
  "id": "repo-refresh-and-status",
  "covers": ["C117", "C118", "C121", "C122"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"README.md": "svc\n"}, "message": "initial"},
    {"git": "write", "repo": "svc", "files": {"notes.txt": "draft\n"}}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true, "save": {"repo_id": "/id"}},
    {"cli": ["repo", "refresh", "svc"], "json": true},
    {"assert": {"json": {"path": "/id", "equals": "{var:repo_id}"}}},
    {"assert": {"json": {"path": "/health_status", "equals": "ok"}}},
    {"assert": {"json": {"path": "/checkouts/0/available", "equals": true}}},
    {"cli": ["repo", "show", "svc"], "json": true},
    {"assert": {"json": {"path": "/health_status", "equals": "ok"}}},
    {"cli": ["repo", "status", "svc"], "json": true},
    {"assert": {"json": {"path": "/branch", "equals": "main"}}},
    {"assert": {"json": {"path": "/available", "equals": true}}},
    {"assert": {"json": {"path": "/staged", "equals": []}}},
    {"assert": {"json": {"path": "/unstaged", "equals": []}}},
    {"assert": {"json": {"path": "/untracked", "equals": ["notes.txt"]}}}
  ],
  "not_observable": []
}
