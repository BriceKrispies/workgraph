{
  "id": "runs-agent-failure-crash-and-read-only-violation",
  "covers": ["C001", "C020", "C022", "C060", "C118", "C131", "C156", "C165", "C152"],
  "setup": [
    {"git": "init", "repo": "one"},
    {"git": "commit", "repo": "one", "files": {"README.md": "one\n"}, "message": "initial"},
    {"git": "init", "repo": "readonly"},
    {"git": "commit", "repo": "readonly", "files": {"README.md": "readonly\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["config", "set", "execution.default_agent", "\"fake\""], "json": true},
    {"cli": ["agent", "add-command", "fake", "workgraph-demo-agent", "--arg", "--mode", "--arg", "fail", "--arg", "{manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:one}"], "json": true},
    {"cli": ["task", "create", "Implement login", "-r", "one", "--ready"], "json": true},
    {"cli": ["run", "start", "WG-1"], "json": true, "save": {"first": "/id"}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["attempt", "show", "{var:first}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "failed"}}},
    {"assert": {"stdout_contains": "simulated failure"}},
    {"cli": ["agent", "add-command", "fake", "workgraph-demo-agent", "--arg", "--mode", "--arg", "crash", "--arg", "{manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["run", "start", "WG-1"], "json": true, "save": {"second": "/id"}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["attempt", "show", "{var:second}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "failed"}}},
    {"assert": {"json": {"path": "/exit_code", "equals": 3}}},
    {"assert": {"stdout_contains": "boom"}},
    {"cli": ["agent", "add-command", "fake", "workgraph-demo-agent", "--arg", "--mode", "--arg", "touch-ro", "--arg", "{manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:readonly}", "--read-only"], "json": true},
    {"cli": ["task", "link-repo", "WG-1", "readonly"], "json": true},
    {"cli": ["run", "start", "WG-1"], "json": true, "save": {"third": "/id"}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["attempt", "show", "{var:third}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "failed"}}},
    {"assert": {"stdout_contains": "read-only"}}
  ],
  "not_observable": []
}
