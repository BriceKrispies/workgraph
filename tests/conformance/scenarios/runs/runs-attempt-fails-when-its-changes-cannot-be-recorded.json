{
  "id": "runs-attempt-fails-when-its-changes-cannot-be-recorded",
  "covers": ["C001", "C118", "C131", "C152", "C165"],
  "setup": [
    {"git": "init", "repo": "capture"},
    {"git": "commit", "repo": "capture", "files": {"README.md": "capture\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["config", "set", "execution.default_agent", "\"fake\""], "json": true},
    {"cli": ["agent", "add-command", "fake", "python", "--arg", "C:/dev/workgraph/.claude/worktrees/agent-adbe51c0d630f1176/src/workgraph/demo/scripted_agent.py", "--arg", "--mode", "--arg", "success", "--arg", "{manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:capture}"], "json": true},
    {"cli": ["task", "create", "Implement login", "-r", "capture", "--ready"], "json": true},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_runs.py::test_attempt_fails_when_its_changes_cannot_be_recorded: the capture failure is injected by monkeypatching app.worktrees.capture_outcome to raise GitError; no CLI command or repository state makes outcome capture fail, so the failed attempt with exit_reason outcome_capture_failed and its message are not reachable through an interface (the steps above only set up the task)",
      "covered_by": "CORE-12"
    }
  ]
}
