{
  "id": "runs-cancel-queued-attempt",
  "covers": ["C001", "C022", "C125", "C131", "C152", "C165"],
  "setup": [
    {"git": "init", "repo": "queued"},
    {"git": "commit", "repo": "queued", "files": {"README.md": "queued\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["config", "set", "execution.default_agent", "\"fake\""], "json": true},
    {"cli": ["agent", "add-command", "fake", "python", "--arg", "C:/dev/workgraph/.claude/worktrees/agent-adbe51c0d630f1176/src/workgraph/demo/scripted_agent.py", "--arg", "--mode", "--arg", "success", "--arg", "{manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:queued}"], "json": true},
    {"cli": ["task", "create", "Implement login", "-r", "queued", "--ready"], "json": true},
    {"cli": ["run", "start", "WG-1"], "json": true, "save": {"attempt": "/id"}},
    {"cli": ["run", "cancel", "{var:attempt}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "cancelled"}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}}
  ],
  "not_observable": []
}
