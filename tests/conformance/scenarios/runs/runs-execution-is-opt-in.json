{
  "id": "runs-execution-is-opt-in",
  "covers": ["C118", "C131", "C152"],
  "setup": [
    {"git": "init", "repo": "solo"},
    {"git": "commit", "repo": "solo", "files": {"README.md": "solo\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:solo}"], "json": true},
    {"cli": ["task", "create", "Implement login", "-r", "solo", "--ready"], "json": true},
    {"cli": ["run", "start", "WG-1"], "json": true, "expect_exit": 5},
    {"assert": {"stdout_contains": "permission_denied"}}
  ],
  "not_observable": []
}
