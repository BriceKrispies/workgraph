{
  "id": "runs-failed-verification-then-retry",
  "covers": ["C001", "C020", "C022", "C060", "C118", "C129", "C131", "C145", "C152", "C165", "C172", "C174"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"README.md": "svc\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "verification.auto_accept", "false"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["config", "set", "execution.default_agent", "\"fake\""], "json": true},
    {"cli": ["agent", "add-command", "fake", "python", "--arg", "C:/dev/workgraph/.claude/worktrees/agent-adbe51c0d630f1176/src/workgraph/demo/scripted_agent.py", "--arg", "--mode", "--arg", "success", "--arg", "{manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["task", "create", "Implement login", "-r", "svc", "--ready"], "json": true},
    {"cli": ["verify", "config", "ci", "--scope-type", "repository", "--scope", "svc", "--check", "{\"name\": \"unit tests\", \"kind\": \"test\", \"command\": [\"python\", \"-c\", \"print('FAILED tests/test_api.py::test_login - AssertionError'); raise SystemExit(1)\"]}", "--check", "{\"name\": \"lint\", \"kind\": \"test\", \"command\": [\"python\", \"-c\", \"print('1 passed')\"], \"required\": false}"], "json": true},
    {"cli": ["run", "start", "WG-1"], "json": true, "save": {"first": "/id"}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["attempt", "show", "{var:first}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "failed"}}},
    {"assert": {"json": {"path": "/exit_reason", "equals": "verification_failed"}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "failed"}}},
    {"cli": ["verify", "failures"], "json": true},
    {"assert": {"json": {"path": "/0/failure_signatures", "equals": ["test:tests/test_api.py::test_login"]}}},
    {"cli": ["task", "accept", "WG-1"], "json": true, "expect_exit": 3},
    {"assert": {"stdout_contains": "failed required checks"}},
    {"cli": ["verify", "config", "ci", "--scope-type", "repository", "--scope", "svc", "--check", "{\"name\": \"unit tests\", \"kind\": \"test\", \"command\": [\"python\", \"-c\", \"print('1 passed')\"]}"], "json": true},
    {"cli": ["run", "retry", "{var:first}"], "json": true, "save": {"second": "/id"}},
    {"assert": {"json": {"path": "/retry_of_attempt_id", "equals": "{var:first}"}}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["attempt", "show", "{var:second}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "succeeded"}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "awaiting_review"}}},
    {"cli": ["attempt", "list", "--task", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 2}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_runs.py::test_failed_verification_then_retry: the check that the verification configuration is at version 1 before the update is an in-process attribute read and is not asserted here; the update itself is exercised by the second verify config step",
      "covered_by": "CORE-12"
    }
  ]
}
