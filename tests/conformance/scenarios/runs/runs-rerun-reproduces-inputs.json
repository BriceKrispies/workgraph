{
  "id": "runs-rerun-reproduces-inputs",
  "covers": ["C001", "C017", "C022", "C118", "C128", "C131", "C152", "C161", "C165"],
  "setup": [
    {"git": "init", "repo": "rr"},
    {"git": "commit", "repo": "rr", "files": {"README.md": "rr\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["config", "set", "execution.default_agent", "\"fake\""], "json": true},
    {"cli": ["agent", "add-command", "fake", "python", "--arg", "C:/dev/workgraph/.claude/worktrees/agent-adbe51c0d630f1176/src/workgraph/demo/scripted_agent.py", "--arg", "--mode", "--arg", "success", "--arg", "{manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:rr}"], "json": true},
    {"cli": ["task", "create", "Implement login", "-r", "rr", "--ready"], "json": true},
    {"cli": ["run", "start", "WG-1"], "json": true, "save": {"first": "/id"}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["task", "reject", "WG-1", "--reason", "want another try"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["run", "rerun", "{var:first}"], "json": true, "save": {"second": "/attempt/id"}},
    {"assert": {"json": {"path": "/reproduced_baseline", "equals": true}}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["attempt", "show", "{var:second}"], "json": true},
    {"assert": {"json": {"path": "/rerun_of_attempt_id", "equals": "{var:first}"}}},
    {"cli": ["attempt", "compare", "{var:first}", "{var:second}"], "json": true},
    {"assert": {"json": {"path": "/same_task", "equals": true}}},
    {"assert": {"json": {"path": "/fields/provider/same", "equals": true}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_runs.py::test_rerun_reproduces_inputs: the equality of the first and second baseline manifest shas (manifests a and b compared pointwise) is a comparison across two output paths that json equality cannot express; the compare output is recorded in full in the golden, so the normalised sha numbering is still diffed",
      "covered_by": "CR-02"
    }
  ]
}
