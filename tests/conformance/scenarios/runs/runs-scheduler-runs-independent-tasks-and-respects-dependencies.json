{
  "id": "runs-scheduler-runs-independent-tasks-and-respects-dependencies",
  "covers": ["C001", "C060", "C118", "C130", "C131", "C152", "C165"],
  "setup": [
    {"git": "init", "repo": "r1"},
    {"git": "commit", "repo": "r1", "files": {"README.md": "r1\n"}, "message": "initial"},
    {"git": "init", "repo": "r2"},
    {"git": "commit", "repo": "r2", "files": {"README.md": "r2\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "execution.auto_schedule", "true"], "json": true},
    {"cli": ["config", "set", "execution.max_concurrent_runs", "2"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["config", "set", "execution.default_agent", "\"fake\""], "json": true},
    {"cli": ["agent", "add-command", "fake", "python", "--arg", "C:/dev/workgraph/.claude/worktrees/agent-adbe51c0d630f1176/src/workgraph/demo/scripted_agent.py", "--arg", "--mode", "--arg", "success", "--arg", "{manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:r1}"], "json": true},
    {"cli": ["repo", "register", "{repo:r2}"], "json": true},
    {"cli": ["task", "create", "A", "-r", "r1", "--ready", "--auto-execute"], "json": true},
    {"cli": ["task", "create", "B", "-r", "r2", "--ready", "--auto-execute"], "json": true},
    {"cli": ["task", "create", "C", "-r", "r1", "--ready", "--auto-execute", "--depends-on", "WG-1"], "json": true},
    {"cli": ["run", "schedule", "--dry-run"], "json": true},
    {"assert": {"json": {"path": "/0/key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/1/key", "equals": "WG-2"}}},
    {"cli": ["run", "schedule", "--explain", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/reasons", "equals": ["status is blocked", "dependencies unsatisfied"]}}},
    {"cli": ["run", "schedule"], "json": true},
    {"drain": {"max_jobs": 20}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "awaiting_review"}}},
    {"cli": ["task", "show", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "awaiting_review"}}},
    {"cli": ["task", "show", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "blocked"}}}
  ],
  "not_observable": []
}
