{
  "id": "runs-successful-cross-repo-run-with-verification",
  "covers": ["C001", "C022", "C060", "C087", "C118", "C131", "C145", "C152", "C155", "C165", "C172", "C176"],
  "setup": [
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "api\n"}, "message": "initial"},
    {"git": "init", "repo": "sdk"},
    {"git": "commit", "repo": "sdk", "files": {"README.md": "sdk\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "verification.auto_accept", "false"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["config", "set", "execution.default_agent", "\"fake\""], "json": true},
    {"cli": ["agent", "add-command", "fake", "workgraph-demo-agent", "--arg", "--mode", "--arg", "success", "--arg", "{manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true},
    {"cli": ["repo", "register", "{repo:sdk}"], "json": true},
    {"cli": ["task", "create", "Implement login", "-r", "api", "-r", "sdk", "--ready"], "json": true},
    {"cli": ["verify", "config", "checks", "--scope-type", "task", "--scope", "WG-1", "--check", "{\"name\": \"unit tests\", \"kind\": \"test\", \"command\": [\"python\", \"-c\", \"print('1 passed')\"]}"], "json": true},
    {"cli": ["run", "start", "WG-1"], "json": true, "save": {"attempt": "/id"}},
    {"assert": {"json": {"path": "/status", "equals": "queued"}}},
    {"drain": {"max_jobs": 20}},
    {"cli": ["attempt", "show", "{var:attempt}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "succeeded"}}},
    {"assert": {"json": {"path": "/usage", "equals": {"input_tokens": 1200, "output_tokens": 340}}}},
    {"assert": {"json": {"path": "/usage_source", "equals": "command_reported"}}},
    {"assert": {"json": {"path": "/cost_usd", "equals": null}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "awaiting_review"}}},
    {"cli": ["git", "changes", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/cumulative_churn/structurally_analyzed_commits", "equals": 2}}},
    {"assert": {"json": {"path": "/cumulative_churn/functions_affected", "equals": 2}}},
    {"cli": ["verify", "runs", "--task", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "passed"}}},
    {"cli": ["task", "accept", "WG-1"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "accepted"}}},
    {"cli": ["task", "history", "WG-1"], "json": true},
    {"assert": {"stdout_contains": "attempt.succeeded"}},
    {"assert": {"stdout_contains": "task.accepted"}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_runs.py::test_successful_cross_repo_run_with_verification: the non-null and ordering checks (duration_ms and queue_wait_ms set, telemetry progress_events >= 2, two modified repositories, baseline and outcome manifest ids set) are not expressible with json equality, so the golden records the observed values instead; the change-set status 'verified' and the execution_context commit links are not asserted by any CLI output here",
      "covered_by": "CORE-12"
    }
  ]
}
