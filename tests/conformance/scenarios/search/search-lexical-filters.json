{
  "id": "search-lexical-filters",
  "covers": ["C133"],
  "setup": [
    {"git": "init", "repo": "auth"},
    {"git": "commit", "repo": "auth", "files": {"README.md": "auth\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["repo", "register", "{repo:auth}"], "json": true},
    {"cli": ["project", "create", "platform", "--name", "Platform", "--repo", "auth"], "json": true},
    {"cli": ["task", "create", "Login token refresh fails", "-d", "OAuth token expiry", "-r", "auth", "-p", "platform", "--ready"], "json": true},
    {"cli": ["task", "create", "Token refresh race condition", "-d", "oauth token renew", "-r", "auth"], "json": true},
    {"cli": ["task", "create", "Dark mode colours", "-d", "css theme"], "json": true},
    {"cli": ["task", "claim", "WG-1", "--agent", "alice"], "json": true},
    {"cli": ["search", "token refresh"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["search", "token refresh", "--mode", "lexical"], "json": true},
    {"cli": ["search", "token", "--mode", "lexical", "--repo", "auth"], "json": true},
    {"cli": ["search", "token", "--mode", "lexical", "--project", "platform"], "json": true},
    {"cli": ["search", "token", "-s", "backlog"], "json": true},
    {"cli": ["search", "token", "-s", "in_progress", "-s", "ready"], "json": true},
    {"cli": ["search", "token", "--category", "bug_fix"], "json": true},
    {"cli": ["search", "token", "--agent", "alice"], "json": true},
    {"cli": ["search", "token", "--model", "m1"], "json": true},
    {"cli": ["search", "token", "--path", "src/"], "json": true},
    {"cli": ["search", "token", "--limit", "1"], "json": true},
    {"cli": ["search", "dark", "--mode", "lexical", "--limit", "5"], "json": true},
    {"cli": ["search", "oauth token", "--mode", "semantic"], "json": true},
    {"cli": ["search", "zzz-no-match"], "json": true}
  ],
  "not_observable": []
}
