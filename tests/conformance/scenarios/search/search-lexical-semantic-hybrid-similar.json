{
  "id": "search-lexical-semantic-hybrid-similar",
  "covers": ["C133"],
  "setup": [
    {"git": "init", "repo": "auth"},
    {"git": "commit", "repo": "auth", "files": {"README.md": "auth\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "llm.embeddings.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.embeddings.model", "hash-embed-256"], "json": true},
    {"cli": ["repo", "register", "{repo:auth}"], "json": true},
    {"cli": ["task", "create", "Login token refresh fails", "-d", "OAuth token expiry", "-r", "auth"], "json": true},
    {"cli": ["task", "create", "Token refresh race condition", "-d", "oauth token renew", "-r", "auth"], "json": true},
    {"cli": ["task", "create", "Dark mode colours", "-d", "css theme"], "json": true},
    {"cli": ["search", "token refresh"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/mode", "equals": "lexical"}}},
    {"assert": {"json": {"path": "/semantic_available", "equals": false}}},
    {"assert": {"json": {"path": "/hits/0/key", "not_equals": "WG-3"}}},
    {"assert": {"json": {"path": "/hits/1/key", "not_equals": "WG-3"}}},
    {"assert": {"json": {"path": "/hits/2", "absent": true}}},
    {"cli": ["search", "token refresh", "--reindex"], "json": true},
    {"drain": {}},
    {"cli": ["search", "oauth token", "--mode", "hybrid"], "json": true},
    {"assert": {"json": {"path": "/mode", "equals": "hybrid"}}},
    {"assert": {"json": {"path": "/semantic_available", "equals": true}}},
    {"assert": {"json": {"path": "/hits/0/key", "not_equals": "WG-3"}}},
    {"cli": ["search", "token", "--mode", "lexical", "--repo", "auth"], "json": true},
    {"assert": {"json": {"path": "/hits/0/key", "not_equals": "WG-3"}}},
    {"assert": {"json": {"path": "/hits/2", "absent": true}}},
    {"cli": ["search", "ignored", "--similar-to", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/method", "equals": "semantic"}}},
    {"assert": {"json": {"path": "/similar/0/key", "equals": "WG-2"}}},
    {"assert": {"json": {"path": "/similar/0/repository_overlap", "equals": 1.0}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_llm_classification_search.py::test_search_lexical_semantic_hybrid_and_similar: the per-task embed_task call that reports status unchanged on a second embedding has no CLI command or output field; the scenario reaches embeddings through search --reindex and reads their effect in the hybrid and similar results",
      "covered_by": "SC-17"
    }
  ]
}
