{
  "id": "search-semantic-similar-reindex",
  "covers": ["C133"],
  "setup": [
    {"git": "init", "repo": "auth"},
    {"git": "commit", "repo": "auth", "files": {"README.md": "auth\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "llm.embeddings.provider", "heuristic"], "json": true},
    {"cli": ["config", "set", "llm.embeddings.model", "hash-embed-256"], "json": true},
    {"cli": ["repo", "register", "{repo:auth}"], "json": true},
    {"cli": ["task", "create", "Login token refresh fails", "-d", "OAuth token expiry", "-r", "auth"], "json": true},
    {"cli": ["task", "create", "Token refresh race condition", "-d", "oauth token renew", "-r", "auth"], "json": true},
    {"cli": ["task", "create", "Dark mode colours", "-d", "css theme"], "json": true},
    {"cli": ["search", "oauth token", "--mode", "hybrid"], "json": true},
    {"cli": ["search", "oauth token", "--reindex"], "json": true},
    {"drain": {}},
    {"cli": ["search", "oauth token", "--mode", "semantic"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["search", "oauth token"], "json": true},
    {"cli": ["search", "oauth token", "--mode", "lexical"], "json": true},
    {"cli": ["search", "ignored", "--similar-to", "WG-1"], "json": true},
    {"cli": ["search", "ignored", "--similar-to", "WG-1", "--limit", "1", "--repo", "auth"], "json": true},
    {"cli": ["search", "ignored", "--similar-to", "WG-999"], "json": true, "expect_exit": 4}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_llm_classification_search.py::test_search_lexical_semantic_hybrid_and_similar: the per-task embed_task call that reports status unchanged on a second embedding has no CLI command; the scenario reaches the same embeddings through search --reindex and reads their effect in the semantic and similar results",
      "covered_by": "SC-17"
    }
  ]
}
