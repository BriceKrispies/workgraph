{
  "id": "stack-accept-parent-lands-verified",
  "covers": [
    "C099",
    "C060",
    "C001",
    "C118",
    "C152",
    "C172",
    "C136",
    "C131",
    "C143",
    "C138",
    "C145",
    "C165",
    "B04",
    "B05"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "svc"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "base.txt": "base\n"
      },
      "message": "initial"
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "execution.enabled",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_embed",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_classify",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "stacks.auto_accept",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-a",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=a.py",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-b",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=b.py",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:svc}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Parent work",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\":\"types\",\"kind\":\"typecheck\",\"tier\":\"fast\",\"command\":[\"python\",\"-c\",\"print('1 passed')\"]}",
        "--check",
        "{\"name\":\"suite\",\"kind\":\"test\",\"command\":[\"python\",\"-c\",\"print('1 passed')\"]}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "First change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Second change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-1"
      ],
      "json": true
    },
    {
      "cli": [
        "run",
        "start",
        "WG-2",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-3",
        "--agent",
        "fake-b",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "awaiting_review"
        }
      }
    },
    {
      "cli": [
        "task",
        "accept",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "exit": 0
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "accepted"
        }
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-2"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "accepted"
        }
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-3"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "accepted"
        }
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "landed"
        }
      }
    },
    {
      "assert": {
        "file": "{repo:svc}/a.py",
        "exists": true
      }
    },
    {
      "assert": {
        "file": "{repo:svc}/b.py",
        "exists": true
      }
    },
    {
      "cli": [
        "stack",
        "history",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "stdout_contains": "stack.landed"
      }
    },
    {
      "assert": {
        "stdout_contains": "stack.integration_removed"
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stack_integration.py::test_accepting_the_parent_lands_the_verified_stack_on_the_default_branch: the rev-parse equalities (main equals the integration tip, and the landed tips event data), the removed integration branch and the integration worktree path are git and filesystem reads the CLI does not expose; the acceptance rows (mode automated, verification_run_id) are database reads",
      "covered_by": "CR-06"
    }
  ]
}
