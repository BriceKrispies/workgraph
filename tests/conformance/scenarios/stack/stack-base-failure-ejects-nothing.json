{
  "id": "stack-base-failure-ejects-nothing",
  "covers": [
    "C099",
    "C060",
    "C001",
    "C118",
    "C152",
    "C172",
    "C136",
    "C131",
    "C143",
    "C138",
    "C165",
    "B04"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "svc"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "base.txt": "base\n"
      },
      "message": "initial"
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "execution.enabled",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-a",
        "C:/dev/workgraph/.claude/worktrees/agent-a5745bdc83ae3bbd9/.venv/Scripts/python.exe",
        "--arg=-m",
        "--arg=workgraph.demo.scripted_agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=a.txt",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-b",
        "C:/dev/workgraph/.claude/worktrees/agent-a5745bdc83ae3bbd9/.venv/Scripts/python.exe",
        "--arg=-m",
        "--arg=workgraph.demo.scripted_agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=b.txt",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:svc}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Parent work",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\":\"types\",\"kind\":\"typecheck\",\"tier\":\"fast\",\"command\":[\"python\",\"-c\",\"print('1 passed')\"]}",
        "--check",
        "{\"name\":\"suite\",\"kind\":\"test\",\"command\":[\"python\",\"-c\",\"print('FAILED tests/test_api.py::test_login - AssertionError'); raise SystemExit(1)\"]}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "First change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Second change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-1"
      ],
      "json": true
    },
    {
      "cli": [
        "run",
        "start",
        "WG-2",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-3",
        "--agent",
        "fake-b",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "integrating"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/state",
          "equals": "merged"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/1/state",
          "equals": "merged"
        }
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-2"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "awaiting_verification"
        }
      }
    },
    {
      "cli": [
        "stack",
        "history",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "stdout_contains": "stack.verification_failed_on_base"
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stack_integration.py::test_a_failure_on_the_base_ejects_nothing: the negative assertions (no stack.item_ejected and no stack.verified in the history) need a 'not contains' assert, which the schema does not have; the golden records the full history, so Rust must match it exactly",
      "covered_by": "CR-01"
    }
  ]
}
