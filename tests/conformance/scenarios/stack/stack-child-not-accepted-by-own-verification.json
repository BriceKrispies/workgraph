{
  "id": "stack-child-not-accepted-by-own-verification",
  "covers": [
    "C099",
    "C060",
    "C001",
    "C118",
    "C152",
    "C172",
    "C136",
    "C131",
    "C143",
    "C175",
    "C165",
    "B04",
    "B05"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "svc"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "base.txt": "base\n"
      },
      "message": "initial"
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "execution.enabled",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "stacks.auto_accept",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-a",
        "C:/dev/workgraph/.claude/worktrees/agent-a5745bdc83ae3bbd9/.venv/Scripts/python.exe",
        "--arg=-m",
        "--arg=workgraph.demo.scripted_agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=a.py",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-b",
        "C:/dev/workgraph/.claude/worktrees/agent-a5745bdc83ae3bbd9/.venv/Scripts/python.exe",
        "--arg=-m",
        "--arg=workgraph.demo.scripted_agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=b.py",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:svc}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Parent work",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\":\"types\",\"kind\":\"typecheck\",\"tier\":\"fast\",\"command\":[\"python\",\"-c\",\"print('1 passed')\"]}",
        "--check",
        "{\"name\":\"suite\",\"kind\":\"test\",\"command\":[\"python\",\"-c\",\"print('1 passed')\"]}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "First change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Second change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-1"
      ],
      "json": true
    },
    {
      "cli": [
        "run",
        "start",
        "WG-2",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-3",
        "--agent",
        "fake-b",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "verified"
        }
      }
    },
    {
      "cli": [
        "verify",
        "run",
        "WG-2"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/required_passed",
          "equals": true
        }
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-2"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "awaiting_review"
        }
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "awaiting_review"
        }
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "verified"
        }
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stack_integration.py::test_stack_child_is_not_accepted_by_its_own_verification: the child is first moved to awaiting_verification by a direct database write, and the no-auto-accept-row check reads task_acceptances; neither has a CLI step, so the run starts from awaiting_review",
      "covered_by": "CR-06"
    }
  ]
}
