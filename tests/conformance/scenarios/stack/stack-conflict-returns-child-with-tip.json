{
  "id": "stack-conflict-returns-child-with-tip",
  "covers": [
    "C099",
    "C060",
    "C001",
    "C118",
    "C172",
    "C152",
    "C136",
    "C131",
    "C127",
    "C143",
    "C165",
    "C021",
    "B04"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "svc"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "base.txt": "base\n"
      },
      "message": "initial"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "workgraph-demo.json": "{\"file\": \"shared.py\", \"content\": \"VALUE = '{task}'\\n\"}\n"
      },
      "message": "add demo plan"
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {"cli": ["config", "set", "llm.auto_embed", "false"], "json": true},
    {"cli": ["config", "set", "llm.auto_classify", "false"], "json": true},
    {
      "cli": [
        "config",
        "set",
        "execution.enabled",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-a",
        "python",
        "--arg=-c",
        "--arg=import json,os,pathlib,subprocess,sys\nm=json.load(open(sys.argv[1]))\nk=json.loads(sys.stdin.read())['task']['key']\nf=sys.argv[2]\ne=dict(os.environ,GIT_AUTHOR_NAME='Workgraph Scripted Agent',GIT_AUTHOR_EMAIL='agent@workgraph.local',GIT_COMMITTER_NAME='Workgraph Scripted Agent',GIT_COMMITTER_EMAIL='agent@workgraph.local')\nch=[]\nfor r in m['repositories']:\n    if r['access']!='read_write': continue\n    p=pathlib.Path(r['checkout_path'])\n    plan=p/'workgraph-demo.json'\n    if plan.exists():\n        d=json.loads(plan.read_text()); t=p/d['file']; c=d['content'].replace(chr(123)+'task'+chr(125),k)\n    else:\n        t=p/f; prev=t.read_text() if t.exists() else ''; c=prev+'def change_%d():\\n    return %r\\n' % (len(prev.splitlines()),k)\n    t.parent.mkdir(parents=True,exist_ok=True); t.write_text(c,newline='\\n')\n    subprocess.run(['git','-C',str(p),'add','-A'],check=True,env=e,capture_output=True)\n    subprocess.run(['git','-C',str(p),'commit','-q','-m','Implement %s in %s\\n\\nTask-ID: %s' % (k,r['repository'],k)],check=True,env=e,capture_output=True)\n    ch.append(r['repository']+':'+str(t.relative_to(p)))\nprint(json.dumps(dict(type='usage',input_tokens=1200,output_tokens=340)))\nprint(json.dumps(dict(type='result',status='succeeded',summary='changed '+(', '.join(ch) or 'nothing'))))\n",
        "--arg={manifest}",
        "--arg=a.py",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:svc}"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "stacks.auto_accept",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\": \"types\", \"kind\": \"typecheck\", \"tier\": \"fast\", \"command\": [\"python\", \"-c\", \"print('1 passed')\"]}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Parent work",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "First change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Second change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-1"
      ],
      "json": true,
      "save": {
        "stack": "/id"
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-2",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "first": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:first}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true,
      "save": {
        "tip": "/repositories/0/integration_tip"
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-3",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "second": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:second}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/items/1/state",
          "equals": "conflict"
        }
      }
    },
    {
      "assert": {
        "stdout_contains": "shared.py"
      }
    },
    {
      "assert": {
        "stdout_contains": "{var:tip}"
      }
    },
    {
      "assert": {
        "stdout_contains": "rebase"
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-3"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "ready"
        }
      }
    },
    {
      "assert": {
        "stdout_contains": "shared.py"
      }
    },
    {
      "assert": {
        "stdout_contains": "{var:tip}"
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-3",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "retry": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:retry}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "assert": {
        "stdout_contains": "{var:tip}"
      }
    },
    {
      "cli": [
        "attempt",
        "manifests",
        "{var:retry}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/0/entries/0/target_ref",
          "equals": "{var:tip}"
        }
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/items/1/state",
          "equals": "verified"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/state",
          "equals": "verified"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/1/merge_order",
          "equals": 2
        }
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stack_integration.py::test_conflicting_pair_sends_the_second_child_back_with_the_integration_tip: the integration worktree is clean and the integration branch did not move after the aborted merge, the main branch is not at the tip, and the merge subject 'Merge WG-3: Second change into wg/stack/wg-1'; the runner has no git query step",
      "covered_by": "CR-01"
    },
    {
      "case": "tests/integration/test_stack_integration.py::test_conflicting_pair_sends_the_second_child_back_with_the_integration_tip: the conflict detail is a JSON string inside the item's detail field; the test parses it and compares paths, integration_tip and instruction exactly, while the scenario checks substrings of the stack output (shared.py, the tip sha, rebase)",
      "covered_by": "CR-01"
    },
    {
      "case": "tests/integration/test_stack_integration.py::test_conflicting_pair_sends_the_second_child_back_with_the_integration_tip: the prepared-base event is checked by substring only (the tip sha appears in the run output); the source field equal to integration_tip is not asserted exactly",
      "covered_by": "CR-01"
    }
  ]
}
