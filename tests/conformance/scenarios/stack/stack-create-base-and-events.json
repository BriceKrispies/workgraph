{
  "id": "stack-create-base-and-events",
  "covers": ["C136", "C138", "C143", "C118"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"base.txt": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["task", "create", "Parent work", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "First change", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "Second change", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"cli": ["stack", "create", "WG-1"], "json": true, "save": {"base": "/repositories/0/base_sha"}},
    {"assert": {"json": {"path": "/parent_key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/status", "equals": "open"}}},
    {"assert": {"json": {"path": "/repositories/0/repository_name", "equals": "svc"}}},
    {"assert": {"json": {"path": "/repositories/0/base_sha", "equals": "{var:base}"}}},
    {"assert": {"json": {"path": "/repositories/0/integration_branch", "equals": "wg/stack/wg-1"}}},
    {"assert": {"json": {"path": "/items/0/task_key", "equals": "WG-2"}}},
    {"assert": {"json": {"path": "/items/0/state", "equals": "pending"}}},
    {"assert": {"json": {"path": "/items/0/merge_order", "equals": null}}},
    {"assert": {"json": {"path": "/items/1/task_key", "equals": "WG-3"}}},
    {"assert": {"json": {"path": "/items/1/state", "equals": "pending"}}},
    {"cli": ["stack", "history", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/0/event_type", "equals": "stack.created"}}},
    {"assert": {"json": {"path": "/0/data/base_shas/svc", "equals": "{var:base}"}}},
    {"assert": {"json": {"path": "/0/data/integration_branch", "equals": "wg/stack/wg-1"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stacks.py::test_base_sha_is_fixed_at_creation: the repository's main moves on after the stack is created and the stored base is read again; steps cannot create commits after setup, so only the base recorded at creation is asserted",
      "covered_by": "CORE-13"
    }
  ]
}
