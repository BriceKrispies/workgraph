{
  "id": "stack-create-show-list",
  "covers": ["C136", "C140", "C143", "C118"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"base.txt": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["task", "create", "Parent work", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "First change", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "Second change", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"cli": ["stack", "create", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/parent_key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/status", "equals": "open"}}},
    {"assert": {"json": {"path": "/repositories/0/repository_name", "equals": "svc"}}},
    {"assert": {"json": {"path": "/items/0/task_key", "equals": "WG-2"}}},
    {"assert": {"json": {"path": "/items/0/state", "equals": "pending"}}},
    {"assert": {"json": {"path": "/items/1/task_key", "equals": "WG-3"}}},
    {"cli": ["stack", "create", "WG-1"], "json": true},
    {"assert": {"exit": 3}},
    {"cli": ["stack", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/parent_key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/items/1/state", "equals": "pending"}}},
    {"cli": ["stack", "list"], "json": true},
    {"assert": {"json": {"path": "/0/parent_key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/0/status", "equals": "open"}}},
    {"cli": ["stack", "list", "--all", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/0/parent_key", "equals": "WG-1"}}},
    {"cli": ["stack", "show", "WG-2"], "json": true},
    {"assert": {"exit": 4}}
  ],
  "not_observable": []
}
