{
  "id": "stack-culprit-dependent-returns-pending",
  "covers": [
    "C099",
    "C060",
    "C001",
    "C118",
    "C152",
    "C167",
    "C172",
    "C131",
    "C136",
    "C143",
    "C165",
    "B04"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "svc"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "base.txt": "base\n"
      },
      "message": "initial"
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "execution.enabled",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-a",
        "C:/dev/workgraph/.claude/worktrees/agent-a5745bdc83ae3bbd9/.venv/Scripts/python.exe",
        "--arg=-m",
        "--arg=workgraph.demo.scripted_agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=a.txt",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-b",
        "C:/dev/workgraph/.claude/worktrees/agent-a5745bdc83ae3bbd9/.venv/Scripts/python.exe",
        "--arg=-m",
        "--arg=workgraph.demo.scripted_agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=b.txt",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-c",
        "C:/dev/workgraph/.claude/worktrees/agent-a5745bdc83ae3bbd9/.venv/Scripts/python.exe",
        "--arg=-m",
        "--arg=workgraph.demo.scripted_agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=c.txt",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:svc}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Parent work",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\":\"types\",\"kind\":\"typecheck\",\"tier\":\"fast\",\"command\":[\"python\",\"-c\",\"print('1 passed')\"]}",
        "--check",
        "{\"name\":\"combined\",\"kind\":\"test\",\"command\":[\"python\",\"-c\",\"import os; b = os.path.exists('a.txt') and os.path.exists('c.txt'); print('FAILED combined::a_and_c - a.txt and c.txt both exist' if b else '1 passed'); raise SystemExit(1 if b else 0)\"]}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "First change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Second change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Third change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready",
        "--depends-on",
        "WG-3"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "update",
        "WG-4",
        "--status",
        "ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-1"
      ],
      "json": true
    },
    {
      "cli": [
        "run",
        "start",
        "WG-2",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-3",
        "--agent",
        "fake-c",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-4",
        "--agent",
        "fake-b",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "integrating"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/state",
          "equals": "merged"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/1/state",
          "equals": "ejected"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/2/state",
          "equals": "pending"
        }
      }
    },
    {
      "assert": {
        "stdout_contains": "dependency WG-3 was ejected"
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-3"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "ready"
        }
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stack_integration.py::test_a_dependent_of_the_culprit_returns_to_pending: the integration branch's file list (a.txt present, b.txt and c.txt absent) is a git read the CLI does not expose",
      "covered_by": "CR-03"
    }
  ]
}
