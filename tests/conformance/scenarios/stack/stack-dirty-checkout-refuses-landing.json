{
  "id": "stack-dirty-checkout-refuses-landing",
  "covers": [
    "C099",
    "C060",
    "C001",
    "C118",
    "C152",
    "C172",
    "C136",
    "C131",
    "C143",
    "C138",
    "C145",
    "B04",
    "B05"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "svc"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "base.txt": "base\n"
      },
      "message": "initial"
    },
    {
      "git": "write",
      "repo": "svc",
      "files": {
        "scratch.txt": "not committed\n"
      }
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "execution.enabled",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_embed",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_classify",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "stacks.auto_accept",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-a",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=a.py",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-b",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=b.py",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:svc}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Parent work",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\":\"types\",\"kind\":\"typecheck\",\"tier\":\"fast\",\"command\":[\"python\",\"-c\",\"print('1 passed')\"]}",
        "--check",
        "{\"name\":\"suite\",\"kind\":\"test\",\"command\":[\"python\",\"-c\",\"print('1 passed')\"]}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "First change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Second change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-1"
      ],
      "json": true
    },
    {
      "cli": [
        "run",
        "start",
        "WG-2",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-3",
        "--agent",
        "fake-b",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "verified"
        }
      }
    },
    {
      "cli": [
        "task",
        "accept",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "exit": 2
      }
    },
    {
      "assert": {
        "stdout_contains": "uncommitted changes"
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "verified"
        }
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "awaiting_review"
        }
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-2"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "awaiting_review"
        }
      }
    },
    {
      "cli": [
        "stack",
        "history",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "stdout_contains": "stack.landing_refused"
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stack_integration.py::test_dirty_user_checkout_refuses_the_landing_and_moves_no_ref: the second half, deleting the scratch file and accepting again so the landing reaches main, cannot run: the file is written in setup and the runner has no step that removes it; the no-ref-moved check is a git rev-parse comparison",
      "covered_by": "CR-03"
    }
  ]
}
