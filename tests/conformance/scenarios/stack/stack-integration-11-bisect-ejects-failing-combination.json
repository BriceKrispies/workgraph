{
  "id": "stack-integration-11-bisect-ejects-failing-combination",
  "covers": [
    "C001",
    "C060",
    "C099",
    "C118",
    "C127",
    "C131",
    "C136",
    "C138",
    "C143",
    "C152",
    "C165",
    "C172",
    "C176"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "svc"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "base.txt": "base\n"
      },
      "message": "initial"
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "execution.enabled",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_embed",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_classify",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-a",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=a.txt",
        "--arg={manifest}",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-b",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=b.txt",
        "--arg={manifest}",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-c",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=c.txt",
        "--arg={manifest}",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:svc}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Parent work",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "stacks.auto_accept",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\":\"types\",\"kind\":\"typecheck\",\"tier\":\"fast\",\"command\":[\"git\",\"rev-parse\",\"--is-inside-work-tree\"]}",
        "--check",
        "{\"name\":\"combined\",\"kind\":\"test\",\"allow_shell\":true,\"command\":[\"sh\",\"-c\",\"if [ -e a.txt ] && [ -e c.txt ]; then echo FAILED combined::a_and_c - a.txt and c.txt both exist; exit 1; fi\"]}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "First change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Second change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Third change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-1"
      ],
      "json": true
    },
    {
      "cli": [
        "run",
        "start",
        "WG-2",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "run_first": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:run_first}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-3",
        "--agent",
        "fake-b",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "run_second": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:run_second}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "verify",
        "runs",
        "--task",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "",
          "equals": []
        }
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-4",
        "--agent",
        "fake-c",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "run_third": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:run_third}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/state",
          "equals": "verified"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/1/state",
          "equals": "verified"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/2/task_key",
          "equals": "WG-4"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/items/2/state",
          "equals": "ejected"
        }
      }
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "verified"
        }
      }
    },
    {
      "cli": [
        "stack",
        "history",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "stdout_contains": "stack.verification_failed"
      }
    },
    {
      "assert": {
        "stdout_contains": "stack.bisect_probe"
      }
    },
    {
      "assert": {
        "stdout_contains": "stack.item_ejected"
      }
    },
    {
      "assert": {
        "stdout_contains": "stack.rebuilt"
      }
    },
    {
      "assert": {
        "stdout_contains": "stack.verified"
      }
    },
    {
      "assert": {
        "stdout_contains": "test:combined::a_and_c"
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-4"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "ready"
        }
      }
    },
    {
      "assert": {
        "stdout_contains": "combined"
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-2"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "awaiting_review"
        }
      }
    },
    {
      "cli": [
        "task",
        "show",
        "WG-3"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "awaiting_review"
        }
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stack_integration.py::test_bisect_ejects_the_child_that_completes_a_failing_combination: the integration branch's files (a.txt and b.txt present, c.txt absent) are read from git; the runner has no step that lists a branch's tree",
      "covered_by": "SH-15"
    },
    {
      "case": "tests/integration/test_stack_integration.py::test_bisect_ejects_the_child_that_completes_a_failing_combination: the verification run row (required_passed is False, task_id is the parent) is a database read; the runner's db assertions are skipped until the driver lands",
      "covered_by": "CR-06"
    }
  ]
}
