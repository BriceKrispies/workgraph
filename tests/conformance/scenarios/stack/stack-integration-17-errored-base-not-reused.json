{
  "id": "stack-integration-17-errored-base-not-reused",
  "covers": [
    "C001",
    "C060",
    "C099",
    "C118",
    "C127",
    "C131",
    "C136",
    "C138",
    "C143",
    "C144",
    "C152",
    "C172"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "svc"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "base.txt": "base\n"
      },
      "message": "initial"
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "execution.enabled",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_embed",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_classify",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-a",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=a.txt",
        "--arg={manifest}",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-b",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=b.txt",
        "--arg={manifest}",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-c",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=c.txt",
        "--arg={manifest}",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:svc}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Parent work",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "stacks.auto_accept",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\":\"types\",\"kind\":\"typecheck\",\"tier\":\"fast\",\"command\":[\"git\",\"rev-parse\",\"--is-inside-work-tree\"]}",
        "--check",
        "{\"name\":\"suite\",\"kind\":\"test\",\"allow_shell\":true,\"command\":[\"sh\",\"-c\",\"if [ -e c.txt ]; then echo FAILED suite::late - c.txt exists; exit 1; fi; echo runner could not start; exit 2\"],\"error_exit_codes\":[2]}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "First change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Second change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Third change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-1"
      ],
      "json": true
    },
    {
      "cli": [
        "run",
        "start",
        "WG-2",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "run_first": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:run_first}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-3",
        "--agent",
        "fake-b",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "run_second": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:run_second}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-4",
        "--agent",
        "fake-c",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "run_third": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:run_third}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "integrating"
        }
      }
    },
    {
      "cli": [
        "stack",
        "history",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "stdout_contains": "stack.verification_errored"
      }
    },
    {
      "assert": {
        "stdout_contains": "\"stage\": \"base\""
      }
    },
    {
      "assert": {
        "stdout_contains": "runner could not start"
      }
    },
    {
      "cli": [
        "stack",
        "verify",
        "WG-1"
      ],
      "json": true,
      "save": {
        "verify_job": "/job_id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "integrating"
        }
      }
    },
    {
      "cli": [
        "stack",
        "history",
        "WG-1"
      ],
      "json": true
    },
    {
      "assert": {
        "stdout_contains": "stack.verification_errored"
      }
    }
  ],
  "not_observable": []
}
