{
  "id": "stack-integration-19-older-check-definition-not-reused",
  "covers": [
    "C001",
    "C060",
    "C099",
    "C118",
    "C127",
    "C131",
    "C136",
    "C138",
    "C143",
    "C152",
    "C172"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "svc"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "base.txt": "base\n"
      },
      "message": "initial"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "bad_a.txt": "known\n"
      },
      "message": "record a known failure"
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "execution.enabled",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_embed",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_classify",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-a",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=a.txt",
        "--arg={manifest}",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-b",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=c.txt",
        "--arg={manifest}",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-d",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=d.txt",
        "--arg={manifest}",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-e",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=e.txt",
        "--arg={manifest}",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:svc}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Parent work",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "stacks.auto_accept",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\":\"types\",\"kind\":\"typecheck\",\"tier\":\"fast\",\"command\":[\"git\",\"rev-parse\",\"--is-inside-work-tree\"]}",
        "--check",
        "{\"name\":\"suite\",\"kind\":\"test\",\"allow_shell\":true,\"command\":[\"sh\",\"-c\",\"bad=0; for f in bad_*; do if [ -e $f ]; then echo test $f ... FAILED; bad=1; fi; done; exit $bad\"],\"parser\":\"cargo\",\"baseline\":\"regression\"}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "First change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Second change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-1"
      ],
      "json": true
    },
    {
      "cli": [
        "run",
        "start",
        "WG-2",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "run_first": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:run_first}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-3",
        "--agent",
        "fake-b",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "run_second": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:run_second}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-1"
      ],
      "json": true,
      "save": {
        "old_base": "/repositories/0/base_sha"
      }
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "landed"
        }
      }
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\":\"types\",\"kind\":\"typecheck\",\"tier\":\"fast\",\"command\":[\"git\",\"rev-parse\",\"--is-inside-work-tree\"]}",
        "--check",
        "{\"name\":\"suite\",\"kind\":\"test\",\"allow_shell\":true,\"command\":[\"sh\",\"-c\",\"bad=0; for f in bad_*; do if [ -e $f ]; then echo test $f ... FAILED; bad=1; fi; done; exit $bad\"],\"parser\":\"cargo\",\"baseline\":\"regression\",\"env\":{\"SUITE_VERSION\":\"2\"}}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Next parent",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Third change",
        "--parent",
        "WG-4",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Fourth change",
        "--parent",
        "WG-4",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-4"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/repositories/0/base_sha",
          "not_equals": "{var:old_base}"
        }
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-5",
        "--agent",
        "fake-d",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "run_third": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:run_third}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "run",
        "start",
        "WG-6",
        "--agent",
        "fake-e",
        "--no-wait"
      ],
      "json": true,
      "save": {
        "run_fourth": "/id"
      }
    },
    {
      "drain": {
        "max_jobs": 20
      }
    },
    {
      "cli": [
        "run",
        "get",
        "{var:run_fourth}"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/attempt/status",
          "equals": "succeeded"
        }
      }
    },
    {
      "cli": [
        "stack",
        "show",
        "WG-4"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/status",
          "equals": "landed"
        }
      }
    },
    {
      "cli": [
        "stack",
        "history",
        "WG-4"
      ],
      "json": true
    },
    {
      "assert": {
        "stdout_contains": "tolerated"
      }
    },
    {
      "assert": {
        "stdout_contains": "test:bad_a.txt"
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stack_integration.py::test_a_cached_base_result_from_an_older_check_definition_is_not_reused: the old configuration is disabled before the new one is created (set_config_enabled); the CLI has no disable command, so the scenario updates the same-named configuration instead",
      "covered_by": "CORE-16"
    },
    {
      "case": "tests/integration/test_stack_integration.py::test_a_cached_base_result_from_an_older_check_definition_is_not_reused: the verification run rows (count, and runs at the old base) are database reads; the runner's db assertions are skipped until the driver lands",
      "covered_by": "CR-06"
    }
  ]
}
