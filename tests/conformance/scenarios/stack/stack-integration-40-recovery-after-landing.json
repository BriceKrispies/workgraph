{
  "id": "stack-integration-40-recovery-after-landing",
  "covers": ["C001", "C060", "C099", "C118", "C131", "C136", "C143", "C145", "C152", "C172", "C178"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"base.txt": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "execution.enabled", "true"], "json": true},
    {"cli": ["config", "set", "stacks.auto_accept", "false"], "json": true},
    {"cli": ["agent", "add-command", "fake-a", "workgraph-demo-agent", "--arg=--mode", "--arg=success", "--arg=--file", "--arg=a.py", "--arg={manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["agent", "add-command", "fake-b", "workgraph-demo-agent", "--arg=--mode", "--arg=success", "--arg=--file", "--arg=b.py", "--arg={manifest}", "--timeout", "120", "--supports-usage"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["task", "create", "Parent work", "--repo", "svc"], "json": true},
    {"cli": ["verify", "config", "gate", "--scope-type", "repository", "--scope", "svc", "--check", "{\"name\": \"types\", \"kind\": \"typecheck\", \"tier\": \"fast\", \"command\": [\"python\", \"-c\", \"print('1 passed')\"]}"], "json": true},
    {"cli": ["task", "create", "Only change", "--parent", "WG-1", "--repo", "svc", "--ready"], "json": true},
    {"cli": ["stack", "create", "WG-1"], "json": true},
    {"cli": ["run", "start", "WG-2", "--agent", "fake-a"], "json": true},
    {"drain": {"max_jobs": 20}},
    {"cli": ["task", "accept", "WG-1", "--manual", "--reason", "landed by hand"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["stack", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "landed"}}},
    {"cli": ["worker", "recover"], "json": true},
    {"assert": {"json": {"path": "/worktrees/released", "equals": []}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stack_integration.py::test_recovery_releases_the_worktrees_of_a_landed_stack: the stack status is written straight to the database while its integration worktree stays active, a crash state no command produces because landing removes that worktree itself; the released path and the cleanup dry run are therefore not reached", 
      "covered_by": "CORE-13"
    }
  ]
}
