{
  "id": "stack-membership-events",
  "covers": ["C135", "C138", "C142", "C143", "C136"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"base.txt": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["task", "create", "Parent work", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "First change", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "Second change", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"cli": ["stack", "create", "WG-1"], "json": true},
    {"cli": ["stack", "remove", "WG-1", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/items/0/task_key", "equals": "WG-2"}}},
    {"cli": ["stack", "history", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/1/event_type", "equals": "stack.item_removed"}}},
    {"cli": ["task", "create", "Late change", "--parent", "WG-1", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "Unrelated"], "json": true},
    {"cli": ["stack", "add", "WG-1", "WG-4"], "json": true},
    {"assert": {"json": {"path": "/items/1/task_key", "equals": "WG-4"}}},
    {"assert": {"json": {"path": "/items/1/state", "equals": "pending"}}},
    {"cli": ["stack", "history", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/2/event_type", "equals": "stack.item_added"}}},
    {"cli": ["stack", "add", "WG-1", "WG-4"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "conflict"}}},
    {"cli": ["stack", "add", "WG-1", "WG-5"], "json": true, "expect_exit": 2},
    {"cli": ["stack", "remove", "WG-1", "WG-5"], "json": true, "expect_exit": 4},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stacks.py::test_add_and_remove_children: removing a merged child is refused with ConflictError; a child only reaches merged through integration jobs",
      "covered_by": "SC-05"
    }
  ]
}
