{
  "id": "stack-sibling-readiness-and-acceptance",
  "covers": ["C136", "C141", "C142", "C145", "C148", "C150"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"base.txt": "base\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["task", "create", "Parent work", "--repo", "svc"], "json": true},
    {"cli": ["task", "create", "Stack sibling", "--parent", "WG-1", "--repo", "svc", "--ready"], "json": true},
    {"cli": ["task", "create", "Stack dependent", "--parent", "WG-1", "--repo", "svc", "--ready", "--depends-on", "WG-2"], "json": true},
    {"cli": ["task", "create", "Outside work", "--repo", "svc", "--ready"], "json": true},
    {"cli": ["task", "create", "Needs outside", "--repo", "svc", "--ready", "--depends-on", "WG-4"], "json": true},
    {"cli": ["stack", "create", "WG-1"], "json": true},
    {"cli": ["task", "show", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "blocked"}}},
    {"cli": ["task", "claim", "WG-2", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-2", "-m", "sibling done"], "json": true},
    {"cli": ["task", "claim", "WG-4", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-4", "-m", "outside done"], "json": true},
    {"cli": ["task", "show", "WG-5"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "blocked"}}},
    {"cli": ["stack", "readmit", "WG-1", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/items/0/state", "equals": "ready"}}},
    {"cli": ["task", "show", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"cli": ["task", "show", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "awaiting_review"}}},
    {"cli": ["task", "show", "WG-5"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "blocked"}}},
    {"cli": ["task", "accept", "WG-4", "--manual", "-m", "reviewed"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "show", "WG-5"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"cli": ["stack", "remove", "WG-1", "WG-2"], "json": true},
    {"cli": ["task", "show", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "blocked"}}}
  ],
  "not_observable": []
}
