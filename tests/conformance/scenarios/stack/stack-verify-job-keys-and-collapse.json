{
  "id": "stack-verify-job-keys-and-collapse",
  "covers": [
    "C099",
    "C060",
    "C001",
    "C118",
    "C152",
    "C172",
    "C136",
    "C131",
    "C144",
    "C103",
    "B04"
  ],
  "setup": [
    {
      "git": "init",
      "repo": "svc"
    },
    {
      "git": "commit",
      "repo": "svc",
      "files": {
        "base.txt": "base\n"
      },
      "message": "initial"
    }
  ],
  "steps": [
    {
      "cli": [
        "init"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "execution.enabled",
        "true"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_embed",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "llm.auto_classify",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "config",
        "set",
        "stacks.auto_accept",
        "false"
      ],
      "json": true
    },
    {
      "cli": [
        "agent",
        "add-command",
        "fake-a",
        "workgraph-demo-agent",
        "--arg=--mode",
        "--arg=success",
        "--arg=--file",
        "--arg=a.py",
        "--arg={manifest}",
        "--timeout",
        "120",
        "--supports-usage"
      ],
      "json": true
    },
    {
      "cli": [
        "repo",
        "register",
        "{repo:svc}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Parent work",
        "--repo",
        "svc"
      ],
      "json": true
    },
    {
      "cli": [
        "verify",
        "config",
        "gate",
        "--scope-type",
        "repository",
        "--scope",
        "svc",
        "--check",
        "{\"name\":\"types\",\"kind\":\"typecheck\",\"tier\":\"fast\",\"command\":[\"python\",\"-c\",\"print('1 passed')\"]}"
      ],
      "json": true
    },
    {
      "cli": [
        "task",
        "create",
        "Only change",
        "--parent",
        "WG-1",
        "--repo",
        "svc",
        "--ready"
      ],
      "json": true
    },
    {
      "cli": [
        "stack",
        "create",
        "WG-1"
      ],
      "json": true
    },
    {
      "cli": [
        "run",
        "start",
        "WG-2",
        "--agent",
        "fake-a",
        "--no-wait"
      ],
      "json": true
    },
    {
      "drain": {
        "max_jobs": 50
      }
    },
    {
      "cli": [
        "job",
        "list",
        "--kind",
        "stack_verify"
      ],
      "json": true
    },
    {
      "assert": {
        "json": {
          "path": "/items/0/kind",
          "equals": "stack_verify"
        }
      }
    },
    {
      "cli": [
        "stack",
        "verify",
        "WG-1"
      ],
      "json": true,
      "save": {
        "verify_job": "/job_id"
      }
    },
    {
      "assert": {
        "json": {
          "path": "/stack",
          "equals": "WG-1"
        }
      }
    }
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_stack_integration.py::test_stack_verify_jobs_hold_their_stacks_key_and_the_repository_verify_key: the job payload and its two resource keys (exclusive:stack:<id>:<repo> and verify:<repo>) are not in any CLI output except job show, and the same-job collapse on settled tips is asserted through enqueue_if_settled, which no CLI reaches",
      "covered_by": "CORE-19"
    }
  ]
}
