{
  "id": "task-claim-progress-release",
  "covers": ["C018", "C148", "C152", "C158", "C163"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Claimable", "--ready"], "json": true},
    {"cli": ["task", "create", "Backlog only"], "json": true},
    {"cli": ["task", "claim", "WG-1", "--agent", "alice", "--lease-minutes", "30"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "claimed"}}},
    {"assert": {"json": {"path": "/claimed_by", "equals": "agent:alice"}}},
    {"cli": ["task", "claim", "WG-1", "--agent", "bob"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "resource_busy"}}},
    {"cli": ["task", "claim", "WG-2", "--agent", "alice"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "invalid_transition"}}},
    {"cli": ["attempt", "create", "WG-1", "--provider", "external", "--model", "model-a"], "json": true, "save": {"attempt": "/id"}},
    {"cli": ["task", "progress", "WG-1", "halfway there", "--percent", "50", "--attempt", "{var:attempt}"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "progress", "WG-1", "no attempt given", "--percent", "75"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "progress", "WG-1", "unknown attempt", "--attempt", "00000000-0000-0000-0000-000000000000"], "json": true, "expect_exit": 4},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}},
    {"cli": ["task", "release", "WG-1", "--reason", "handing over"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"assert": {"json": {"path": "/claimed_by", "equals": null}}},
    {"cli": ["task", "release", "WG-1"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "invalid_transition"}}},
    {"cli": ["task", "release", "WG-404"], "json": true, "expect_exit": 4},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}},
    {"cli": ["task", "claim", "WG-1", "--agent", "carol"], "json": true},
    {"assert": {"json": {"path": "/claimed_by", "equals": "agent:carol"}}},
    {"cli": ["task", "release", "WG-1", "--reason", "done with it", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}}
  ],
  "not_observable": []
}
