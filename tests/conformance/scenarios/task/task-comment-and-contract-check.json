{
  "id": "task-comment-and-contract-check",
  "covers": ["C149", "C151", "C152"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Commented task"], "json": true},
    {"cli": ["task", "comment", "WG-1", "A first note"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "comment", "WG-1", "A second note", "-w", "default"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/comments/1/body", "equals": "A second note"}}},
    {"cli": ["task", "comment", "WG-1"], "expect_exit": 2},
    {"cli": ["task", "contract-check", "WG-1", "--model", "model-a"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "contract-check", "WG-1", "--model", "model-a", "--target", "0.5", "-w", "default"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "contract-check", "WG-404", "--model", "model-a"], "json": true, "expect_exit": 4},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}},
    {"cli": ["task", "contract-check", "WG-1"], "expect_exit": 2}
  ],
  "not_observable": []
}
