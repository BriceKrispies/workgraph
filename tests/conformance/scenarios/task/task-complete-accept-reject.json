{
  "id": "task-complete-accept-reject",
  "covers": ["C018", "C145", "C150", "C152", "C161", "C164", "C172"],
  "setup": [
    {"git": "init", "repo": "checked"},
    {"git": "commit", "repo": "checked", "files": {"README.md": "# checked\n"}, "message": "checked base"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:checked}"], "json": true},
    {"cli": ["verify", "config", "checked-tests", "--scope-type", "repository", "--scope", "checked", "--check", "{\"name\": \"unit\", \"command\": [\"python\", \"-c\", \"pass\"]}"], "json": true},
    {"cli": ["task", "create", "Verified work", "-r", "checked", "--ready"], "json": true},
    {"cli": ["task", "create", "Manual work", "--ready"], "json": true},
    {"cli": ["task", "create", "Dependent work", "--depends-on", "WG-2"], "json": true},
    {"cli": ["task", "create", "Rejected work", "--ready"], "json": true},
    {"cli": ["task", "create", "Result work", "--ready"], "json": true},
    {"cli": ["task", "create", "Never claimed", "--ready"], "json": true},
    {"cli": ["task", "claim", "WG-1", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-1", "-m", "finished"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "accept", "WG-1"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "conflict"}}},
    {"cli": ["task", "claim", "WG-2", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-2", "--summary", "by hand"], "json": true},
    {"cli": ["task", "accept", "WG-2", "--manual", "-m", "reviewed by hand", "--promote-dependents"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "show", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"cli": ["task", "accept", "WG-6", "--manual", "--reason", "too early"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "invalid_transition"}}},
    {"cli": ["task", "claim", "WG-4", "--agent", "bob"], "json": true},
    {"cli": ["task", "complete", "WG-4", "-m", "first try"], "json": true},
    {"cli": ["task", "reject", "WG-4", "--reason", "needs rework"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "show", "WG-4"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"cli": ["task", "reject", "WG-6", "-m", "not awaiting"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "invalid_transition"}}},
    {"cli": ["task", "claim", "WG-4", "--agent", "bob"], "json": true},
    {"cli": ["attempt", "create", "WG-4", "--provider", "external"], "json": true, "save": {"attempt4": "/id"}},
    {"cli": ["task", "complete", "WG-4", "--summary", "second try", "--attempt", "{var:attempt4}"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "claim", "WG-5", "--agent", "bob"], "json": true},
    {"cli": ["attempt", "create", "WG-5", "--provider", "external"], "json": true, "save": {"attempt5": "/id"}},
    {"cli": ["task", "result", "WG-5", "succeeded", "-m", "tests green", "--attempt", "{var:attempt5}"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "result", "WG-5", "maybe"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "cli_error"}}},
    {"cli": ["task", "result", "WG-6", "failed", "-m", "never started"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"cli": ["task", "complete", "WG-6"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "invalid_transition"}}}
  ],
  "not_observable": []
}
