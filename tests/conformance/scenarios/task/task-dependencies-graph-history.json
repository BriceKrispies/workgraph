{
  "id": "task-dependencies-graph-history",
  "covers": ["C152", "C153", "C154", "C155", "C109", "C118"],
  "setup": [
    {"git": "init", "repo": "graphs"},
    {"git": "commit", "repo": "graphs", "files": {"README.md": "# graphs\n"}, "message": "graphs base"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:graphs}"], "json": true},
    {"cli": ["project", "create", "alpha", "--name", "Alpha", "--repo", "graphs"], "json": true},
    {"cli": ["task", "create", "Foundation", "-p", "alpha"], "json": true},
    {"cli": ["task", "create", "Middle", "-p", "alpha"], "json": true},
    {"cli": ["task", "create", "Top", "-r", "graphs"], "json": true},
    {"cli": ["task", "depend", "WG-2", "WG-1"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "depend", "WG-3", "WG-2"], "json": true},
    {"cli": ["task", "depend", "WG-1", "WG-3"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "dependency_cycle"}}},
    {"cli": ["task", "depend", "WG-1", "WG-1"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "dependency_cycle"}}},
    {"cli": ["task", "depend", "WG-1", "WG-404"], "json": true, "expect_exit": 4},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}},
    {"cli": ["task", "depend", "WG-3", "WG-1"], "json": true},
    {"cli": ["task", "depend", "WG-3", "WG-1", "--remove"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "depend", "WG-3", "WG-1", "--no-remove", "-w", "default"], "json": true},
    {"cli": ["task", "graph"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "graph", "--root", "WG-2"], "json": true},
    {"cli": ["task", "graph", "--project", "alpha"], "json": true},
    {"cli": ["task", "graph", "--repo", "graphs"], "json": true},
    {"cli": ["task", "graph", "--open", "-p", "alpha"], "json": true},
    {"cli": ["task", "history", "WG-2"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "history", "WG-2", "--type", "task.created", "--type", "task.updated", "-w", "default"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "history", "WG-404"], "json": true, "expect_exit": 4},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}}
  ],
  "not_observable": []
}
