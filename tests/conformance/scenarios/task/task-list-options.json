{
  "id": "task-list-options",
  "covers": ["C018", "C109", "C118", "C146", "C157"],
  "setup": [
    {"git": "init", "repo": "lister"},
    {"git": "commit", "repo": "lister", "files": {"README.md": "# lister\n"}, "message": "lister base"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:lister}"], "json": true},
    {"cli": ["project", "create", "beta", "--name", "Beta", "--repo", "lister"], "json": true},
    {"cli": ["task", "create", "Login bug", "-P", "critical", "-t", "bug,auth", "--ready", "--file", "src/login.py", "-p", "beta", "-r", "lister", "--assignee", "alice"], "json": true},
    {"cli": ["task", "create", "Docs refresh", "-P", "low", "-t", "docs"], "json": true},
    {"cli": ["task", "create", "Epic parent", "-P", "medium", "-t", "bug"], "json": true},
    {"cli": ["task", "create", "Epic child", "--parent", "WG-3", "--ready", "-P", "high", "-t", "bug"], "json": true},
    {"cli": ["task", "create", "Archive me"], "json": true},
    {"cli": ["task", "archive", "WG-5"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "list"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 4}}},
    {"cli": ["task", "list", "-s", "ready"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 2}}},
    {"cli": ["task", "list", "-s", "ready", "-s", "backlog"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 4}}},
    {"cli": ["task", "list", "-P", "critical"], "json": true},
    {"assert": {"json": {"path": "/items/0/key", "equals": "WG-1"}}},
    {"cli": ["task", "list", "-p", "beta"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"cli": ["task", "list", "-r", "lister"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"cli": ["task", "list", "-t", "bug"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 3}}},
    {"cli": ["task", "list", "--file", "src/login.py"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"cli": ["task", "list", "--category", "no-such-category"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 0}}},
    {"cli": ["task", "list", "--assignee", "alice"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"cli": ["task", "list", "--parent", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/items/0/key", "equals": "WG-4"}}},
    {"cli": ["task", "list", "--roots"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 3}}},
    {"cli": ["task", "list", "-q", "Login"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"cli": ["task", "list", "--archived"], "json": true},
    {"assert": {"json": {"path": "/items/0/key", "equals": "WG-5"}}},
    {"cli": ["task", "list", "--sort", "priority", "--asc", "--limit", "2", "--offset", "1"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 4}}},
    {"cli": ["task", "list", "--limit", "1", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/next_offset", "equals": 1}}}
  ],
  "not_observable": []
}
