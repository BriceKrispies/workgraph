{
  "id": "task-promote-ready-and-ready",
  "covers": ["C109", "C118", "C152", "C159", "C160"],
  "setup": [
    {"git": "init", "repo": "rdy"},
    {"git": "commit", "repo": "rdy", "files": {"README.md": "# rdy\n"}, "message": "rdy base"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:rdy}"], "json": true},
    {"cli": ["project", "create", "alpha", "--name", "Alpha"], "json": true},
    {"cli": ["task", "create", "Parent sprint task", "-p", "alpha", "-t", "sprint"], "json": true},
    {"cli": ["task", "create", "Waits on parent", "-t", "sprint", "--depends-on", "WG-1"], "json": true},
    {"cli": ["task", "create", "Ship it", "-p", "alpha", "-t", "ship"], "json": true},
    {"cli": ["task", "create", "Child of parent", "--parent", "WG-1"], "json": true},
    {"cli": ["task", "create", "Already ready", "-p", "alpha", "-t", "sprint", "--ready"], "json": true},
    {"cli": ["task", "create", "Repo ready", "-r", "rdy", "--ready"], "json": true},
    {"cli": ["task", "promote-ready", "--project", "alpha", "--dry-run"], "json": true},
    {"assert": {"json": {"path": "/dry_run", "equals": true}}},
    {"assert": {"json": {"path": "/promoted", "equals": ["WG-3"]}}},
    {"cli": ["task", "promote-ready"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"cli": ["task", "promote-ready", "--all", "--project", "alpha"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"cli": ["task", "promote-ready", "-t", "ship"], "json": true},
    {"assert": {"json": {"path": "/promoted", "equals": ["WG-3"]}}},
    {"assert": {"json": {"path": "/dry_run", "equals": false}}},
    {"cli": ["task", "promote-ready", "--tag", "sprint", "-p", "alpha", "--dry-run", "-w", "default"], "json": true},
    {"cli": ["task", "promote-ready", "--all", "--dry-run"], "json": true},
    {"cli": ["task", "promote-ready", "--all"], "json": true},
    {"assert": {"json": {"path": "/dry_run", "equals": false}}},
    {"cli": ["task", "ready"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "ready", "--project", "alpha", "--limit", "5"], "json": true},
    {"cli": ["task", "ready", "--repo", "rdy"], "json": true},
    {"assert": {"json": {"path": "/0/key", "equals": "WG-6"}}},
    {"cli": ["task", "ready", "--agent", "claude-code", "--limit", "1", "-w", "default"], "json": true},
    {"assert": {"exit": 0}}
  ],
  "not_observable": []
}
