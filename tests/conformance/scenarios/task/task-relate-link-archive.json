{
  "id": "task-relate-link-archive",
  "covers": ["C118", "C146", "C152", "C156", "C162"],
  "setup": [
    {"git": "init", "repo": "linked"},
    {"git": "commit", "repo": "linked", "files": {"README.md": "# linked\n"}, "message": "linked base"},
    {"git": "init", "repo": "frozen"},
    {"git": "commit", "repo": "frozen", "files": {"README.md": "# frozen\n"}, "message": "frozen base"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:linked}"], "json": true},
    {"cli": ["repo", "register", "{repo:frozen}", "--read-only"], "json": true},
    {"cli": ["task", "create", "Original"], "json": true},
    {"cli": ["task", "create", "Other"], "json": true},
    {"cli": ["task", "relate", "WG-1", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/relation_type", "equals": "relates_to"}}},
    {"cli": ["task", "relate", "WG-2", "WG-1", "--type", "duplicates"], "json": true},
    {"assert": {"json": {"path": "/relation_type", "equals": "duplicates"}}},
    {"cli": ["task", "relate", "WG-2", "WG-1", "--type", "follows_up"], "json": true},
    {"cli": ["task", "relate", "WG-2", "WG-1", "--type", "regression_of"], "json": true},
    {"cli": ["task", "relate", "WG-2", "WG-1", "--type", "similar_to", "-w", "default"], "json": true},
    {"cli": ["task", "relate", "WG-1", "WG-1"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"cli": ["task", "relate", "WG-1", "WG-404"], "json": true, "expect_exit": 4},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}},
    {"cli": ["task", "link-repo", "WG-1", "linked", "--access", "read_write"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "link-repo", "WG-1", "linked"], "json": true},
    {"cli": ["task", "link-repo", "WG-1", "linked", "--access", "sideways"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"cli": ["task", "link-repo", "WG-1", "frozen", "--access", "read_write"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"cli": ["task", "link-repo", "WG-1", "linked", "--remove"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "link-repo", "WG-1", "frozen", "--access", "read_only", "--no-remove", "-w", "default"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "archive", "WG-2"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "archive", "WG-2", "--undo"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "archive", "WG-404"], "json": true, "expect_exit": 4},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}}
  ],
  "not_observable": []
}
