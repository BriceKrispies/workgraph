{
  "id": "task-triage-apply",
  "covers": ["C152", "C166", "C165"],
  "setup": [
    {"git": "init", "repo": "triage"},
    {"git": "commit", "repo": "triage", "files": {
      "triage.json": "[\n  {\"key\": \"WG-1\", \"verdict\": \"resolved\", \"evidence\": [\"merged earlier\"]},\n  {\"key\": \"WG-2\", \"verdict\": \"obsolete\"},\n  {\"key\": \"WG-3\", \"verdict\": \"needs-decision\", \"decision\": \"Which storage engine?\"},\n  {\"key\": \"WG-4\", \"verdict\": \"open\", \"rewrites\": [{\"title\": \"Smaller slice\", \"description\": \"Do one part only\", \"files\": [\"src/a.py\"], \"acceptance_criteria\": [\"a passes\"]}]},\n  {\"key\": \"WG-5\", \"verdict\": \"needs-run\", \"command\": \"cargo test -p wg-cli\"},\n  {\"key\": \"WG-6\", \"verdict\": \"unclear\"},\n  {\"key\": \"WG-99\", \"verdict\": \"resolved\"}\n]\n",
      "notarray.json": "{\"key\": \"WG-1\"}\n",
      "broken.json": "[not json\n"
    }, "message": "triage base"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Stale one", "--ready"], "json": true},
    {"cli": ["task", "create", "Stale two", "--ready"], "json": true},
    {"cli": ["task", "create", "Needs decision"], "json": true},
    {"cli": ["task", "create", "Open for rewrite"], "json": true},
    {"cli": ["task", "create", "Needs a run"], "json": true},
    {"cli": ["task", "create", "Unclear"], "json": true},
    {"cli": ["task", "triage-apply", "{repo:triage}/triage.json", "--dry-run", "--source", "triage batch WG-1215"], "json": true, "expect_exit": 1},
    {"assert": {"json": {"path": "/errors/0/key", "equals": "WG-99"}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"cli": ["task", "triage-apply", "{repo:triage}/triage.json", "--source", "triage batch WG-1215", "-w", "default"], "json": true, "expect_exit": 1},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "cancelled"}}},
    {"cli": ["task", "show", "WG-4"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "cancelled"}}},
    {"cli": ["task", "triage-apply", "{repo:triage}/triage.json"], "json": true, "expect_exit": 1},
    {"cli": ["task", "triage-apply", "{repo:triage}/notarray.json"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"cli": ["task", "triage-apply", "{repo:triage}/broken.json"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "validation_failed"}}},
    {"cli": ["task", "triage-apply", "{repo:triage}/missing.json"], "expect_exit": 2}
  ],
  "not_observable": []
}
