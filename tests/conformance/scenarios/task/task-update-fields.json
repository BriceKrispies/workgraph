{
  "id": "task-update-fields",
  "covers": ["C152", "C167"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Updatable", "-P", "low", "-t", "one,two", "--file", "a.py"], "json": true, "save": {"v1": "/version"}},
    {"cli": ["task", "create", "Future parent"], "json": true, "save": {"parent": "/id"}},
    {"cli": ["task", "create", "Cycle child", "--parent", "WG-2"], "json": true},
    {"cli": ["task", "update", "WG-1", "--title", "Renamed", "-d", "New body", "-s", "ready", "-P", "critical", "--add-tag", "three", "--remove-tag", "one", "--file", "b.py", "--add-file", "docs/x.md:Anchor", "--parent", "WG-2", "--assignee", "bob", "--agent", "codex", "--no-auto-execute", "--metadata", "{\"source\": \"update\"}", "--expected-version", "{var:v1}", "--reason", "scoped", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/title", "equals": "Renamed"}}},
    {"assert": {"json": {"path": "/description", "equals": "New body"}}},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"assert": {"json": {"path": "/priority", "equals": "critical"}}},
    {"assert": {"json": {"path": "/tags", "equals": ["two", "three"]}}},
    {"assert": {"json": {"path": "/parent_id", "equals": "{var:parent}"}}},
    {"cli": ["task", "update", "WG-1", "--clear-parent", "--clear-files", "--auto-execute"], "json": true},
    {"assert": {"json": {"path": "/parent_id", "equals": null}}},
    {"assert": {"json": {"path": "/files", "equals": []}}},
    {"assert": {"json": {"path": "/auto_execute", "equals": true}}},
    {"cli": ["task", "update", "WG-1", "--no-clear-parent", "--no-auto-execute", "--add-file", "src/z.py"], "json": true},
    {"assert": {"json": {"path": "/auto_execute", "equals": true}}},
    {"cli": ["task", "update", "WG-1", "--file", "a.py", "--clear-files"], "json": true, "expect_exit": 1},
    {"assert": {"json": {"path": "/error/code", "equals": "cli_error"}}},
    {"cli": ["task", "update", "WG-1", "--metadata", "{not json"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "cli_error"}}},
    {"cli": ["task", "update", "WG-1", "--expected-version", "0", "--title", "Stale"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "version_conflict"}}},
    {"cli": ["task", "update", "WG-1", "-s", "accepted"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "invalid_transition"}}},
    {"cli": ["task", "update", "WG-2", "--parent", "WG-3"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "dependency_cycle"}}},
    {"cli": ["task", "update", "WG-404", "--title", "Nobody"], "json": true, "expect_exit": 4},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}}
  ],
  "not_observable": [
    {"case": "tests/integration/test_tracker_ownership.py::test_human_edits_to_tracker_owned_fields_are_rejected (and the agent variant, test_tracker_ownership.py::test_agent_edits_to_tracker_owned_fields_are_rejected): permission_denied from task update needs a tracked task, because the CLI actor is human and holds every permission, so the code is unreachable here", "covered_by": "SC-13"}
  ]
}
