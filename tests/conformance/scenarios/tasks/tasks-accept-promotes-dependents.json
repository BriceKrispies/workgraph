{
  "id": "tasks-accept-promotes-dependents",
  "covers": ["C145", "C148", "C150", "C152", "C165"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "A", "--ready"], "json": true},
    {"cli": ["task", "create", "X", "--ready"], "json": true},
    {"cli": ["task", "create", "B", "--depends-on", "WG-1"], "json": true},
    {"cli": ["task", "create", "C", "--depends-on", "WG-1", "--depends-on", "WG-2"], "json": true},
    {"cli": ["task", "create", "D", "--depends-on", "WG-1", "--tag", "parked"], "json": true},
    {"cli": ["task", "claim", "WG-1"], "json": true},
    {"cli": ["task", "complete", "WG-1", "--summary", "done"], "json": true},
    {"cli": ["task", "accept", "WG-1", "--manual", "--reason", "reviewed by hand", "--promote-dependents"], "json": true},
    {"assert": {"json": {"path": "/promoted", "equals": ["WG-3"]}}},
    {"cli": ["task", "show", "WG-3"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"cli": ["task", "show", "WG-4"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "backlog"}}},
    {"cli": ["task", "show", "WG-5"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "backlog"}}}
  ],
  "not_observable": []
}
