{
  "id": "tasks-create-and-get-by-key",
  "covers": ["C152", "C165"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "First", "-d", "Hello **world**", "-t", "a", "-t", "b"], "json": true, "save": {"t1": "/id"}},
    {"assert": {"json": {"path": "/key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/status", "equals": "backlog"}}},
    {"cli": ["task", "create", "Second"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-2"}}},
    {"cli": ["task", "show", "wg-1"], "json": true},
    {"assert": {"json": {"path": "/id", "equals": "{var:t1}"}}},
    {"assert": {"json": {"path": "/tags", "equals": ["a", "b"]}}},
    {"cli": ["task", "show", "{var:t1}"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-1"}}}
  ],
  "not_observable": []
}
