{
  "id": "tasks-cycle-detection",
  "covers": ["C152", "C153", "O05"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "A"], "json": true},
    {"cli": ["task", "create", "B", "--depends-on", "WG-1"], "json": true},
    {"cli": ["task", "create", "C", "--depends-on", "WG-2"], "json": true},
    {"cli": ["task", "depend", "WG-1", "WG-3"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "dependency_cycle"}}},
    {"cli": ["task", "depend", "WG-1", "WG-1"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "dependency_cycle"}}}
  ],
  "not_observable": []
}
