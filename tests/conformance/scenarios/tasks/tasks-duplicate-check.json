{
  "id": "tasks-duplicate-check",
  "covers": [],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "tasks.duplicate_check", "refuse"], "json": true},
    {"cli": ["project", "create", "alpha", "--name", "Alpha"], "json": true},
    {"cli": ["project", "create", "beta", "--name", "Beta"], "json": true},
    {"cli": ["task", "create", "Add a duplicate check to task create", "--description", "Look for open tasks with a similar title before a task is written", "--criterion", "done", "--project", "alpha"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-1"}}},
    {"cli": ["task", "create", "Add a duplicate check to task create", "--description", "Look for open tasks with a similar title before a task is written", "--criterion", "done", "--project", "alpha"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}},
    {"assert": {"stdout_contains": "duplicate_task"}},
    {"assert": {"stdout_contains": "WG-1"}},
    {"cli": ["task", "create", "Add a duplicate check to task create", "--description", "Look for open tasks with a similar title before a task is written", "--criterion", "done", "--project", "alpha", "--distinct-reason", "covers the HTTP route only"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-2"}}},
    {"assert": {"json": {"path": "/metadata/distinct_reason", "equals": "covers the HTTP route only"}}},
    {"cli": ["task", "show", "WG-2"]},
    {"assert": {"stdout_contains": "covers the HTTP route only"}},
    {"cli": ["task", "create", "Add a duplicate check to task create", "--description", "Look for open tasks with a similar title before a task is written", "--criterion", "done", "--project", "beta"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-3"}}},
    {"cli": ["task", "update", "WG-1", "--status", "cancelled"], "json": true},
    {"cli": ["task", "update", "WG-2", "--status", "cancelled"], "json": true},
    {"cli": ["task", "create", "Add a duplicate check to task create", "--description", "Look for open tasks with a similar title before a task is written", "--criterion", "done", "--project", "alpha"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-4"}}},
    {"cli": ["config", "set", "tasks.duplicate_check", "warn"], "json": true},
    {"cli": ["task", "create", "Add a duplicate check to task create", "--description", "Look for open tasks with a similar title before a task is written", "--criterion", "done", "--project", "alpha"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-5"}}},
    {"assert": {"stdout_contains": "WG-4"}},
    {"cli": ["config", "set", "tasks.duplicate_check", "off"], "json": true},
    {"cli": ["task", "create", "Add a duplicate check to task create", "--description", "Look for open tasks with a similar title before a task is written", "--criterion", "done", "--project", "alpha"], "json": true},
    {"assert": {"json": {"path": "/key", "equals": "WG-6"}}},
    {"assert": {"json": {"path": "/warning", "absent": true}}}
  ],
  "not_observable": []
}
