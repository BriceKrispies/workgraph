{
  "id": "tasks-failed-mutation-writes-no-event",
  "covers": ["C152", "C155", "C165", "C167", "O05"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "T"], "json": true},
    {"cli": ["task", "update", "WG-1", "--title", "changed", "--parent", "WG-999"], "json": true, "expect_exit": 4},
    {"assert": {"json": {"path": "/error/code", "equals": "not_found"}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/title", "equals": "T"}}},
    {"cli": ["task", "history", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/0/event_type", "equals": "task.created"}}}
  ],
  "not_observable": [
    {
      "case": "tests/unit/test_tasks_core.py::test_failed_mutation_writes_no_event: the event count before and after the refused update is not expressible with json equality; the recorded history after the refusal is compared in full by the differential run",
      "covered_by": "CORE-03"
    }
  ]
}
