{
  "id": "tasks-filters-pagination-search-bulk",
  "covers": ["C146", "C147", "C152", "C157"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Task 0 database", "--priority", "high"], "json": true},
    {"cli": ["task", "create", "Task 1 ui", "--priority", "high"], "json": true},
    {"cli": ["task", "create", "Task 2 ui", "--priority", "high"], "json": true},
    {"cli": ["task", "create", "Task 3 database", "--priority", "high"], "json": true},
    {"cli": ["task", "create", "Task 4 ui", "--priority", "low"], "json": true},
    {"cli": ["task", "create", "Task 5 ui", "--priority", "low"], "json": true},
    {"cli": ["task", "create", "Task 6 database", "--priority", "low"], "json": true},
    {"cli": ["task", "create", "Task 7 ui", "--priority", "low"], "json": true},
    {"cli": ["task", "create", "Task 8 ui", "--priority", "low"], "json": true},
    {"cli": ["task", "create", "Task 9 database", "--priority", "low"], "json": true},
    {"cli": ["task", "create", "Task 10 ui", "--priority", "low"], "json": true},
    {"cli": ["task", "create", "Task 11 ui", "--priority", "low"], "json": true},
    {"cli": ["task", "list", "--limit", "5"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 12}}},
    {"assert": {"json": {"path": "/next_offset", "equals": 5}}},
    {"cli": ["task", "list", "--priority", "high", "--limit", "100"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 4}}},
    {"cli": ["task", "list", "--search", "datab", "--limit", "100"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 4}}},
    {"cli": ["task", "bulk-update", "WG-1", "WG-2", "WG-404", "--add-tag", "bulk"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/updated/0", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/updated/1", "equals": "WG-2"}}},
    {"cli": ["task", "list", "--tag", "bulk", "--limit", "100"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 2}}},
    {"cli": ["task", "archive", "WG-1"], "json": true},
    {"cli": ["task", "list", "--limit", "100"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 11}}},
    {"cli": ["task", "list", "--archived", "--limit", "100"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}}
  ],
  "not_observable": []
}
