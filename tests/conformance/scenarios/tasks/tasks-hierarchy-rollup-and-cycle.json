{
  "id": "tasks-hierarchy-rollup-and-cycle",
  "covers": ["B05", "C145", "C148", "C150", "C152", "C165", "C167", "O05"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Parent"], "json": true},
    {"cli": ["task", "create", "C1", "--parent", "WG-1", "--ready"], "json": true, "save": {"c1": "/id"}},
    {"cli": ["task", "create", "C2", "--parent", "WG-1"], "json": true, "save": {"c2": "/id"}},
    {"cli": ["task", "create", "GC", "--parent", "WG-3"], "json": true},
    {"cli": ["task", "claim", "WG-2"], "json": true},
    {"cli": ["task", "complete", "WG-2"], "json": true},
    {"cli": ["task", "accept", "WG-2", "--manual", "--reason", "ok"], "json": true},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/rollup/total_descendants", "equals": 3}}},
    {"assert": {"json": {"path": "/rollup/accepted", "equals": 1}}},
    {"assert": {"json": {"path": "/rollup/progress", "equals": 0.3333}}},
    {"cli": ["task", "update", "WG-1", "--parent", "WG-4"], "json": true, "expect_exit": 2},
    {"assert": {"json": {"path": "/error/code", "equals": "dependency_cycle"}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/child_ids/0", "equals": "{var:c1}"}}},
    {"assert": {"json": {"path": "/child_ids/1", "equals": "{var:c2}"}}}
  ],
  "not_observable": []
}
