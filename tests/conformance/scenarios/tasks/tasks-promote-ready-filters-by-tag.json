{
  "id": "tasks-promote-ready-filters-by-tag",
  "covers": ["C152", "C159", "C165"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "Sprint", "--tag", "sprint-42"], "json": true},
    {"cli": ["task", "create", "Other"], "json": true},
    {"cli": ["task", "promote-ready", "--tag", "sprint-42"], "json": true},
    {"assert": {"json": {"path": "/promoted", "equals": ["WG-1"]}}},
    {"cli": ["task", "show", "WG-2"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "backlog"}}}
  ],
  "not_observable": []
}
