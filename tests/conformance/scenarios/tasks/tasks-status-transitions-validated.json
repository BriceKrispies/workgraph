{
  "id": "tasks-status-transitions-validated",
  "covers": ["C152", "C167", "O05"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["task", "create", "T", "--ready"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"cli": ["task", "update", "WG-1", "--status", "accepted"], "json": true, "expect_exit": 3},
    {"cli": ["task", "update", "WG-1", "--status", "awaiting_review"], "json": true, "expect_exit": 3},
    {"cli": ["task", "update", "WG-1", "--status", "cancelled"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "cancelled"}}}
  ],
  "not_observable": []
}
