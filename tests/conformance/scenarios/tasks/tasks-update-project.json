{
  "id": "tasks-update-project",
  "covers": [],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["project", "create", "exegra", "--name", "Exegra"], "json": true},
    {"cli": ["task", "create", "A", "--criterion", "done", "--tag", "exegra"], "json": true},
    {"cli": ["task", "create", "B", "--criterion", "done", "--tag", "exegra"], "json": true},
    {"cli": ["task", "create", "C", "--criterion", "done"], "json": true},
    {"cli": ["task", "update", "WG-1", "--project", "exegra"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "list", "--project", "exegra"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 1}}},
    {"cli": ["task", "update", "WG-1", "--project", "none"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["task", "list", "--project", "exegra"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 0}}},
    {"cli": ["task", "update", "WG-1", "--project", "nothing"], "json": true, "expect_exit": 4},
    {"assert": {"exit": 4}},
    {"cli": ["task", "update", "--tag", "exegra", "--project", "nothing", "--dry-run"], "json": true, "expect_exit": 4},
    {"assert": {"exit": 4}},
    {"cli": ["task", "update", "--tag", "exegra", "--project", "exegra", "--dry-run"], "json": true},
    {"assert": {"json": {"path": "/dry_run", "equals": true}}},
    {"assert": {"json": {"path": "/would_change", "equals": ["WG-1", "WG-2"]}}},
    {"assert": {"json": {"path": "/unchanged", "equals": []}}},
    {"cli": ["task", "list", "--project", "exegra"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 0}}},
    {"cli": ["task", "update", "--tag", "exegra", "--project", "exegra"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/updated", "equals": ["WG-1", "WG-2"]}}},
    {"cli": ["task", "list", "--project", "exegra"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 2}}},
    {"cli": ["task", "update", "--tag", "exegra", "--project", "exegra", "--dry-run"], "json": true},
    {"assert": {"json": {"path": "/would_change", "equals": []}}},
    {"cli": ["task", "update", "WG-3", "--tag", "exegra", "--project", "exegra"], "json": true, "expect_exit": 1},
    {"assert": {"exit": 1}},
    {"cli": ["task", "update", "--tag", "exegra", "--title", "renamed"], "json": true, "expect_exit": 2},
    {"assert": {"exit": 2}}
  ],
  "not_observable": []
}
