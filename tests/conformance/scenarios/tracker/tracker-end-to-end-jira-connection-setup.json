{
  "id": "tracker-end-to-end-jira-connection-setup",
  "covers": ["C118", "C168", "C169"],
  "setup": [
    {"git": "init", "repo": "svc-billing"},
    {"git": "commit", "repo": "svc-billing", "files": {"README.md": "# svc-billing\n"}, "message": "initial commit"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "trackers.work-jira", "{\"type\": \"jira\", \"flavour\": \"cloud\", \"base_url\": \"https://acme.atlassian.net\", \"workspace\": \"default\", \"projects\": [\"ABC\"], \"email_env\": \"JIRA_EMAIL\", \"token_env\": \"JIRA_TOKEN\", \"pr_fields\": [\"customfield_10042\"]}"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["tracker", "list"], "json": true},
    {"assert": {"json": {"path": "/0/name", "equals": "work-jira"}}},
    {"cli": ["repo", "register", "{repo:svc-billing}", "--name", "svc-billing"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/name", "equals": "svc-billing"}}},
    {"cli": ["tracker", "status", "work-jira"], "json": true},
    {"assert": {"json": {"path": "/connection", "equals": "work-jira"}}},
    {"assert": {"json": {"path": "/tracked_tasks", "equals": 0}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_tracker_end_to_end.py::test_cloud_issues_become_tasks_with_pull_requests_and_status: the real Jira client, mapper and sync run against a mocked Jira Cloud HTTP transport built from tests/fixtures/jira, and the runner cannot inject a transport or start a fake Jira, so the synced tasks, their status, pull request links, repository resolution, the GET-only request check and the unresolved pull request report are not observable",
      "covered_by": "SC-14"
    }
  ]
}
