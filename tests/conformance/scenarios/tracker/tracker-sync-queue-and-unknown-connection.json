{
  "id": "tracker-sync-queue-and-unknown-connection",
  "covers": ["C170"],
  "setup": [],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["config", "set", "trackers.work-jira", "{\"type\": \"jira\", \"flavour\": \"cloud\", \"base_url\": \"https://acme.atlassian.net\", \"workspace\": \"work\", \"projects\": [\"ABC\"], \"email_env\": \"WG_TEST_JIRA_EMAIL\", \"token_env\": \"WG_TEST_JIRA_TOKEN\"}"], "json": true},
    {"cli": ["tracker", "sync", "work-jira", "--queue", "--full"], "json": true, "save": {"job": "/job_id"}},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/connection", "equals": "work-jira"}}},
    {"assert": {"json": {"path": "/full", "equals": true}}},
    {"cli": ["tracker", "sync", "work-jira", "--queue", "--full"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/job_id", "equals": "{var:job}"}}},
    {"cli": ["tracker", "sync", "work-jira", "--queue"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"json": {"path": "/full", "equals": false}}},
    {"cli": ["tracker", "sync", "nope"], "json": true, "expect_exit": 4},
    {"assert": {"exit": 4}},
    {"cli": ["tracker", "sync", "nope", "--queue", "--full"], "json": true, "expect_exit": 4},
    {"assert": {"exit": 4}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_tracker_cli.py::test_tracker_sync_runs_now and test_tracker_sync_queue_returns_job_id: running a sync now (with or without --full) reads issues from Jira and reports fetched, created and updated counts, which needs a fake Jira the runner cannot reach",
      "covered_by": "SC-14"
    }
  ]
}
