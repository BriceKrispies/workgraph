{
  "id": "verify-tier-failing-run-does-not-accept",
  "covers": ["C099", "C118", "C148", "C150", "C152", "C165", "C172", "C175"],
  "setup": [
    {"git": "init", "repo": "broken"},
    {"git": "commit", "repo": "broken", "files": {"README.md": "# broken\n"}, "message": "initial commit"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:broken}"], "json": true},
    {"cli": ["verify", "config", "ci", "--scope-type", "repository", "--scope", "broken", "--check", "{\"name\": \"unit tests\", \"command\": [\"python\", \"-c\", \"raise SystemExit(1)\"]}"], "json": true},
    {"cli": ["task", "create", "Broken", "--repo", "broken", "--ready"], "json": true},
    {"cli": ["task", "claim", "WG-1", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-1", "-m", "finished"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "awaiting_verification"}}},
    {"cli": ["verify", "run", "WG-1"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/required_passed", "equals": false}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "failed"}}},
    {"assert": {"db": "task_acceptances", "where": {}, "count": 0}}
  ],
  "not_observable": []
}
