{
  "id": "verify-tier-full-pass-accepts-task",
  "covers": ["C099", "C118", "C148", "C150", "C152", "C165", "C172", "C175"],
  "setup": [
    {"git": "init", "repo": "svc"},
    {"git": "commit", "repo": "svc", "files": {"README.md": "# svc\n"}, "message": "initial commit"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:svc}"], "json": true},
    {"cli": ["verify", "config", "ci", "--scope-type", "repository", "--scope", "svc", "--check", "{\"name\": \"lint\", \"kind\": \"lint\", \"tier\": \"fast\", \"command\": [\"python\", \"-c\", \"print('lint ok')\"]}", "--check", "{\"name\": \"unit tests\", \"command\": [\"python\", \"-c\", \"print('1 passed')\"]}"], "json": true},
    {"cli": ["task", "create", "Tiered checks", "--repo", "svc", "--ready"], "json": true},
    {"cli": ["task", "claim", "WG-1", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-1", "-m", "finished"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "awaiting_verification"}}},
    {"cli": ["verify", "run", "WG-1"], "json": true, "save": {"run": "/id"}},
    {"assert": {"json": {"path": "/required_passed", "equals": true}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "accepted"}}},
    {"assert": {"db": "task_acceptances", "where": {"mode": "automated", "reason": "verification.auto_accept", "verification_run_id": "{var:run}"}, "count": 1}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_verification_tiers.py::test_unstacked_task_in_a_stack_landing_repository_stays_awaiting_review: the repository is marked as landing through a landed stack by inserting a stack row and a stack repository row directly, which no CLI step can produce, so the task stays awaiting_review instead of being auto-accepted",
      "covered_by": "CORE-16"
    }
  ]
}
