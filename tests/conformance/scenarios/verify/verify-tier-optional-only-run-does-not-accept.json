{
  "id": "verify-tier-optional-only-run-does-not-accept",
  "covers": ["C099", "C118", "C148", "C150", "C152", "C165", "C172", "C175"],
  "setup": [
    {"git": "init", "repo": "optional"},
    {"git": "commit", "repo": "optional", "files": {"README.md": "# optional\n"}, "message": "initial commit"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:optional}"], "json": true},
    {"cli": ["verify", "config", "ci", "--scope-type", "repository", "--scope", "optional", "--check", "{\"name\": \"unit tests\", \"required\": false, \"command\": [\"python\", \"-c\", \"print('ok')\"]}"], "json": true},
    {"cli": ["task", "create", "Optional only", "--repo", "optional", "--ready"], "json": true},
    {"cli": ["task", "claim", "WG-1", "--agent", "alice"], "json": true},
    {"cli": ["task", "complete", "WG-1", "-m", "finished"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "awaiting_verification"}}},
    {"cli": ["verify", "run", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/required_passed", "equals": true}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "awaiting_review"}}},
    {"assert": {"db": "task_acceptances", "where": {}, "count": 0}}
  ],
  "not_observable": []
}
