{
  "id": "worker-run-list-recover",
  "covers": ["C177", "C178", "C179", "C118"],
  "setup": [
    {"git": "init", "repo": "idle"},
    {"git": "commit", "repo": "idle", "files": {"README.md": "idle\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["worker", "list"], "json": true},
    {"assert": {"json": {"path": "", "equals": []}}},
    {"cli": ["worker", "run", "--once"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "\"completed\": 0"}},
    {"cli": ["worker", "run", "--once", "--concurrency", "2", "--kind", "noop", "--kind", "git_sync"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "\"failed\": 0"}},
    {"cli": ["worker", "run", "--no-once", "--max-idle", "0.5"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "\"completed\": 0"}},
    {"cli": ["worker", "list"], "json": true},
    {"assert": {"exit": 0}},
    {"cli": ["worker", "recover"], "json": true},
    {"assert": {"json": {"path": "/recovered_jobs", "equals": []}}},
    {"assert": {"json": {"path": "/lost_workers", "equals": []}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_jobs.py: a worker that runs until interrupted (Ctrl+C stops gracefully), and recovery of expired leases and lost workers that a killed process left behind. The runner cannot send an interrupt or kill a process mid-run",
      "covered_by": "SC-22"
    }
  ]
}
