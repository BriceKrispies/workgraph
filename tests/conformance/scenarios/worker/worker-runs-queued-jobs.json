{
  "id": "worker-runs-queued-jobs",
  "covers": ["C102", "C103", "C105", "C106", "C179"],
  "setup": [
    {"git": "init", "repo": "queued"},
    {"git": "commit", "repo": "queued", "files": {"README.md": "queued\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["job", "enqueue", "noop", "--payload", "{\"n\": 1}"], "json": true, "save": {"first": "/job_id"}},
    {"cli": ["job", "enqueue", "noop", "--payload", "{\"n\": 2}"], "json": true, "save": {"second": "/job_id"}},
    {"cli": ["worker", "run", "--once", "--concurrency", "1", "--kind", "noop"], "json": true},
    {"assert": {"stdout_contains": "\"completed\": 2"}},
    {"cli": ["job", "show", "{var:first}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "succeeded"}}},
    {"assert": {"json": {"path": "/payload/n", "equals": 1}}},
    {"assert": {"json": {"path": "/runs/0/status", "equals": "succeeded"}}},
    {"cli": ["job", "list", "--status", "succeeded", "--kind", "noop"], "json": true},
    {"assert": {"json": {"path": "/total", "equals": 2}}},
    {"cli": ["job", "stats"], "json": true},
    {"assert": {"json": {"path": "/succeeded", "equals": 2}}}
  ],
  "not_observable": []
}
