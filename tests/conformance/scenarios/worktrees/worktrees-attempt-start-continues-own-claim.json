{
  "id": "worktrees-attempt-start-continues-own-claim",
  "covers": ["C023", "C118", "C148", "C152", "C165"],
  "setup": [
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "api\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true},
    {"cli": ["task", "create", "Claimed first", "--repo", "api", "--ready"], "json": true},
    {"cli": ["task", "claim", "WG-1"], "json": true},
    {"cli": ["attempt", "start", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/attempt_number", "equals": 1}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "running"}}}
  ],
  "not_observable": []
}
