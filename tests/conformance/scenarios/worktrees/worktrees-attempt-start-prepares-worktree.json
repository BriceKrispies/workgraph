{
  "id": "worktrees-attempt-start-prepares-worktree",
  "covers": ["C022", "C023", "C097", "C118", "C152", "C165"],
  "setup": [
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "api\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true},
    {"cli": ["task", "create", "External work", "-r", "api", "--ready"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "ready"}}},
    {"cli": ["attempt", "start", "WG-1", "--agent-name", "tester", "--model", "test-model"], "json": true, "save": {"attempt": "/attempt_id", "checkout": "/repositories/0/checkout_path"}},
    {"assert": {"json": {"path": "/task_key", "equals": "WG-1"}}},
    {"assert": {"json": {"path": "/attempt_number", "equals": 1}}},
    {"assert": {"json": {"path": "/repositories/0/repository", "equals": "api"}}},
    {"assert": {"json": {"path": "/repositories/0/base", "equals": null}}},
    {"assert": {"file": "{var:checkout}/README.md", "exists": true}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "running"}}},
    {"cli": ["attempt", "show", "{var:attempt}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "running"}}},
    {"assert": {"json": {"path": "/provider", "equals": "tester"}}},
    {"assert": {"json": {"path": "/adapter", "equals": "claude_code_subagent"}}},
    {"assert": {"json": {"path": "/model", "equals": "test-model"}}},
    {"cli": ["git", "worktrees", "--status", "active", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "active"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_worktrees.py::test_attempt_start_claims_ready_task_and_prepares_worktree: the checkout's current branch equals the reported branch and its HEAD equals the base sha, and the attempt's baseline manifest id is set. The runner asserts file existence and JSON values only, with no assertion for a git HEAD or for a non-null field",
      "covered_by": "CORE-13"
    }
  ]
}
