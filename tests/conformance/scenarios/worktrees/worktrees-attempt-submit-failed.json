{
  "id": "worktrees-attempt-submit-failed",
  "covers": ["C022", "C023", "C024", "C097", "C118", "C152", "C165"],
  "setup": [
    {"git": "init", "repo": "api"},
    {"git": "commit", "repo": "api", "files": {"README.md": "api\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:api}"], "json": true},
    {"cli": ["task", "create", "External work", "--repo", "api", "--ready"], "json": true},
    {"cli": ["attempt", "start", "WG-1", "--agent-name", "tester"], "json": true, "save": {"attempt": "/attempt_id"}},
    {"cli": ["attempt", "submit", "{var:attempt}", "--failed", "--error", "tests are red"], "json": true},
    {"assert": {"json": {"path": "", "equals": {"status": "failed", "error": "tests are red", "task_status": "failed", "attempt_status": "failed"}}}},
    {"cli": ["attempt", "show", "{var:attempt}"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "failed"}}},
    {"assert": {"json": {"path": "/exit_reason", "equals": "failed"}}},
    {"assert": {"json": {"path": "/error", "equals": "tests are red"}}},
    {"cli": ["task", "show", "WG-1"], "json": true},
    {"assert": {"json": {"path": "/status", "equals": "failed"}}},
    {"cli": ["git", "worktrees"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "released"}}}
  ],
  "not_observable": []
}
