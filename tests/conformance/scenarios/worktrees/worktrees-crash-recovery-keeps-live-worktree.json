{
  "id": "worktrees-crash-recovery-keeps-live-worktree",
  "covers": ["C023", "C097", "C178"],
  "setup": [
    {"git": "init", "repo": "crashy"},
    {"git": "commit", "repo": "crashy", "files": {"README.md": "crashy\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:crashy}"], "json": true},
    {"cli": ["task", "create", "Crashy", "-r", "crashy", "--ready"], "json": true},
    {"cli": ["attempt", "start", "WG-1", "--agent-name", "tester"], "json": true, "save": {"checkout": "/repositories/0/checkout_path"}},
    {"cli": ["worker", "recover"], "json": true},
    {"assert": {"json": {"path": "/worktrees/orphaned", "equals": []}}},
    {"assert": {"json": {"path": "/worktrees/released", "equals": []}}},
    {"assert": {"file": "{var:checkout}/README.md", "exists": true}},
    {"cli": ["git", "worktrees", "-w", "default"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "active"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_worktrees.py::test_crash_recovery_of_worktrees: the managed checkout directory vanishes while the attempt is running, and recovery reports the path as orphaned and lists the row as orphaned. The checkout path is only known after attempt start and setup runs before every step, so no step can delete it; only the live case is asserted here",
      "covered_by": "CORE-13"
    }
  ]
}
