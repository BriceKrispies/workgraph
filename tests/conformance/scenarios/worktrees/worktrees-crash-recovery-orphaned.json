{
  "id": "worktrees-crash-recovery-orphaned",
  "covers": ["C023", "C097", "C118", "C152", "C178"],
  "setup": [
    {"git": "init", "repo": "crashy"},
    {"git": "commit", "repo": "crashy", "files": {"README.md": "crashy\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:crashy}"], "json": true},
    {"cli": ["task", "create", "External work", "--repo", "crashy", "--ready"], "json": true},
    {"cli": ["attempt", "start", "WG-1", "--agent-name", "tester"], "json": true},
    {"cli": ["git", "worktrees"], "json": true, "save": {"checkout": "/0/path"}},
    {"assert": {"json": {"path": "/0/status", "equals": "active"}}},
    {"rmtree": "{var:checkout}"},
    {"cli": ["worker", "recover"], "json": true},
    {"assert": {"json": {"path": "/worktrees/orphaned/0", "equals": "{var:checkout}"}}},
    {"cli": ["git", "worktrees"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "orphaned"}}}
  ],
  "not_observable": []
}
