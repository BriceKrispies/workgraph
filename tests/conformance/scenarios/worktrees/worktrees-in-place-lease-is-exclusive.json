{
  "id": "worktrees-in-place-lease-is-exclusive",
  "covers": ["C016", "C023", "C118", "C152"],
  "setup": [
    {"git": "init", "repo": "solo"},
    {"git": "commit", "repo": "solo", "files": {"README.md": "solo\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:solo}"], "json": true},
    {"cli": ["task", "create", "First", "--repo", "solo", "--ready"], "json": true},
    {"cli": ["task", "create", "Second", "--repo", "solo", "--ready"], "json": true},
    {"cli": ["attempt", "start", "WG-1", "--isolation", "in_place", "--agent-name", "tester"], "json": true,
     "save": {"attempt": "/attempt_id"}},
    {"assert": {"json": {"path": "/repositories/0/checkout_path", "equals": "{repo:solo}"}}},
    {"cli": ["attempt", "manifests", "{var:attempt}"], "json": true},
    {"assert": {"json": {"path": "/0/entries/0/isolation", "equals": "in_place"}}},
    {"cli": ["attempt", "start", "WG-2", "--isolation", "in_place", "--agent-name", "tester"], "json": true},
    {"assert": {"exit": 3}},
    {"assert": {"stdout_contains": "leased"}},
    {"cli": ["attempt", "abandon", "{var:attempt}", "--reason", "done"], "json": true},
    {"assert": {"json": {"path": "/attempt_status", "equals": "abandoned"}}},
    {"assert": {"json": {"path": "/task_status", "equals": "ready"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_worktrees.py::test_in_place_isolation_uses_exclusive_lease: after the first attempt is released, the second in-place start is expected to succeed with isolation in_place; the CLI start claims the task and the refused start leaves WG-2 failed, and a failed task cannot be started again, so the retry is not reachable through attempt start.",
      "covered_by": "CORE-13"
    }
  ]
}
