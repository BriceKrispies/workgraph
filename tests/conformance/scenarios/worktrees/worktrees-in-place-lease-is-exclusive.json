{
  "id": "worktrees-in-place-lease-is-exclusive",
  "covers": ["C016", "C023", "C097", "C152", "C165"],
  "setup": [
    {"git": "init", "repo": "solo"},
    {"git": "commit", "repo": "solo", "files": {"README.md": "solo\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:solo}"], "json": true},
    {"cli": ["task", "create", "First", "-r", "solo", "--ready"], "json": true},
    {"cli": ["task", "create", "Second", "-r", "solo", "--ready"], "json": true},
    {"cli": ["task", "create", "Third", "-r", "solo", "--ready"], "json": true},
    {"cli": ["attempt", "start", "WG-1", "--agent-name", "tester", "--isolation", "in_place"], "json": true, "save": {"attempt_a": "/attempt_id", "checkout_a": "/repositories/0/checkout_path"}},
    {"assert": {"json": {"path": "/task_key", "equals": "WG-1"}}},
    {"assert": {"file": "{var:checkout_a}/README.md", "exists": true}},
    {"cli": ["attempt", "start", "WG-2", "--agent-name", "tester", "--isolation", "in_place"], "json": true, "expect_exit": 3},
    {"assert": {"json": {"path": "/error/code", "equals": "resource_busy"}}},
    {"cli": ["attempt", "abandon", "{var:attempt_a}"], "json": true},
    {"assert": {"json": {"path": "/attempt_status", "equals": "abandoned"}}},
    {"assert": {"file": "{var:checkout_a}/README.md", "exists": true}},
    {"cli": ["attempt", "start", "WG-3", "--agent-name", "tester", "--isolation", "in_place"], "json": true},
    {"assert": {"json": {"path": "/task_key", "equals": "WG-3"}}},
    {"assert": {"json": {"path": "/attempt_number", "equals": 1}}}
  ],
  "not_observable": []
}
