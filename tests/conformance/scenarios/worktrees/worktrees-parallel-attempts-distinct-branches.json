{
  "id": "worktrees-parallel-attempts-distinct-branches",
  "covers": ["C023", "C118", "C152"],
  "setup": [
    {"git": "init", "repo": "shared"},
    {"git": "commit", "repo": "shared", "files": {"README.md": "shared\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:shared}"], "json": true},
    {"cli": ["task", "create", "First", "--repo", "shared", "--ready"], "json": true},
    {"cli": ["task", "create", "Second", "--repo", "shared", "--ready"], "json": true},
    {"cli": ["attempt", "start", "WG-1"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "wg/wg-1/attempt-1-"}},
    {"cli": ["attempt", "start", "WG-2"], "json": true},
    {"assert": {"exit": 0}},
    {"assert": {"stdout_contains": "wg/wg-2/attempt-1-"}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_worktrees.py::test_parallel_worktree_attempts_do_not_conflict: the two managed checkout paths are asserted to differ; the assertion language has equality only, so the inequality is not checked, and the scenario relies on both starts succeeding on distinct attempt branches.",
      "covered_by": "CORE-13"
    }
  ]
}
