{
  "id": "worktrees-recovery-releases-archived-task",
  "covers": ["C023", "C088", "C097", "C118", "C146", "C152", "C178"],
  "setup": [
    {"git": "init", "repo": "stale"},
    {"git": "commit", "repo": "stale", "files": {"README.md": "stale\n"}, "message": "initial"}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:stale}"], "json": true},
    {"cli": ["task", "create", "Stale work", "--repo", "stale", "--ready"], "json": true},
    {"cli": ["attempt", "start", "WG-1", "--agent-name", "tester"], "json": true},
    {"cli": ["worker", "recover"], "json": true},
    {"assert": {"json": {"path": "/worktrees/released", "equals": []}}},
    {"cli": ["git", "worktrees"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "active"}}},
    {"cli": ["task", "archive", "WG-1"], "json": true},
    {"cli": ["worker", "recover"], "json": true},
    {"assert": {"json": {"path": "/worktrees/orphaned", "equals": []}}},
    {"cli": ["git", "worktrees"], "json": true},
    {"assert": {"json": {"path": "/0/status", "equals": "released"}}},
    {"cli": ["git", "cleanup-worktrees"], "json": true},
    {"assert": {"json": {"path": "/0/action", "equals": "would remove (if clean)"}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_worktrees.py::test_recovery_releases_the_worktree_of_an_archived_task: the report released list is asserted to equal the one checkout path, and the cleanup dry run to list the same path; the path is per attempt and absolute, which equality cannot express, so the scenario checks the released row status and the dry-run action instead.",
      "covered_by": "CORE-13"
    }
  ]
}
