{
  "id": "worktrees-register-discovers-linked-checkouts",
  "covers": ["C117", "C118"],
  "setup": [
    {"git": "init", "repo": "discover"},
    {"git": "commit", "repo": "discover", "files": {"README.md": "discover\n"}, "message": "initial"},
    {"git": "branch", "repo": "discover", "args": ["feature-a"]},
    {"git": "worktree", "repo": "discover", "args": ["../wt/feature-a", "feature-a"]},
    {"git": "branch", "repo": "discover", "args": ["detached-b"]},
    {"git": "worktree", "repo": "discover", "args": ["../wt/detached-b", "detached-b"]}
  ],
  "steps": [
    {"cli": ["init"], "json": true},
    {"cli": ["repo", "register", "{repo:discover}"], "json": true},
    {"assert": {"json": {"path": "/checkouts/0/kind", "equals": "clone"}}},
    {"assert": {"json": {"path": "/checkouts/0/is_primary", "equals": true}}},
    {"assert": {"json": {"path": "/checkouts/1/kind", "equals": "worktree"}}},
    {"assert": {"json": {"path": "/checkouts/2/kind", "equals": "worktree"}}},
    {"assert": {"stdout_contains": "feature-a"}},
    {"assert": {"json": {"path": "/health_detail/skipped_worktrees", "equals": []}}},
    {"cli": ["repo", "refresh", "discover"], "json": true},
    {"assert": {"json": {"path": "/health_status", "equals": "ok"}}},
    {"assert": {"json": {"path": "/checkouts/1/available", "equals": true}}},
    {"assert": {"json": {"path": "/checkouts/2/available", "equals": true}}},
    {"git": "branch", "cwd": "{repo:discover}", "args": ["feature-c"]},
    {"git": "worktree", "cwd": "{repo:discover}", "args": ["../wt/feature-c", "feature-c"]},
    {"cli": ["repo", "refresh", "discover"], "json": true},
    {"assert": {"json": {"path": "/checkouts/3/kind", "equals": "worktree"}}},
    {"assert": {"json": {"path": "/checkouts/3/available", "equals": true}}},
    {"assert": {"json": {"path": "/checkouts/4", "absent": true}}}
  ],
  "not_observable": [
    {
      "case": "tests/integration/test_worktree_discovery.py::test_register_and_refresh_discover_worktrees: the detached worktree is locked with git worktree lock, which no setup operation offers and which does not change the discovered kind, so the locked state is not reproduced.",
      "covered_by": "CORE-08"
    },
    {
      "case": "tests/integration/test_worktree_discovery.py::test_register_and_refresh_discover_worktrees: the removal of feature-a (git worktree remove, so checkout_lost, available false and degraded health) and the repository.checkout_discovered and checkout_lost event counts are not reached: no step removes a linked worktree through git, the rmtree step is confined to the sandbox home while this worktree lives beside it, and no assertion counts event lists. The addition of feature-c is asserted.",
      "covered_by": "CORE-08"
    }
  ]
}
